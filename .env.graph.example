################################################################################
#  Lucent — 图库机(腾讯云, amd64)
################################################################################
#  用法：cp .env.graph.example .env && vim .env
#  本文件入库；.env 不入库。
#
#  **本文件只服务图库机**（compose.graph.yaml：neo4j + semantica）。
#  另外两台机器各有自己的模板，不要混用：
#    · 主站(华为云鲲鹏)  → .env.production.example  （compose.yaml）
#    · 监控机(阿里云)    → .env.monitoring.example  （compose.monitoring.yaml）
#
#  ⚠️ 本机**不需要**也不应该填主站的 LUCENT_IMAGE / LUCENT_DB_IMAGE /
#     POSTGRES_PASSWORD / REDIS_PASSWORD —— 那是主站的口令。拆分前共用一份
#     compose.yaml 时本机被迫凑齐它们才能启动（ADR-0023 修订记录的理由），
#     现在分文件后只需下面这几项。
#
#  app **不在**本机：Lucent 从不直连 Neo4j，图查询全部经 semantica 的 HTTP
#  端点由主站跨公网调用（见 docs/reference/deployment.md）。
################################################################################


################################################################################
#  01 · 编排插值（compose.graph.yaml 的 ${VAR}）
################################################################################
#  这些键由 compose 读取做插值，sidecar 进程本身不消费它们。
#  ⚠️ 标了「必填」的没有默认值，缺失会让 compose 直接拒绝启动。

# [必填] Neo4j 初始口令。同时用于容器初始化与 sidecar 登录。
# ⚠️ 必须与 deploy/semantica/.env 的 NEO4J_PASSWORD 一致，否则 sidecar 连不上图。
NEO4J_PASSWORD=replace_with_strong_neo4j_password

# 可选。钉补丁号，勿用浮动 tag。
NEO4J_IMAGE=neo4j:5.26.31-community

# 可选。semantica 镜像；离线部署时改成 load 进来的 tag。
SEMANTICA_IMAGE=lucent-semantica:latest
