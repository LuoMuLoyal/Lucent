# compiled output
#
# Unanchored on purpose: these are build outputs and dependencies, and in a
# workspace they appear under every app (`apps/<svc>/dist`, `apps/<svc>/node_modules`).
# The leading `/` that used to be here only matched the repo root, so after the
# monolith moved to `apps/monolith/` nothing was ignored and a bulk `git add -A`
# swept ~2.3k build files into a commit.
dist/
node_modules/
build/

# TypeScript incremental build cache
*.tsbuildinfo

# Windows null-device artifact (Bash writes to "nul" as a file)
nul

# Python
__pycache__/
*.py[cod]
*$py.class

# Logs
/logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
coverage/
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development
.env.test
.env.production
.env.graph
.env.monitoring
.env.development.local
.env.test.local
.env.production.local
.env.local
.deploy-image.env

# YAML local overrides (machine-specific, never committed)
**/config/*.local.yaml

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Prisma client output is local-only. Regenerate from schema with prisma/client
# install hooks or `pnpm prisma:generate`; do not commit this directory.
**/generated/prisma/
**/scripts/deploy/dist/
.codebase-memory/

# Traefik 运行配置:服务器上由 infra/traefik/*.yml.example 复制而来(含域名、
# 邮箱、面板密码哈希),不入库——否则发布时的 `git reset --hard origin/main` 会覆盖它
/infra/traefik/*.yml

# LightRAG sidecar 运行配置:由 infra/lightrag/.env.example 复制而来(含模型 key、
# 嵌入凭据、Postgres 口令),不入库;生产由部署平台按同一份清单注入
/infra/lightrag/.env

# mem0 sidecar 运行配置:由 infra/mem0/.env.example 复制而来(含模型 key、JWT_SECRET、
# ADMIN_API_KEY),不入库
/infra/mem0/.env

# LightRAG 灌入的断点续传账本:运行时状态,记录"哪份说明书已灌完"。
# 服务端 doc_status 才是事实源(见 docs/howto/run-medicine-import.md),
# 这份文件只是本机缓存,换机器就应重新拉取,入库会带来无意义的冲突。
/scripts/import/medicine/.lightrag-leaflet-ledger.jsonl

# Generated docs
/docs/reference/generated/compodoc

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# graphify 代码结构图谱（本机生成，不入库）
graphify-out/

# Turborepo local task cache (machine-local, never shared via git).
.turbo/
**/.turbo/


# Go contract bindings: generated from docs/reference/generated/openapi.json.
# Derived output, same treatment as the Prisma client and compodoc — the
# contract JSON is what gets committed, not its language bindings.
packages/contracts/go/openapi.gen.go

# Local Python virtualenv. uv creates one at the workspace root when run from
# there; nothing in the TS workspace uses it.
.venv/

# Python tool caches (uv/ruff/mypy/pytest create these wherever they run).
.mypy_cache/
.ruff_cache/
.pytest_cache/

# PDF 用的 CJK 静态字体是**构建产物**,不入库:
# 由 tools/fonts/build-pdf-font.py 从 node_modules 里的可变字体生成
# (含 postinstall / 构建前置步骤),与 **/generated/prisma/ 同一处置方式。
# 22 MB 二进制进 git 会永久留在历史里,而下一次字体升级它还会再来一份。
/apps/monolith/assets/fonts/*.ttf
