# LightRAG sidecar — 独立环境变量模板（唯一清单）
# ---------------------------------------------------------------------------
# 复制为同目录的 .env（gitignored）后填写：
#
#   cp deploy/lightrag/.env.example deploy/lightrag/.env
#   docker compose -f compose.dev.yaml --profile lightrag up -d lightrag
#
# 为什么是独立文件而不是复用 Lucent 的 .env：
#   1. 凭据暴露面 —— 这个 Python 容器不该能读到 JWT_* / DATABASE_URL / 微信密钥；
#      变量名撞名靠显式覆盖能解决，暴露面只能靠"不把秘密放进它读得到的地方"解决。
#   2. 变量名独立 —— LightRAG 用 LLM_BINDING* / EXTRACT_LLM_* / KEYWORD_LLM_* /
#      QUERY_LLM_* / EMBEDDING_* / RERANK_* / POSTGRES_*，与 Lucent 的 AI_* 是两套
#      配置、两个 key、各自轮换、各自限流；将来 Lucent 建英文 pgvector 时，改一边的
#      嵌入模型不会触发另一边的全量重建。
#
# 两处唯一共享的值是 LIGHTRAG_API_KEY：本文件的同名项必须与 Lucent 侧
# （.env.development / 生产环境变量）的 LIGHTRAG_API_KEY 完全一致 —— 这是鉴权握手，
# 不是模型配置复用。
#
# ⚠️ storage implementation 在文档加入后不可更换：下面四件套一次选定
#    （PG 系列，纯 SQL 表，不需要 AGE，不需要新数据库服务）。

# ── sidecar 鉴权（与 Lucent 侧 LIGHTRAG_API_KEY 必须一致）────────────
# LightRAG 服务端要求调用方带此请求头（请求头名是 X-API-Key，不是
# Authorization: Bearer）；留空则 sidecar 不鉴权。注意 /health 是白名单端点，
# 用错 key 也返回 200，只有 /query 之类才能真正验证两侧是否配对。
LIGHTRAG_API_KEY=replace_with_lightrag_handshake_key

# ── 存储四件套（一次选定，加入文档后不可更换）───────────────────────
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGTableGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# ── 独立 Postgres database（不污染 Prisma 迁移域）───────────────────
# 指向现有 Postgres 服务上的独立库，例如 lightrag。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=lightrag
POSTGRES_MAX_CONNECTIONS=12

# ── 并发与工作目录 ──────────────────────────────────────────────────
# MAX_PARALLEL_INSERT 只管文档级并行（PG 写入并发）；卡抽取吞吐的是 MAX_ASYNC_LLM
# （每角色 LLM 调用并发，默认 4）。两者是两个管道，别只调前者。
# 注意：同一变量在本文件里只能出现一次——dotenv 以最后的定义为准，
# 重复定义会让前面的改动静默失效。嵌入相关的并发项统一放在下面「嵌入」小节。
MAX_PARALLEL_INSERT=2
MAX_ASYNC_LLM=8
EXTRACT_MAX_ASYNC_LLM=8
KEYWORD_MAX_ASYNC_LLM=8
# 打印分阶段耗时，用于实测建图成本（默认 false）。
LIGHTRAG_PERFORMANCE_TIMING_LOGS=true
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs

# ── 抽取语言与领域本体 prompt ───────────────────────────────────────
# SUMMARY_LANGUAGE 默认 English，会产出英文实体描述；中文语料必须显式设 Chinese。
SUMMARY_LANGUAGE=Chinese
# prompt profile 相对 PROMPT_DIR 解析（默认 ./prompts，容器 WORKDIR=/app）。
# 只接受裸文件名 + 固定子目录 entity_type/，**不接受绝对路径**。
# compose 已把 ./deploy/lightrag/prompts 只读挂到 /app/data/prompts。
PROMPT_DIR=/app/data/prompts
ENTITY_TYPE_PROMPT_FILE=lumos_medicine.yml

# ── LLM 兜底（未单独设置的角色继承它）───────────────────────────────
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.example.com/v1
LLM_BINDING_API_KEY=replace_with_llm_api_key
LLM_MODEL=replace_with_default_model

# ── 按角色分离的模型（仅覆盖需要区分的角色）─────────────────────────
# 实体关系抽取 + 合并摘要：便宜、非 thinking 模型；仅建图时使用。
EXTRACT_LLM_MODEL=
EXTRACT_LLM_BINDING_HOST=
EXTRACT_LLM_BINDING_API_KEY=
# 关 thinking：role 级 provider option 走 {ROLE}_{BINDING}_{FIELD}，值为 JSON dict。
# 不关的话 thinking 模型会把生成预算烧在推理上，还可能因超时而丢掉整篇文档的抽取结果。
# 建议实际开启（本模板留空是因为它依赖具体模型的参数名）：
#   EXTRACT_OPENAI_LLM_EXTRA_BODY={"enable_thinking": false}
#   KEYWORD_OPENAI_LLM_EXTRA_BODY={"enable_thinking": false}
EXTRACT_OPENAI_LLM_EXTRA_BODY=
# 查询关键词抽取：便宜模型。
KEYWORD_LLM_MODEL=
KEYWORD_LLM_BINDING_HOST=
KEYWORD_LLM_BINDING_API_KEY=
KEYWORD_OPENAI_LLM_EXTRA_BODY=
# 检索问答：强模型。
QUERY_LLM_MODEL=
QUERY_LLM_BINDING_HOST=
QUERY_LLM_BINDING_API_KEY=

# ── 嵌入（自带配置；模型与维度锁定后不可轻改）───────────────────────
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.example.com/v1
EMBEDDING_BINDING_API_KEY=replace_with_embedding_api_key
EMBEDDING_MODEL=replace_with_embedding_model
EMBEDDING_DIM=1536

# ── 重排（可选）─────────────────────────────────────────────────────
RERANK_BINDING=aliyun
RERANK_BINDING_HOST=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_BINDING_API_KEY=
RERANK_MODEL=gte-rerank-v2

# ── 服务端 ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=9621
