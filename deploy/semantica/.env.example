# semantica-service —— 英文侧 OAG sidecar 的运行时配置
#
# 谁读这个文件：Lucent 三环境 compose 里的 `semantica` 服务（profile `semantica`）。
# 它**不是** lucent app 的 .env：那是独立进程、独立镜像、独立升级周期，不该读到
# JWT_* / DATABASE_URL / 微信密钥。用法与 deploy/lightrag/ 同构：
#
#   cp deploy/semantica/.env.example deploy/semantica/.env   # 按下面注释改
#   docker compose -f compose.dev.yaml --profile semantica up -d semantica
#   # 然后在 .env.development 里设 SEMANTICA_ENABLED=true
#
# 本文件只放**配置**：服务代码、依赖与镜像在独立仓 `semantica-service/`
# （它自己的 .env.example 是变量的完整清单，两边同名同义）。
#
# dev 也可以完全不起容器，直接在本机跑同一份配置：
#   cd semantica-service
#   cp ../Lucent/deploy/semantica/.env.example .env   # 或按本文件手写
#   uv run uvicorn semantica_service.main:app --port 8099
# 此时 Lucent 的 SEMANTICA_BASE_URL 指向 http://127.0.0.1:8099。

# ── 鉴权 ───────────────────────────────────────────────────────────
# ⚠️ 必填；留空时 sidecar **拒绝启动**（而不是以无鉴权的姿态对外服务）。
# 除 /health 外的每个端点都要求 `Authorization: Bearer <API_TOKEN>`。
#
# 必须与 Lucent 侧的 SEMANTICA_API_KEY **完全一致**：这是握手凭据，不是各环境
# 独立配置。生成：openssl rand -hex 32
#
# 为什么现在才加：sidecar 原先只在 compose 容器网络内、不发布宿主端口，因此
# 刻意不带凭据。跨云部署后端口已发布、调用来自另一台机器，那个前提不再成立
# ——/query 会按调用方的要求执行只读 Cypher。
#
# /health 有意保持免鉴权：compose 的 healthcheck 与负载均衡探针都调它，两者
# 都带不了凭据。
API_TOKEN=change-me

# ── Neo4j 连接 ─────────────────────────────────────────────────────
# 图后端是 Neo4j（Bolt），不再是 Postgres 上的 AGE 扩展：图数据不在
# Prisma 的 Postgres 里，两者完全独立，也没有需要隔离的 search_path。
#
# 容器内（compose 的 semantica 服务）：走服务名 `neo4j`；
# dev 本机直跑：compose 的 neo4j 发布在宿主 7687。
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# 必填，且必须与编排里的 NEO4J_PASSWORD 一致（compose 用它初始化，这里用它登录）。
# 留空时 sidecar **拒绝启动**而不是静默用无凭据连接。
NEO4J_PASSWORD=change-me
# 社区版只有一个库，保持默认即可。
NEO4J_DATABASE=neo4j

# ── 连接池 ─────────────────────────────────────────────────────────
# 单连接会把并发串行化（实测 16 并发慢 2.9×），所以按请求借还。
# driver 自带连接池，池的**总容量**由 POOL_MAX_SIZE 封顶；饱和时立即抛
# TimeoutError，不排队等待。
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10

# ── Provenance（哈希链审计表）───────────────────────────────────────
# 审计链存在 Postgres，且存在 **Lucent 的库**里（不是图库）：图只负责存图，
# 审计行不是图数据；与 Lucent 自己的 audit_logs 共用一条 SQL 连接即可同时读到。
# 该存储与图后端无关，AGE → Neo4j 迁移未触及它。
#
# ⚠️ libpq DSN 格式（key=value），**不是** URL 格式。
# 容器内走服务名 postgres；dev 本机直跑用宿主端口 15432。
PROVENANCE_DSN=host=postgres port=5432 dbname=lucent user=lucent password=change-me
PROVENANCE_TABLE=semantica_provenance

# ── Source（DrugBank 源表，只读）────────────────────────────────────
# 仅导入与校验脚本使用；服务在请求期**从不**读 DrugBank 源表。
# 格式同 PROVENANCE_DSN。
SOURCE_DSN=host=postgres port=5432 dbname=lucent user=lucent password=change-me

# ── 查询安全 ───────────────────────────────────────────────────────
# 查询超时走 Neo4j 的**事务超时**（`begin_transaction(timeout=)`），由服务端强制。
# 注意：`session.run(..., timeout=)` 与 `execute_read(..., timeout=)` 会被驱动
# **静默忽略**（实测：请求 2s 停止的查询跑了 17.4s），所以只能用事务超时。
# 稠密图上未加锚点的变长路径同样跑不完，没有这道闸一个坏查询就能拖垮整个 sidecar。
# **它决定 Lucent 侧 SEMANTICA_TIMEOUT_MS 的下限**：客户端超时必须大于这个值，
# 否则拿不到结构化的超时报错，重试回路也收不到"收窄查询"的提示。
STATEMENT_TIMEOUT_MS=15000
CONNECT_TIMEOUT_S=10

# ── 推理规模上限 ───────────────────────────────────────────────────
# 规则 join 在数据库里跑，但结果仍落在本进程；SHACL 校验同样是同步计算。
MAX_REASONING_FACTS=50000
REASONING_TIMEOUT_S=30

# ── 可观测性 ───────────────────────────────────────────────────────
# 默认 JSON：本服务的有效输出是量化的（载入多少边、是否截断、产出多少事实），
# 这些值只有作为字段才可查询；`text` 渲染同一批字段便于终端阅读。
LOG_LEVEL=INFO
LOG_FORMAT=json
