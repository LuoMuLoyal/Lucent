# semantica-service —— 英文侧 OAG sidecar 的运行时配置
#
# 谁读这个文件：Lucent 编排里的 `semantica` 服务（profile `semantica`）。
# 它**不是** lucent app 的 .env：那是独立进程、独立镜像、独立升级周期，不该读到
# JWT_* / DATABASE_URL / 微信密钥。用法与 deploy/lightrag/ 同构：
#
#   cp deploy/semantica/.env.example deploy/semantica/.env   # 按下面注释改
#   docker compose -f compose.dev.yaml --profile semantica up -d semantica
#   # 然后在 .env.development 里设 SEMANTICA_ENABLED=true
#
# 本文件只放**配置**：服务代码、依赖与镜像在独立仓 `semantica-service/`
# （它自己的 .env.example 是同一份清单，两边同名同义）。
#
# ═══════════════════════════════════════════════════════════════════════════
#  这个文件怎么读 —— 只需改「必填」那一节
# ═══════════════════════════════════════════════════════════════════════════
#
#  16 项里真正要你按环境填的只有 4 项：API_TOKEN、NEO4J_PASSWORD、
#  PROVENANCE_DSN、SOURCE_DSN —— 都在第 01 节。其余各项都有经过实测的默认值，
#  **没有具体理由就不要动** —— 它们出现在这里是让你知道旋钮存在，而不是让你
#  逐个决定。
#
#  全篇是**活行**：每一行都真的生效。没有注释掉的配置项，因为你无法从 `#` 区分
#  "可以不管"和"不填就起不来"。
#
# ═══════════════════════════════════════════════════════════════════════════
#  两种拓扑都支持 —— 按你的部署选一组默认值
# ═══════════════════════════════════════════════════════════════════════════
#
#  A. 同机（sidecar 与 Lucent 的 Postgres 在同一台，compose 同一网络）
#     → 第 01 节用文件里的默认值即可，只改两个口令。
#
#  B. 跨云（当前比赛期拓扑：sidecar + Neo4j 在腾讯云，Lucent + Postgres 在鲲鹏）
#     → Neo4j 四项仍用默认（Neo4j 与 sidecar 同机同 compose 网络）；
#       **PROVENANCE_DSN 必须改成鲲鹏 Postgres 的公网地址**（见第 04 节）。
#
#  判据很简单：审计链存在 **Lucent 的 Postgres** 里，所以
#  "Lucent 的 Postgres 在哪台，PROVENANCE_DSN 就写哪台"。

################################################################################
#  01 · 必填（4 项）
################################################################################

# ── 鉴权令牌 ───────────────────────────────────────────────────────
# 除 /health 外的每个端点都要求 `Authorization: Bearer <此值>`。
# ⚠️ 留空时 sidecar **拒绝启动**，而不是以无鉴权的姿态对外服务。
#
# **必须与 Lucent 侧的 SEMANTICA_API_KEY 完全一致**：这是握手凭据，不是各环境
# 独立配置。生成：openssl rand -hex 32
#
# 为什么需要它：早期设计里 sidecar 只在容器网络内、不发布宿主端口，因此刻意不带
# 凭据。跨云后端口已发布、调用来自另一台机器，那个前提不再成立 —— /query 会按
# 调用方的要求执行只读 Cypher。
API_TOKEN=change-me

# ── Neo4j 口令 ─────────────────────────────────────────────────────
# 必须与编排里 Neo4j 容器的 NEO4J_AUTH 口令一致（compose 用它初始化，这里用它登录）。
# 留空时 sidecar **拒绝启动**，而不是静默用无凭据连接。
NEO4J_PASSWORD=change-me

# ── 审计链所在 Postgres ────────────────────────────────────────────
# 见文件头「两种拓扑」：同机走服务名，跨云填鲲鹏的公网地址。
#
# ⚠️ libpq DSN 格式（key=value），**不是** URL 格式：
#      正确  host=10.0.0.5 port=5432 dbname=lucent user=lucent password=xxx
#      错误  postgresql://lucent:xxx@10.0.0.5:5432/lucent
#
# ⚠️ 填错**不会让服务起不来**：读取端把连带失败记成"审计存储不可用"，然后让所有
#    /reason 的溯源引用为空。也就是说表现是"推理正常但没有引用"，而不是报错。
#    跨云时尤其要对——它是这套拓扑里最容易错、又最不容易发现的一项。
PROVENANCE_DSN=host=postgres port=5432 dbname=lucent user=lucent password=change-me

# ── DrugBank 源表（只读）───────────────────────────────────────────
# ⚠️ **服务在请求期从不读它**，只有灌图/校验脚本用。跨云时若不在本机跑这些脚本，
#    这一项填不填都不影响 sidecar 运行；要让脚本也能跨云跑就填鲲鹏的公网地址。
#    格式同 PROVENANCE_DSN。
SOURCE_DSN=host=postgres port=5432 dbname=lucent user=lucent password=change-me

################################################################################
#  02 · 用默认（除非有具体理由）
################################################################################

# 审计行所在的表名。保持默认 —— 建表由 Lucent 侧的迁移负责，改名会让读取端
# 查一张不存在的表，而那个失败同样只表现为"引用为空"。
PROVENANCE_TABLE=semantica_provenance

# ── Neo4j 连接 ─────────────────────────────────────────────────────
# 图后端是 Neo4j（Bolt），不再是 Postgres 上的 AGE 扩展：图数据不在 Prisma 的
# Postgres 里，两者完全独立，也没有需要隔离的 search_path。
#
# 默认 `bolt://neo4j:7687` 走 compose 服务名 —— **两种拓扑下都对**，因为 Neo4j
# 与本 sidecar 始终同机同网络（跨云时是"它们俩一起在腾讯云"，不是 Neo4j 单独走）。
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# 社区版只有一个库，保持默认。该值同时作为 /schema 响应的 `graph` 字段返回，
# Lucent 侧把它当溯源元数据展示（故是 `neo4j` 而非旧 AGE 的 `lucent_graph`）。
NEO4J_DATABASE=neo4j

# ── 连接池 ─────────────────────────────────────────────────────────
# 单连接会把并发串行化（实测 16 并发慢 2.9×），所以按请求借还。
# driver 自带连接池，池的**总容量**由 POOL_MAX_SIZE 封顶；饱和时立即抛
# TimeoutError，不排队等待。
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10

# ── 查询安全 ───────────────────────────────────────────────────────
# 查询超时走 Neo4j 的**事务超时**（`begin_transaction(timeout=)`），由服务端强制。
# 注意：`session.run(..., timeout=)` 与 `execute_read(..., timeout=)` 会被驱动
# **静默忽略**（实测：请求 2s 停止的查询跑了 17.4s），所以只能用事务超时。
# 稠密图上未加锚点的变长路径同样跑不完，没有这道闸一个坏查询就能拖垮整个 sidecar。
#
# ⚠️ STATEMENT_TIMEOUT_MS 决定 Lucent 侧 SEMANTICA_TIMEOUT_MS 的下限：客户端超时
#    必须大于它（默认 15000 < 20000），否则拿不到结构化超时报错，重试回路也收不到
#    "收窄查询"的提示。改大它就必须同步改大 SEMANTICA_TIMEOUT_MS。
STATEMENT_TIMEOUT_MS=15000
CONNECT_TIMEOUT_S=10

# ── 推理规模上限 ───────────────────────────────────────────────────
# 规则 join 在数据库里跑，但结果仍落在本进程；SHACL 校验同样是同步计算。
# scope_all 的规则可能返回图中每一对，故保留上限。
MAX_REASONING_FACTS=50000
REASONING_TIMEOUT_S=30

# ── 可观测性 ───────────────────────────────────────────────────────
# 默认 JSON：本服务的有效输出是量化的（载入多少边、是否截断、产出多少事实），
# 这些值只有作为字段才可查询；`text` 渲染同一批字段便于终端阅读。
LOG_LEVEL=INFO
LOG_FORMAT=json
