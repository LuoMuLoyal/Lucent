JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=
AI_VISION_MODEL=

LOG_LEVEL=debug
