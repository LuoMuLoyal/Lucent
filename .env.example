# semantica-service configuration.
# Copy to .env and adjust. Never commit the result.

# --- Apache AGE -------------------------------------------------------
# AGE lives in its own database: the adapter issues SET search_path =
# ag_catalog for every session, which would shadow the Prisma schema's tables.
# Dev stack default below; production uses the in-cluster Postgres.
AGE_DSN=host=127.0.0.1 port=15433 dbname=lucent_graph user=postgres password=postgres
GRAPH_NAME=lucent_graph

# --- Connection pool --------------------------------------------------
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10

# --- Query safety -----------------------------------------------------
# Applied to every pooled connection. Prevents a runaway variable-length
# path from occupying a worker indefinitely.
STATEMENT_TIMEOUT_MS=15000
CONNECT_TIMEOUT_S=10

# --- Reasoning --------------------------------------------------------
MAX_REASONING_FACTS=50000
REASONING_TIMEOUT_S=30
