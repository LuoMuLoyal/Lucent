# semantica-service configuration.
# Copy to .env and adjust. Never commit the result.

# --- Neo4j ------------------------------------------------------------
# Neo4j is its own server, so unlike the previous Apache AGE deployment there
# is no database to share with the Prisma schema and no search_path to
# override. 7687 is Bolt; 7474 is the browser UI and is not used here.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# --- Connection pool --------------------------------------------------
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10

# --- Query safety -----------------------------------------------------
# Applied to every transaction. Neo4j has no per-connection statement_timeout,
# so this is passed to begin_transaction(timeout=...): the per-call
# `session.run(timeout=...)` is accepted and IGNORED by the driver (measured),
# which is why the timeout is carried by the transaction instead.
STATEMENT_TIMEOUT_MS=15000
CONNECT_TIMEOUT_S=10

# --- Reasoning --------------------------------------------------------
MAX_REASONING_FACTS=50000
REASONING_TIMEOUT_S=30
