################################################################################
#  Lucent — test
################################################################################
#  用法：cp .env.test.example .env.test
#  本文件入库；.env.test 不入库。单元测试与 e2e 共用这一份。
#
#  全部变量以活行给出。每个变量上方的注释说明：它是什么、控制什么、
#  什么时候该改。development / production 各有自己完整的一份，不是增量。
################################################################################


################################################################################
#  01 · 运行时
################################################################################

# 运行环境。test 会额外注册 /api/v1/testing/* 路由。
NODE_ENV=test

# HTTP 监听地址。
HOST=0.0.0.0

# HTTP 监听端口。
PORT=3000

# 对外基址。e2e 里拼回调地址用。
PUBLIC_BASE_URL=http://localhost:3000

# 浏览器跨域白名单，逗号分隔。留空 = 不启用 CORS。
CORS_ORIGIN=

# 是否信任反代的 X-Forwarded-* 头。e2e 在代理后跑，限流要按真实客户端 IP 计数。
TRUST_PROXY=true

# 是否挂载 AdminJS 管理面板（/admin）。
# 测试不需要面板，设为 false 可跳过 adminjs 依赖加载与 Prisma DMMF 自省，
# 明显缩短启动时间；**不影响 04 节三个凭据的必填性**。
ADMIN_ENABLED=false


################################################################################
#  02 · 数据库与缓存
################################################################################

# Prisma 连接串。test 走 compose.dev.yaml 的 postgres-test（宿主端口 5432）。
DATABASE_URL=postgresql://lucent:lucent_dev@127.0.0.1:5432/lucent?schema=public

# ⚠️ REDIS_URL 在本文件里**刻意不设置**，这是全文唯一的例外。
#    留空会让缓存/限流/队列退回内存实现，测试之间不互相污染。
#    必须整行不写：写成 `REDIS_URL=` 会因格式校验不通过而启动失败。
#    若某条 e2e 需要真实的限流/队列行为，取消下面这行注释并起 redis：
# REDIS_URL=redis://127.0.0.1:6379


################################################################################
#  03 · JWT
################################################################################

# 访问令牌签名密钥。至少 32 字符。测试用固定值，保证令牌可复现。
JWT_ACCESS_SECRET=test_access_secret_for_e2e_min32

# 刷新令牌签名密钥。至少 32 字符，且必须与上面不同。
JWT_REFRESH_SECRET=test_refresh_secret_for_e2e_min32

# 访问令牌有效期。
JWT_ACCESS_TTL=15m

# 刷新令牌有效期。
JWT_REFRESH_TTL=14d

# 令牌签发方与受众。
JWT_ISSUER=lucent-api
JWT_AUDIENCE=luminous-app


################################################################################
#  04 · 后台管理面板（/admin）
################################################################################

# 管理员登录账号。
ADMIN_EMAIL=admin@lucent.local

# 管理员登录密码。
ADMIN_PASSWORD=admin12345

# 管理面板会话 Cookie 的签名密钥。
ADMIN_COOKIE_SECRET=test_lucent_admin_cookie_secret_32_chars


################################################################################
#  05 · AI 模型
################################################################################
#  测试不连真模型：AI 调用一律走 mock，所以整块留空。
#  若某条 e2e 需要真实调用，按 development 模板补全**整组三个变量**。

# 提供商标识。留空 = 所有 AI 角色都不生效。
AI_PROVIDER=

AI_ANALYSIS_BASE_URL=
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_MODEL=

AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=

AI_LANGUAGE_BASE_URL=
AI_LANGUAGE_API_KEY=
AI_LANGUAGE_MODEL=

AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

AI_CHAT_COMPRESSION_BASE_URL=
AI_CHAT_COMPRESSION_API_KEY=
AI_CHAT_COMPRESSION_MODEL=

AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# 嵌入向量维度。
AI_EMBEDDING_DIMENSION=1536

# 安全策略拦截词。留空使用内置的医疗建议基线。
AI_SAFETY_FORBIDDEN_PATTERNS=


################################################################################
#  06 · 邮件
################################################################################

# 发送驱动。log = 只写日志，不发信。测试保持 log。
MAIL_DRIVER=log

# SMTP 服务器地址。driver=smtp 时生效。
MAIL_HOST=smtp.example.com

# SMTP 端口。
MAIL_PORT=587

# 发件人地址。
MAIL_FROM=noreply@example.com

# SMTP 登录凭据。测试留空。
MAIL_USER=
MAIL_PASS=

# 邮件队列单封邮件最多重试次数。
MAIL_QUEUE_MAX_ATTEMPTS=3

# 重试间隔基数（毫秒）。
MAIL_QUEUE_BACKOFF_DELAY_MS=5000

# 同时处理的邮件任务数。
MAIL_QUEUE_WORKER_CONCURRENCY=3

# 已完成任务保留时长（秒）。
MAIL_QUEUE_COMPLETE_AGE_SECONDS=86400

# 失败任务保留时长（秒）。
MAIL_QUEUE_FAIL_AGE_SECONDS=604800

# 已完成任务最多保留条数。
MAIL_QUEUE_COMPLETE_MAX_COUNT=1000

# 失败任务最多保留条数。
MAIL_QUEUE_FAIL_MAX_COUNT=5000


################################################################################
#  07 · 第三方登录
################################################################################
#  测试不配置任何 OAuth provider，凭据全部留空 —— 留空不阻断启动。
#  ⚠️ 三个 REDIRECT_URI 例外：它们是格式校验过的，不能留空，必须写成合法 URL。

# ── 微信 · 网页扫码 ──
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/wechat-web/callback

# ── 微信 · 移动端 SDK ──
WECHAT_MOBILE_APP_ID=
WECHAT_MOBILE_APP_SECRET=

# ── Apple ──
APPLE_APP_ID=
APPLE_CLIENT_SECRET=

# ── QQ ──
QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/qq/callback

# ── Google ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback


################################################################################
#  08 · 对象存储
################################################################################
#  测试不落盘到对象存储，三家的凭据全部留空。

# 使用哪家对象存储：s3 | tencent-cos | ali-oss。
STORAGE_PROVIDER=s3

# ── S3 兼容 ──
STORAGE_S3_ENDPOINT=
STORAGE_S3_CLIENT_ENDPOINT=
STORAGE_S3_EXTERNAL_ENDPOINT=
STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_UPLOAD_EXPIRES_SECONDS=600
STORAGE_S3_MAX_UPLOAD_BYTES=10485760
STORAGE_S3_DOWNLOAD_EXPIRES_SECONDS=600

# ── 腾讯云 COS ──
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_PUBLIC_BASE_URL=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_UPLOAD_EXPIRES_SECONDS=600
TENCENT_COS_MAX_UPLOAD_BYTES=10485760
TENCENT_COS_DOWNLOAD_EXPIRES_SECONDS=600

# ── 阿里云 OSS 专用 SDK ──
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PUBLIC_BASE_URL=
ALIYUN_OSS_UPLOAD_EXPIRES_SECONDS=600
ALIYUN_OSS_MAX_UPLOAD_BYTES=10485760
ALIYUN_OSS_DOWNLOAD_EXPIRES_SECONDS=600


################################################################################
#  09 · 极光推送
################################################################################
#  两个凭据成对留空 = 静默禁用推送，测试不会真的发通知。

JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
JPUSH_APNS_PRODUCTION=false
JPUSH_API_BASE_URL=https://api.jpush.cn


################################################################################
#  10 · LightRAG sidecar（中文说明书检索）
################################################################################
#  单测与仿真都用 mock，不连真 sidecar，因此保持关闭。

# 总开关。关闭时检索工具返回"未配置"信封，不抛错。
LIGHTRAG_ENABLED=false

# sidecar 地址。
LIGHTRAG_BASE_URL=http://127.0.0.1:9621

# sidecar 调用密钥。启用时必填，且须与 deploy/lightrag/.env 同名项一致。
LIGHTRAG_API_KEY=

# naive 模式的客户端超时（毫秒）。
LIGHTRAG_TIMEOUT_MS=8000

# 图模式的独立预算（毫秒）。
LIGHTRAG_GRAPH_TIMEOUT_MS=60000

# 逗号分隔的来源列表，含义是"这些来源的图已经建好了"。空串 = 图模式全禁。
LIGHTRAG_GRAPH_SOURCES=leaflet

# workspace 名。
LIGHTRAG_WORKSPACE_LEAFLET=leaflet
LIGHTRAG_WORKSPACE_QA=qa


################################################################################
#  11 · Semantica sidecar（英文侧 OAG 本体推理）
################################################################################
#  测试同样默认关闭。

# 总开关。关闭时 reason_over_ontology 返回"未配置"信封，不抛错。
SEMANTICA_ENABLED=false

# sidecar 地址。
SEMANTICA_BASE_URL=http://127.0.0.1:8099

# 客户端超时（毫秒）。须大于 sidecar 自己的查询超时（默认 15 秒）。
SEMANTICA_TIMEOUT_MS=20000


################################################################################
#  12 · 可观测性
################################################################################

# 日志级别。测试默认 error（几乎静默）；排查用例时临时改 debug。
# 不设置时按环境取默认：development=debug / test=error / production=info。
LOG_LEVEL=error

# 日志格式：pretty（人读）| json（机器采集）。
# 不设置时按环境取默认：development=pretty，其余=json。
LOG_FORMAT=pretty

# 请求耗时超过该值（毫秒）打一条 warn。
SLOW_REQUEST_THRESHOLD_MS=2000

# 数据库查询耗时超过该值（毫秒）打一条 warn。
SLOW_QUERY_THRESHOLD_MS=500

# 是否采集 Prometheus 指标（/metrics）。
# 测试里想避免全局 registry 在用例间串扰时设为 false。
METRICS_ENABLED=true

# /metrics 的 Basic Auth 凭据。两者必须同时设置。
METRICS_USER=
METRICS_PASSWORD=

# 是否启动 OpenTelemetry SDK。测试保持关闭。
OTEL_ENABLED=false

# OTLP 追踪上报地址。仅 OTEL_ENABLED=true 时使用。
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# VictoriaLogs 日志投递地址。留空则只输出到 stdout。
VICTORIALOGS_URL=


################################################################################
#  13 · 客户端运营
################################################################################

# App"关于"页展示的支持邮箱。必须写成合法邮箱，不能留空。
SUPPORT_EMAIL=support@example.com

# 低于该版本的客户端会被提示更新。留空 = 不做版本门控。
MIN_CLIENT_VERSION=

# 当前最新版本号。
LATEST_VERSION=

# App 下载地址。
DOWNLOAD_URL=


################################################################################
#  14 · 验证码 / OAuth state
################################################################################

# 邮箱验证码有效期（毫秒）。
VERIFICATION_CODE_TTL_MS=300000

# 两次发送验证码之间的冷却时间（毫秒）。
VERIFICATION_COOLDOWN_MS=60000

# 验证码发送频率限制的统计窗口（毫秒）。
VERIFICATION_RATE_LIMIT_WINDOW_MS=600000

# 单个窗口内最多发送次数。
VERIFICATION_RATE_LIMIT_MAX=20

# 验证码位数。
VERIFICATION_CODE_LENGTH=6

# OAuth state 有效期（毫秒）。
OAUTH_STATE_TTL_MS=600000


################################################################################
#  15 · 内部 / 构建期
################################################################################

# OpenAPI 导出脚本自己设置，用于跳过数据库连接。
OPENAPI_EXPORT_SKIP_DB_CONNECT=false

# 同上，跳过 Redis 连接。
OPENAPI_EXPORT_SKIP_REDIS=false

# /api/v1/testing/* 的共享密钥（请求头 x-testing-shared-secret）。
# 仅在 NODE_ENV=test 时注册这些路由，因此这份文件里是真正生效的地方。
TESTING_SHARED_SECRET=e2e-test-shared-secret-change-me

# Scalar API 文档的自托管版本 slug。留空则从 package.json 读取。
SCALAR_API_REFERENCE_VERSION=
