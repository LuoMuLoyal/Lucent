NODE_ENV=test

# ── 启动选择器 ──
TRUST_PROXY=true

# ── 数据库（敏感）──
DATABASE_URL=postgresql://lucent:lucent_dev@127.0.0.1:5432/lucent?schema=public

# 不设 REDIS_URL → cache-manager fallback 到内存缓存

# ── JWT（敏感）──
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
JWT_ACCESS_SECRET=test_access_secret_for_e2e_min32
JWT_REFRESH_SECRET=test_refresh_secret_for_e2e_min32
# JWT_ISSUER=
# JWT_AUDIENCE=

# ── Better Auth（敏感）──
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=test_better_auth_secret_for_spike_min32_
# BETTER_AUTH_EMAIL_CALLBACK_URL=luminous://auth/callback

# ── 后台管理（敏感）──
ADMIN_EMAIL=admin@lucent.local
ADMIN_PASSWORD=admin12345
ADMIN_COOKIE_SECRET=test_lucent_admin_cookie_secret_32_chars

# ── AI (OpenAI-compatible only) ──
# AI_PROVIDER=openai-compatible

# ── 邮件凭据（敏感；driver/host/port/from 已迁移到 config/default.yaml）──
MAIL_USER=
MAIL_PASS=

# ── OAuth / 微信网页登录（测试环境默认不配置）──
# WECHAT_WEB_APP_ID=
# WECHAT_WEB_APP_SECRET=
# WECHAT_WEB_REDIRECT_URI=

# ── OAuth / 微信移动端登录 ──
# WECHAT_MOBILE_APP_ID=
# WECHAT_MOBILE_APP_SECRET=

# ── OAuth / Apple 登录 ──
# APPLE_APP_ID=

# ── OAuth / QQ 登录 ──
# QQ_APP_ID=
# QQ_APP_SECRET=
# QQ_REDIRECT_URI=

# ── 腾讯云 COS 凭据（敏感）──
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=
# TENCENT_COS_BUCKET=
# TENCENT_COS_PUBLIC_BASE_URL=

# ── OpenAPI 导出（可选）──
# OPENAPI_EXPORT_SKIP_DB_CONNECT=false
# OPENAPI_EXPORT_SKIP_REDIS=false

# ── 可观测性 ──
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# ── 测试支持端点共享密钥 ──
TESTING_SHARED_SECRET=e2e-test-shared-secret-change-me

# ── 极光推送凭据（测试默认禁用）──
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# ── 非敏感运行时配置请见 config/default.yaml 和 config/test.yaml ──
