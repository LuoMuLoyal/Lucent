NODE_ENV=test

# ── 服务器 ──
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=*

# ── 数据库（本地 test / e2e） ──
DATABASE_URL=postgresql://lucent:lucent_dev@127.0.0.1:5432/lucent?schema=public

# 不设 REDIS_URL → cache-manager fallback 到内存缓存

# ── JWT ──
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
JWT_ACCESS_SECRET=test_access_secret_for_e2e
JWT_REFRESH_SECRET=test_refresh_secret_for_e2e

# ── 后台管理 ──
ADMIN_EMAIL=admin@lucent.local
ADMIN_PASSWORD=admin12345
ADMIN_COOKIE_SECRET=test_lucent_admin_cookie_secret_32_chars

# ── 邮件 (test: console) ──
MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_FROM=noreply@example.com
MAIL_USER=
MAIL_PASS=

# ── 日志 ──
LOG_LEVEL=debug
