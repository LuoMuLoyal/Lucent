# Mem0 self-hosted server — 运行配置模板。
#
# 复制为 `infra/mem0/.env` 后填入真实值。该文件已被 .gitignore 忽略
# （与 infra/lightrag/.env 同一处置：含模型 key，属运行配置而非仓库事实）。
#
# 切分理由与 lightrag / semantica 一致：本文件**不含** Lucent 的
# DATABASE_URL / JWT_* / 微信密钥。Mem0 只需要它自己那两个 database 的连接。

# ── 数据库 ────────────────────────────────────────────────────────────
# 复用既有 postgres-dev，但**独立 database**，不碰 Prisma 迁移域：
#   mem0      —— pgvector 记忆表（POSTGRES_DB）
#   mem0_app  —— Mem0 自己的 users / api_keys / request_logs（APP_DB_NAME，
#                Alembic 在首启时自动建表）
# `users` 与 Prisma 的 `User` 同名，同库必然撞名，所以必须是两个独立库。
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=15432
POSTGRES_DB=mem0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_COLLECTION_NAME=memories
APP_DB_NAME=mem0_app

# ── 鉴权（默认开启，不要关）────────────────────────────────────────────
# JWT_SECRET 缺失时 auth 端点直接 500。生成：
#   openssl rand -base64 48
JWT_SECRET=
# 本地开发专用；生产必须是 false。
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3080

# Lucent 调用 Mem0 用的 key。首启由 `make bootstrap` 或 setup wizard 生成，
# 形如 `m0sk_...`（服务只存前缀 + bcrypt，**只在生成时显示一次**）。
# 拿到后填这里，Lucent 侧通过环境变量 MEM0_API_KEY 读取。
ADMIN_API_KEY=

# ── 模型 ──────────────────────────────────────────────────────────────
# 关键约束：Mem0 的 provider 白名单写死在它自己的 server/main.py
#   BUNDLED_LLM_PROVIDERS      = ("openai", "anthropic", "gemini")
#   BUNDLED_EMBEDDER_PROVIDERS = ("openai", "gemini")
# 白名单外的 provider 在 POST /configure 阶段即被 400 拒绝。
#
# 但 `openai` provider 支持 baseURL（mem0ai/dist/oss/index.js：
# `baseURL: config.baseURL || config.url`），所以只要模型池是 OpenAI 兼容的，
# 用 provider=openai + 自建 baseURL 就能零改造接入，不需要改它的 Python 源码。
# 这一步是否成立是接入的 go/no-go 闸门。
#
# 下面的 key/base 是 Mem0 **容器内**使用的；Lucent 自己的模型池配置在
# .env.development 里，两者不要混。
OPENAI_API_KEY=
OPENAI_BASE_URL=

MEM0_DEFAULT_LLM_MODEL=
MEM0_DEFAULT_EMBEDDER_MODEL=

# ── 遥测 ──────────────────────────────────────────────────────────────
# 默认 true，会向 Mem0 上报 install UUID 与邮件域。本项目没有向外发送的理由。
MEM0_TELEMETRY=false

# request_logs 保留天数（`make prune-logs` 用，需自行接 cron）。
REQUEST_LOG_RETENTION_DAYS=30
