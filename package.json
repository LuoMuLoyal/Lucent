{
  "name": "lucent",
  "version": "1.0.0-dev",
  "description": "NestJS backend for Luminous — a personal health management assistant with medication safety, daily records, and AI-powered insights.",
  "author": "LuoMuLoyal",
  "private": true,
  "license": "MIT",
  "imports": {
    "#generated/*": "./generated/*"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "check": "pnpm lint:check && pnpm format:check && pnpm typecheck && pnpm typecheck:tools && pnpm build && pnpm test:ci && pnpm test:e2e:ci",
    "prepare": "simple-git-hooks",
    "postinstall": "pnpm prisma:generate",
    "build": "nest build",
    "typecheck": "pnpm exec tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:tools": "pnpm exec tsc -p scripts/tsconfig.json --noEmit && pnpm exec tsc -p deploy/tsconfig.json --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --ignore-pattern \"generated/**\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" --ignore-pattern \"generated/**\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:test:dev": "cross-env NODE_ENV=test nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:ci": "cross-env NODE_ENV=test vitest run --reporter=dot",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "test:ci:coverage": "cross-env NODE_ENV=test vitest run --coverage --reporter=dot",
    "test:e2e": "cross-env NODE_ENV=test vitest run --config ./vitest.e2e.config.ts",
    "test:e2e:ci": "pnpm test:e2e",
    "test:contract": "cross-env NODE_ENV=test vitest run --config ./vitest.e2e.config.ts test/contract/",
    "test:security": "cross-env NODE_ENV=test vitest run --config ./vitest.e2e.config.ts test/security/",
    "test:perf:health": "k6 run -e BASE_URL=http://127.0.0.1:3000 test/performance/health.k6.ts",
    "test:perf:medicines": "k6 run -e BASE_URL=http://127.0.0.1:3000 test/performance/medicines.k6.ts",
    "test:perf:auth": "k6 run -e BASE_URL=http://127.0.0.1:3000 test/performance/authenticated.k6.ts",
    "test:runtime:start": "node scripts/dev/start-test-runtime.ts",
    "test:runtime:stop": "node scripts/dev/stop-test-runtime.ts",
    "prisma:generate": "pnpm exec prisma generate && node scripts/dev/fix-generated-prisma-internal.ts",
    "db:migrate:dev": "cross-env NODE_ENV=development pnpm exec prisma migrate deploy",
    "db:migrate:test": "cross-env NODE_ENV=test pnpm exec prisma migrate deploy",
    "db:migrate": "pnpm prisma:generate && pnpm db:migrate:dev && pnpm db:migrate:test",
    "db:migrate:all": "pnpm db:migrate",
    "dev:stack": "node scripts/dev/up-local-stack.ts",
    "dev:stack:up": "pnpm dev:stack",
    "import:medicine:all": "node scripts/import/medicine/import-medicine-datasets.ts",
    "import:food:categories": "node scripts/import/food/import-food-composition.ts categories",
    "import:food:items": "node scripts/import/food/import-food-composition.ts items",
    "export:openapi": "pnpm prisma:generate && pnpm build && cross-env NODE_ENV=development node scripts/contract/export-openapi.ts",
    "deploy:smoke": "node deploy/smoke.ts",
    "deploy:server": "node deploy/deploy.ts",
    "docs:compodoc": "compodoc -c compodoc.json"
  },
  "dependencies": {
    "@babel/plugin-syntax-import-assertions": "7.29.7",
    "@fontpkg/source-han-sans-sc-vf": "^2.5.3",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.4.2",
    "@langchain/openai": "1.4.7",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^9.0.0",
    "@fastify/view": "^11.0.0",
    "fastify": "^5.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/internals": "7.8.0",
    "@sergiyiva/adminjs-prisma": "^2.0.1",
    "@tiptap/core": "2.27.2",
    "@tiptap/pm": "2.27.2",
    "adminjs": "^7.8.17",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.0",
    "cache-manager": "^7.2.8",
    "cache-manager-ioredis-yet": "^2.1.2",
    "chart.js": "^4.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "keyv": "^5.6.0",
    "langchain": "1.4.4",
    "nest-winston": "^1.10.2",
    "nestjs-i18n": "^10.8.4",
    "nodemailer": "^8.0.9",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@adminjs/fastify": "^4.2.0",
    "@fastify/session": "^11.1.0",
    "@scalar/nestjs-api-reference": "^1.2.6",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.13.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/hooks/check-docs-updated.ts && pnpm lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1",
    "pre-push": "pnpm lint:check && pnpm typecheck"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
