{
  "name": "lucent",
  "version": "0.1.0-dev",
  "description": "NestJS backend for Luminous — a personal health management assistant with medication safety, daily records, and AI-powered insights.",
  "author": "LuoMuLoyal",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#generated/*": "./generated/*"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24.15 <25",
    "pnpm": ">=11 <13"
  },
  "scripts": {
    "check": "pnpm lint:oxlint && pnpm lint:eslint && pnpm format:check && pnpm typecheck && pnpm typecheck:tools && pnpm build && pnpm test:ci && pnpm test:e2e:ci",
    "prepare": "simple-git-hooks",
    "postinstall": "pnpm prisma:generate",
    "build": "nest build",
    "typecheck": "pnpm exec tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:tools": "pnpm exec tsc -p scripts/tsconfig.json --noEmit && pnpm exec tsc -p deploy/tsconfig.json --noEmit",
    "lint": "oxlint --fix && eslint \"{src,apps,libs,test}/**/*.ts\" --ignore-pattern \"generated/**\" --fix",
    "lint:check": "oxlint && eslint \"{src,apps,libs,test}/**/*.ts\" --ignore-pattern \"generated/**\" --max-warnings=0",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:eslint": "eslint \"{src,apps,libs,test}/**/*.ts\" --ignore-pattern \"generated/**\" --max-warnings=0",
    "lint:eslint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --ignore-pattern \"generated/**\" --fix",
    "arch:check": "pnpm exec depcruise src --config .dependency-cruiser.cjs && pnpm exec eslint --no-config-lookup -c eslint.arch.config.ts \"src/**/*.ts\" \"test/**/*.ts\" && node scripts/arch/check-ast-conventions.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"deploy/**/*.ts\" \"*.{ts,json,yml,yaml,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"deploy/**/*.ts\" \"*.{ts,json,yml,yaml,md}\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:test:dev": "cross-env NODE_ENV=test nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "test": "cross-env NODE_ENV=test vitest run && pnpm test:eslint-plugins",
    "test:ci": "cross-env NODE_ENV=test vitest run --reporter=dot && pnpm test:eslint-plugins:ci && pnpm test:tools",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage && pnpm test:eslint-plugins",
    "test:ci:coverage": "cross-env NODE_ENV=test vitest run --coverage --reporter=dot && pnpm test:eslint-plugins:ci",
    "test:e2e": "cross-env NODE_ENV=test vitest run --config ./vitest.e2e.config.ts",
    "test:e2e:ci": "pnpm test:e2e",
    "test:eslint-plugins": "cross-env NODE_ENV=test vitest run --config ./vitest.eslint-plugins.config.ts",
    "test:eslint-plugins:ci": "cross-env NODE_ENV=test vitest run --config ./vitest.eslint-plugins.config.ts --reporter=dot",
    "test:tools": "cross-env NODE_ENV=test vitest run --config ./vitest.tools.config.ts",
    "test:contract": "cross-env NODE_ENV=test vitest run --config ./vitest.e2e.config.ts test/contract/",
    "test:security": "cross-env NODE_ENV=test vitest run --config ./vitest.e2e.config.ts test/security/",
    "test:perf:health": "k6 run -e BASE_URL=http://127.0.0.1:3000 test/performance/health.k6.ts",
    "test:perf:medicines": "k6 run -e BASE_URL=http://127.0.0.1:3000 test/performance/medicines.k6.ts",
    "test:perf:auth": "k6 run -e BASE_URL=http://127.0.0.1:3000 test/performance/authenticated.k6.ts",
    "test:runtime:start": "node scripts/dev/start-test-runtime.ts",
    "test:runtime:stop": "node scripts/dev/stop-test-runtime.ts",
    "prisma:generate": "pnpm exec prisma generate && node scripts/dev/fix-generated-prisma-internal.ts",
    "db:migrate:dev": "cross-env NODE_ENV=development pnpm exec prisma migrate deploy",
    "db:migrate:test": "cross-env NODE_ENV=test pnpm exec prisma migrate deploy",
    "db:migrate": "pnpm prisma:generate && pnpm db:migrate:dev && pnpm db:migrate:test",
    "db:migrate:all": "pnpm db:migrate",
    "dev:stack": "node scripts/dev/up-local-stack.ts",
    "dev:stack:up": "pnpm dev:stack",
    "dev:stack:down": "docker compose -f docker-compose.dev.yml down",
    "dev:stack:reset": "docker compose -f docker-compose.dev.yml down -v && pnpm dev:stack:up",
    "db:reset:dev": "cross-env NODE_ENV=development pnpm exec prisma migrate reset --force",
    "db:reset:test": "cross-env NODE_ENV=test pnpm exec prisma migrate reset --force",
    "import:medicine:all": "node scripts/import/medicine/import-medicine-datasets.ts",
    "import:food:categories": "node scripts/import/food/import-food-composition.ts categories",
    "import:food:items": "node scripts/import/food/import-food-composition.ts items",
    "openapi:export": "cross-env NODE_ENV=development node scripts/contract/export-openapi.ts",
    "export:openapi": "pnpm prisma:generate && pnpm build && pnpm openapi:export",
    "deploy:smoke": "node deploy/smoke.ts",
    "deploy:server": "node deploy/deploy.ts",
    "docs:compodoc": "compodoc -c compodoc.json",
    "docs:check": "node scripts/docs/verify.ts --report",
    "docs:verify": "node scripts/docs/verify.ts --verify",
    "docs:links": "node scripts/docs/links.ts"
  },
  "dependencies": {
    "@adminjs/fastify": "^4.2.0",
    "@aws-sdk/client-s3": "^3.765.0",
    "@aws-sdk/s3-request-presigner": "^3.765.0",
    "@babel/plugin-syntax-import-assertions": "7.29.7",
    "@better-auth/prisma-adapter": "1.7.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^9.0.0",
    "@fastify/view": "^11.0.0",
    "@fontpkg/source-han-sans-sc-vf": "^2.5.3",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.4.2",
    "@langchain/langgraph-checkpoint": "^1.1.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/openai": "1.4.7",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/internals": "7.9.1",
    "@scalar/api-reference": "^1.64.0",
    "@scalar/nestjs-api-reference": "^1.2.6",
    "@sergiyiva/adminjs-prisma": "^2.0.1",
    "@tiptap/core": "2.27.2",
    "@tiptap/pm": "2.27.2",
    "adminjs": "^7.8.17",
    "argon2": "^0.44.0",
    "better-auth": "1.7.1",
    "bullmq": "^5.78.0",
    "bullmq-otel": "^2.0.1",
    "cache-manager": "^7.2.8",
    "cache-manager-ioredis-yet": "^2.1.2",
    "chart.js": "^4.5.1",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "ioredis": "^5.4.6",
    "jsonwebtoken": "^9.0.3",
    "keyv": "^5.6.0",
    "langchain": "1.4.4",
    "nest-winston": "^1.10.2",
    "nestjs-i18n": "^10.8.4",
    "neverthrow": "8.2.0",
    "nodemailer": "^8.0.9",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "prisma": "^7.9.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@fastify/session": "^11.1.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "acorn": "^8.18.0",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-oxlint": "^1.80.0",
    "globals": "^17.0.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.5",
    "oxlint": "^1.80.0",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.13.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged",
    "commit-msg": "npx --no-install commitlint --edit $1",
    "pre-push": "pnpm lint:check && pnpm arch:check && pnpm docs:verify && pnpm docs:links"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
