{
  "name": "lucent",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.33.2 <11"
  },
  "scripts": {
    "check": "pnpm lint:check && pnpm typecheck && pnpm typecheck:tools && pnpm build && pnpm test:ci && pnpm test:e2e:ci && pnpm deploy:assets:check",
    "build": "nest build",
    "typecheck": "pnpm exec tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:tools": "pnpm exec tsc -p scripts/tsconfig.json --noEmit && pnpm exec tsc -p deploy/tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:test:dev": "cross-env NODE_ENV=test nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --ignore-pattern \"src/generated/**\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" --ignore-pattern \"src/generated/**\" --max-warnings=0",
    "deploy:assets:check": "node deploy/validate-assets.ts",
    "deploy:smoke": "node deploy/post-deploy-smoke.ts",
    "deploy:server": "node deploy/deploy-server.ts",
    "dev:stack": "node scripts/dev/up-local-stack.ts",
    "db:migrate:dev": "cross-env NODE_ENV=development pnpm exec prisma migrate deploy",
    "db:migrate:test": "cross-env NODE_ENV=test pnpm exec prisma migrate deploy",
    "db:migrate": "pnpm exec prisma generate && cross-env NODE_ENV=development pnpm exec prisma migrate deploy && cross-env NODE_ENV=test pnpm exec prisma migrate deploy",
    "test:runtime:start": "node scripts/dev/start-test-runtime.ts",
    "test:runtime:stop": "node scripts/dev/stop-test-runtime.ts",
    "import:medicine:all": "node scripts/import/medicine/import-medicine-datasets.ts",
    "test": "cross-env NODE_ENV=test jest",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:ci": "cross-env NODE_ENV=test jest --runInBand",
    "test:ci:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "test:e2e": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:ci": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "export:openapi": "pnpm build && cross-env NODE_ENV=development node scripts/contract/export-openapi.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@babel/plugin-syntax-import-assertions": "7.29.7",
    "@fontpkg/source-han-sans-sc-vf": "^2.5.3",
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.4.2",
    "@langchain/openai": "1.4.7",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/internals": "7.8.0",
    "@sergiyiva/adminjs-prisma": "^2.0.1",
    "@tiptap/core": "2.27.2",
    "@tiptap/pm": "2.27.2",
    "adminjs": "^7.8.17",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.0",
    "cache-manager": "^7.2.8",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "joi": "^18.2.1",
    "keyv": "^5.6.0",
    "langchain": "1.4.4",
    "nest-winston": "^1.10.2",
    "nestjs-i18n": "^10.8.4",
    "nodemailer": "^8.0.9",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/request-ip": "^0.0.41",
    "@types/supertest": "^7.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jest": "^29.15.3",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/generated/",
      "\\.spec\\.ts$",
      "\\.e2e-spec\\.ts$"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 30,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    },
    "testEnvironment": "node"
  }
}
