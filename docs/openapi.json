  "info": {
    "title": "Lucent API",
    "description": "Lucent 后端 API 文档",
    "version": "1.0"
  },
  "components": {
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "邮箱地址",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "description": "密码（8-32位，需包含大小写字母和数字）",
            "example": "Passw0rd123",
            "minLength": 8,
            "maxLength": 32
          },
          "code": {
            "type": "string",
            "description": "邮箱验证码",
            "example": "123456"
          },
          "nickname": {
            "type": "string",
            "description": "昵称",
            "example": "小明",
            "maxLength": 20
          }
        },
        "required": ["email", "password", "code"]
      },
      "UserBriefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户 ID"
          },
          "email": {
            "type": "string",
            "description": "邮箱地址",
            "example": "user@example.com"
          },
          "nickname": {
            "type": "object",
            "description": "昵称",
            "example": "小明",
            "nullable": true
          },
          "emailVerified": {
            "type": "boolean",
            "description": "邮箱是否已验证",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "description": "创建时间 (ISO 8601)",
            "example": "2026-01-01T00:00:00.000Z"
          }
        },
        "required": ["id", "email", "nickname", "emailVerified", "createdAt"]
      },
      "TokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "访问令牌"
          },
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌"
          },
          "expiresIn": {
            "type": "number",
            "description": "访问令牌过期时间（秒）",
            "example": 3600
          }
        },
        "required": ["accessToken", "refreshToken", "expiresIn"]
      },
      "RegisterDataDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserBriefDto"
          },
          "tokens": {
            "$ref": "#/components/schemas/TokensDto"
          }
        },
        "required": ["user", "tokens"]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "结果码",
            "example": 0
          },
          "message": {
            "type": "string",
            "description": "提示消息",
            "example": ""
          },
          "data": {
            "$ref": "#/components/schemas/RegisterDataDto"
          }
        },
        "required": ["code", "message", "data"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "邮箱地址",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "description": "密码（与验证码二选一）",
            "example": "Passw0rd123",
            "minLength": 8,
            "maxLength": 32
          },
          "code": {
            "type": "string",
            "description": "邮箱验证码（与密码二选一）",
            "example": "123456",
            "minLength": 6,
            "maxLength": 6
          }
        },
        "required": ["email"]
      },
      "UserFullDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户 ID"
          },
          "email": {
            "type": "string",
            "description": "邮箱地址",
            "example": "user@example.com"
          },
          "nickname": {
            "type": "object",
            "description": "昵称",
            "example": "小明",
            "nullable": true
          },
          "avatar": {
            "type": "object",
            "description": "头像 URL",
            "example": "https://example.com/avatar.png",
            "nullable": true
          },
          "emailVerified": {
            "type": "boolean",
            "description": "邮箱是否已验证",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "description": "创建时间 (ISO 8601)",
            "example": "2026-01-01T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "description": "更新时间 (ISO 8601)",
            "example": "2026-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "email",
          "nickname",
          "avatar",
          "emailVerified",
          "createdAt",
          "updatedAt"
        ]
      },
      "LoginDataDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserFullDto"
          },
          "tokens": {
            "$ref": "#/components/schemas/TokensDto"
          }
        },
        "required": ["user", "tokens"]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "结果码",
            "example": 0
          },
          "message": {
            "type": "string",
            "description": "提示消息",
            "example": ""
          },
          "data": {
            "$ref": "#/components/schemas/LoginDataDto"
          }
        },
        "required": ["code", "message", "data"]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌"
          }
        },
        "required": ["refreshToken"]
      },
      "SuccessResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "结果码",
            "example": 0
          },
          "message": {
            "type": "string",
            "description": "提示消息",
            "example": ""
          },
          "data": {
            "type": "object",
            "description": "数据",
            "nullable": true,
            "example": null
          }
        },
        "required": ["code", "message", "data"]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌"
          }
        },
        "required": ["refreshToken"]
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "结果码",
            "example": 0
          },
          "message": {
            "type": "string",
            "description": "提示消息",
            "example": ""
          },
          "data": {
            "$ref": "#/components/schemas/TokensDto"
          }
        },
        "required": ["code", "message", "data"]
      },
      "SendVerificationCodeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "邮箱地址",
            "example": "user@example.com"
          },
          "scene": {
            "type": "string",
            "description": "验证码场景",
            "enum": ["register", "login", "reset-password", "change-email"],
            "example": "register"
          }
        },
        "required": ["email", "scene"]
      },
      "CooldownMessageDto": {
        "type": "object",
        "properties": {
          "cooldown": {
            "type": "number",
            "description": "冷却时间（秒）",
            "example": 60
          },
          "message": {
            "type": "string",
            "description": "提示消息",
            "example": "验证码已发送"
          }
        },
        "required": ["cooldown", "message"]
      },
      "SendVerificationCodeResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "结果码",
            "example": 0
          },
          "message": {
            "type": "string",
            "description": "提示消息",
            "example": ""
          },
          "data": {
            "$ref": "#/components/schemas/CooldownMessageDto"
          }
        },
        "required": ["code", "message", "data"]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "邮箱地址",
            "example": "user@example.com"
          },
          "code": {
            "type": "string",
            "description": "验证码",
            "example": "123456",
            "minLength": 6,
            "maxLength": 6
          }
        },
        "required": ["email", "code"]
      },
      "VerifyEmailDataDto": {
        "type": "object",
        "properties": {
          "emailVerified": {
            "type": "boolean",
            "description": "邮箱是否已验证",
            "example": true
          }
        },
        "required": ["emailVerified"]
      },
      "VerifyEmailResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "结果码",
            "example": 0
          },
          "message": {
            "type": "string",
            "description": "提示消息",
            "example": ""
          },
          "data": {
            "$ref": "#/components/schemas/VerifyEmailDataDto"
          }
        },
        "required": ["code", "message", "data"]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "邮箱地址",
            "example": "user@example.com"
          }
        },
        "required": ["email"]
      },
      "ForgotPasswordResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "结果码",
            "example": 0
          },
          "message": {
            "type": "string",
            "description": "提示消息",
            "example": ""
          },
          "data": {
            "$ref": "#/components/schemas/CooldownMessageDto"
          }
        },
        "required": ["code", "message", "data"]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "邮箱地址",
            "example": "user@example.com"
          },
          "code": {
            "type": "string",
            "description": "验证码",
            "example": "123456",
            "minLength": 6,
            "maxLength": 6
          },
          "password": {
            "type": "string",
            "description": "新密码（8-32位，需包含大小写字母和数字）",
            "example": "NewPassw0rd",
            "minLength": 8,
            "maxLength": 32
          }
        },
        "required": ["email", "code", "password"]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "结果码",
            "example": 0
          },
          "message": {
            "type": "string",
            "description": "提示消息",
            "example": ""
          },
          "data": {
            "$ref": "#/components/schemas/UserFullDto"
          }
        },
        "required": ["code", "message", "data"]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "description": "昵称",
            "example": "小明",
            "maxLength": 20
          },
          "avatar": {
            "type": "string",
            "description": "头像 URL",
            "example": "https://example.com/avatar.png"
          }
        }
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "oldPassword": {
            "type": "string",
            "description": "当前密码",
            "example": "Passw0rd123"
          },
          "newPassword": {
            "type": "string",
            "description": "新密码（8-32位，需包含大小写字母和数字）",
            "example": "NewPassw0rd",
            "minLength": 8,
            "maxLength": 32
          }
        },
        "required": ["oldPassword", "newPassword"]
      },
      "ChangeEmailDto": {
        "type": "object",
        "properties": {
          "newEmail": {
            "type": "string",
            "description": "新邮箱",
            "example": "newuser@example.com"
          },
          "code": {
            "type": "string",
            "description": "验证码",
            "example": "123456",
            "minLength": 6,
            "maxLength": 6
          }
        },
        "required": ["newEmail", "code"]
      },
      "ChangeEmailDataDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "新邮箱地址",
            "example": "new@example.com"
          },
          "emailVerified": {
            "type": "boolean",
            "description": "邮箱是否已验证",
            "example": true
          }
        },
        "required": ["email", "emailVerified"]
      },
      "ChangeEmailResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "结果码",
            "example": 0
          },
          "message": {
            "type": "string",
            "description": "提示消息",
            "example": ""
          },
          "data": {
            "$ref": "#/components/schemas/ChangeEmailDataDto"
          }
        },
        "required": ["code", "message", "data"]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "当前密码（确认注销）",
            "example": "Passw0rd123"
          }
        },
        "required": ["password"]
      }
    }
  }
}
