  generated
  active
  fading
  expired
  dismissed
}

enum SuggestionConfidence {
  high
  medium
  low
}

enum SuggestionFeedbackType {
  accepted
  later
  not_applicable
  suppress
}

enum BaselineDimension {
  water_intake
  sleep_duration
  caffeine_intake
  symptom_severity
  medication_adherence
  mood
}

