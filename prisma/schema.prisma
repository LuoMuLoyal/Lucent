generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
  deleted
}

enum SexAtBirth {
  female
  male
  intersex
  unknown
}

enum UnitSystem {
  metric
  imperial
}

enum UserSessionDeviceType {
  mobile
  tablet
  desktop
  web
  watch
  server
  other
}

enum UserDevicePlatform {
  ios
  android
  web
  windows
  macos
  linux
  watchos
  other
}

enum UserAllergyKind {
  drug
  food
  environment
  other
}

enum UserAllergySeverity {
  mild
  moderate
  severe
  unknown
}

enum UserConditionStatus {
  active
  resolved
  suspected
}

enum MedicineSource {
  drugbank
  cn
  manual
}

enum DailyRecordKind {
  water
  meal
  vital
  mood
  symptom
  activity
  note
  sleep
}

enum DailyRecordAttachmentKind {
  image
}

enum MealAnalysisStatus {
  analyzing
  unconfirmed
  confirmed
  analysis_failed
}

enum MealAnalysisCoverage {
  none
  partial
  complete
}

enum AssistantConversationStatus {
  active
  archived
}

enum AssistantMessageRole {
  user
  assistant
}

enum AiSummaryHistoryKind {
  today
  report
}

enum UserNotificationType {
ai_today_summary
ai_proactive_suggestion
medicine_missed_dose
password_changed
report_generated
medicine_reminder
system_announcement
oauth_login
identity_linked
}

model User {
  id                     String                      @id @default(uuid())
  email                  String?                     @unique
  passwordHash           String?                     @map("password_hash") // argon2 hashed for local accounts
  nickname               String?
  avatar                 String?
  status                 UserStatus                  @default(active)
  emailVerifiedAt        DateTime?                   @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt            DateTime?                   @map("last_login_at") @db.Timestamptz(3)
  securityPinEnabled       Boolean                     @default(false) @map("security_pin_enabled")
  securityPinHash          String?                     @map("security_pin_hash")
  securityPinChangedAt     DateTime?                   @map("security_pin_changed_at") @db.Timestamptz(3)
  securityElevationVersion Int                         @default(0) @map("security_elevation_version")
  deletedAt                DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile                UserProfile?
  identities             UserIdentity[]
  sessions               UserSession[]
  allergies              UserAllergy[]
  conditions             UserCondition[]
  currentMedicines       UserCurrentMedicine[]
  medicineReminders      UserMedicineReminder[]
  reminderDeliveries     UserReminderDelivery[]
  dailyRecords           UserDailyRecord[]
  dailyRecordAttachments UserDailyRecordAttachment[]
  doseLogs               UserMedicineDoseLog[]
  settings               UserSetting[]
  dataExportRequests     DataExportRequest[]
  assistantConversations AssistantConversation[]
  assistantMessages      AssistantMessage[]
  assistantSummaryHistories AssistantSummaryHistory[]
  notifications          UserNotification[]
  suggestions            UserSuggestion[]
  suggestionBaselines    UserSuggestionBaseline[]
  suggestionFeedbacks    UserSuggestionFeedback[]
  medicineRiskCheckRecords MedicineRiskCheckRecord[]

  // status index removed — no runtime query filters by status; PK serves all lookups
  @@map("users")
}

model UserIdentity {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  provider        String
  providerUserId  String    @map("provider_user_id")
  providerUnionId String?   @map("provider_union_id")
  email           String?
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  rawProfile      Json?     @map("raw_profile") @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([providerUnionId])
  @@index([email])
  @@map("user_identities")
}

model UserProfile {
  userId                String          @id @map("user_id")
  birthDate             DateTime?       @map("birth_date") @db.Date
  sexAtBirth            SexAtBirth?     @map("sex_at_birth")
  heightCm              Int?            @map("height_cm")
  bloodType             String?         @map("blood_type")
  locale                String?
  timezone              String?
  unitSystem            UnitSystem?     @map("unit_system")
  onboardingCompletedAt DateTime?       @map("onboarding_completed_at") @db.Timestamptz(3)
  extras                Json?           @db.JsonB
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id               String                 @id @default(uuid())
  userId           String                 @map("user_id")
  refreshTokenHash String                 @unique @map("refresh_token_hash")
  deviceType       UserSessionDeviceType? @map("device_type")
  deviceName       String?                @map("device_name")
  platform         UserDevicePlatform?
  appVersion       String?                @map("app_version")
  ipAddress        String?                @map("ip_address")
  userAgent        String?                @map("user_agent")
  context          Json?                  @db.JsonB
  lastUsedAt       DateTime?              @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime               @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?              @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserAllergy {
  id         String               @id @default(uuid())
  userId     String               @map("user_id")
  kind       UserAllergyKind
  label      String
  reaction   String?
  severity   UserAllergySeverity? @default(unknown)
  isActive   Boolean              @default(true) @map("is_active")
  note       String?
  extras     Json?                @db.JsonB
  recordedAt DateTime?            @map("recorded_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_allergies")
}

model UserCondition {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  label       String
  status      UserConditionStatus @default(active)
  diagnosedAt DateTime?           @map("diagnosed_at") @db.Date
  resolvedAt  DateTime?           @map("resolved_at") @db.Date
  note        String?
  extras      Json?               @db.JsonB
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_conditions")
}

model UserCurrentMedicine {
  id            String                @id @default(uuid())
  userId        String                @map("user_id")
  source        MedicineSource
  sourceRefId   String?               @map("source_ref_id")
  displayName   String                @map("display_name")
  strengthText  String?               @map("strength_text")
  doseText      String?               @map("dose_text")
  route         String?
  startedAt     DateTime?             @map("started_at") @db.Date
  endedAt       DateTime?             @map("ended_at") @db.Date
  isCurrent     Boolean               @default(true) @map("is_current")
  note          String?
  sourcePayload Json?                 @map("source_payload") @db.JsonB
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  doseLogs      UserMedicineDoseLog[]
  reminders     UserMedicineReminder[]

  // isCurrent index replaced by partial index in migration (WHERE is_current = true)
  @@index([userId, source])
  @@map("user_current_medicines")
}

model UserMedicineReminder {
  id                String               @id @default(uuid())
  userId            String               @map("user_id")
  currentMedicineId String?              @map("current_medicine_id")
  label             String?
  scheduledHour     Int                  @map("scheduled_hour")
  scheduledMinute   Int                  @map("scheduled_minute")
  daysOfWeek        Json?                @map("days_of_week") @db.JsonB
  startDate         DateTime?            @map("start_date") @db.Date
  endDate           DateTime?            @map("end_date") @db.Date
  isActive          Boolean              @default(true) @map("is_active")
  note              String?
  deletedAt         DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentMedicine   UserCurrentMedicine? @relation(fields: [currentMedicineId], references: [id], onDelete: SetNull)
  deliveries        UserReminderDelivery[]
  doseLogs          UserMedicineDoseLog[]

  // isActive index replaced by partial index in migration (WHERE is_active = true AND deleted_at IS NULL)
  @@index([userId, currentMedicineId])
  @@index([userId, deletedAt])
  @@index([userId, startDate, endDate])
  @@map("user_medicine_reminders")
}

model UserReminderDelivery {
  id           String                @id @default(uuid())
  userId       String                @map("user_id")
  reminderId   String?               @map("reminder_id")
  deviceId     String?               @map("device_id")
  channel      String
  status       String
  scheduledFor DateTime              @map("scheduled_for") @db.Timestamptz(3)
  deliveredAt  DateTime?             @map("delivered_at") @db.Timestamptz(3)
  errorMessage String?               @map("error_message")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder     UserMedicineReminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@unique([userId, reminderId, scheduledFor])
  @@index([userId, scheduledFor])
  @@index([userId, reminderId])
  @@index([userId, channel, status])
  @@index([scheduledFor])
  @@map("user_reminder_deliveries")
}

enum DoseLogStatus {
  taken
  skipped
  missed
  planned
}

model UserMedicineDoseLog {
  id                String               @id @default(uuid())
  userId            String               @map("user_id")
  currentMedicineId String?              @map("current_medicine_id")
  reminderId        String?              @map("reminder_id")
  status            DoseLogStatus        @default(planned)
  scheduledFor      DateTime             @map("scheduled_for") @db.Date
  scheduledTime     String?              @map("scheduled_time") @db.VarChar(5)
  takenAt           DateTime?            @map("taken_at") @db.Timestamptz(3)
  doseText          String?
  note              String?
  source            String?              @default("manual")
  deletedAt         DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentMedicine   UserCurrentMedicine? @relation(fields: [currentMedicineId], references: [id], onDelete: SetNull)
  reminder          UserMedicineReminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledFor])
  // userId+currentMedicineId index removed — redundant prefix of (userId, currentMedicineId, scheduledFor, scheduledTime)
  @@index([userId, reminderId, scheduledFor])
  @@index([userId, currentMedicineId, scheduledFor, scheduledTime])
  @@index([userId, deletedAt])
  @@map("user_medicine_dose_logs")
}

model UserDailyRecord {
  id                        String                      @id @default(uuid())
  userId                    String                      @map("user_id")
  kind                      DailyRecordKind
  occurredAt                DateTime                    @map("occurred_at") @db.Date
  occurredTime              String?                     @map("occurred_time") @db.VarChar(5)
  title                     String?
  value                     String?
  unit                      String?
  note                      String?
  payload                   Json?                       @db.JsonB
  source                    String?                     @default("manual")
  mealAnalysisStatus        MealAnalysisStatus?         @map("meal_analysis_status")
  mealAnalysisCoverage      MealAnalysisCoverage?       @map("meal_analysis_coverage")
  mealAnalysisUpdatedAt     DateTime?                   @map("meal_analysis_updated_at") @db.Timestamptz(3)
  mealAnalysisFailureReason String?                     @map("meal_analysis_failure_reason")
  mealSourceRevision        Int                         @default(0) @map("meal_source_revision")
  deletedAt                 DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments               UserDailyRecordAttachment[]

  // userId+occurredAt index removed — redundant prefix of (userId, occurredAt, occurredTime)
  @@index([userId, occurredAt, occurredTime])
  @@index([userId, kind])
  @@index([userId, mealAnalysisStatus])
  @@index([userId, mealAnalysisUpdatedAt])
  @@index([userId, deletedAt])
  @@map("user_daily_records")
}

model UserDailyRecordAttachment {
  id          String                    @id @default(uuid())
  userId      String                    @map("user_id")
  recordId    String                    @map("record_id")
  kind        DailyRecordAttachmentKind @default(image)
  objectKey   String                    @map("object_key")
  bucket      String?
  provider    String?
  fileName    String?                   @map("file_name")
  contentType String?                   @map("content_type")
  sizeBytes   Int?                      @map("size_bytes")
  width       Int?
  height      Int?
  publicUrl   String?                   @map("public_url")
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  record      UserDailyRecord           @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([userId, recordId])
  @@map("user_daily_record_attachments")
}

model DrugSourceImport {
  id               String                 @id @default(uuid())
  sourceKey        String                 @map("source_key")
  sourceName       String                 @map("source_name")
  sourceVersion    String?                @map("source_version")
  sourceFileName   String?                @map("source_file_name")
  sourceFileHash   String?                @map("source_file_hash")
  sourceExportedAt DateTime?              @map("source_exported_at") @db.Timestamptz(3)
  status           String                 @default("completed")
  rawRowCount      Int?                   @map("raw_row_count")
  importedRowCount Int?                   @map("imported_row_count")
  rejectedRowCount Int?                   @map("rejected_row_count")
  rejectionSummary Json?                  @map("rejection_summary") @db.JsonB
  note             String?
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  cnProducts            CnMedicineProduct[]
  cnLeaflets            CnMedicineLeaflet[]
  cnProductLeafletLinks CnMedicineProductLeafletLink[]
  drugbankDrugs         DrugbankDrug[]
  drugbankLinks         DrugbankExternalLink[]
  drugbankTargets       DrugbankTarget[]

  @@index([sourceKey, createdAt])
  @@map("drug_source_imports")
}

model FoodCompositionImport {
  id               String                   @id @default(uuid())
  sourceKey        String                   @map("source_key")
  sourceName       String                   @map("source_name")
  sourceVersion    String?                  @map("source_version")
  sourceFileName   String?                  @map("source_file_name")
  sourceFileHash   String?                  @map("source_file_hash")
  sourceExportedAt DateTime?                @map("source_exported_at") @db.Timestamptz(3)
  status           String                   @default("completed")
  rawRowCount      Int?                     @map("raw_row_count")
  importedRowCount Int?                     @map("imported_row_count")
  rejectedRowCount Int?                     @map("rejected_row_count")
  rejectionSummary Json?                    @map("rejection_summary") @db.JsonB
  note             String?
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  categories       FoodCompositionCategory[]
  items            FoodCompositionItem[]

  @@index([sourceKey, createdAt])
  @@map("food_composition_imports")
}

model FoodCompositionCategory {
  code            String                 @id
  importRunId     String?                @map("import_run_id")
  sourceRowNumber Int?                   @map("source_row_number")
  parentCode      String?                @map("parent_code")
  name            String
  level           Int?
  searchText      String?                @map("search_text")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun       FoodCompositionImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  @@index([parentCode])
  @@index([name])
  @@index([searchText])
  @@map("food_composition_categories")
}

model FoodCompositionItem {
  id                   String                 @id
  importRunId          String?                @map("import_run_id")
  sourceRowNumber      Int?                   @map("source_row_number")
  sourceSerialNumber   Int?                   @map("source_serial_number")
  name                 String
  normalizedName       String                 @map("normalized_name")
  searchText           String?                @map("search_text")
  aliases              Json?                  @db.JsonB
  primaryCategoryCode  String?                @map("primary_category_code")
  secondaryCategoryCode String?               @map("secondary_category_code")
  ediblePortionPercent Float?                 @map("edible_portion_percent")
  waterG               Float?                 @map("water_g")
  energyKcal           Float?                 @map("energy_kcal")
  energyKj             Float?                 @map("energy_kj")
  proteinG             Float?                 @map("protein_g")
  fatG                 Float?                 @map("fat_g")
  carbohydrateG        Float?                 @map("carbohydrate_g")
  fiberG               Float?                 @map("fiber_g")
  cholesterolMg        Float?                 @map("cholesterol_mg")
  calciumMg            Float?                 @map("calcium_mg")
  phosphorusMg         Float?                 @map("phosphorus_mg")
  potassiumMg          Float?                 @map("potassium_mg")
  sodiumMg             Float?                 @map("sodium_mg")
  magnesiumMg          Float?                 @map("magnesium_mg")
  ironMg               Float?                 @map("iron_mg")
  zincMg               Float?                 @map("zinc_mg")
  seleniumMg           Float?                 @map("selenium_mg")
  copperMg             Float?                 @map("copper_mg")
  manganeseMg          Float?                 @map("manganese_mg")
  iodineMg             Float?                 @map("iodine_mg")
  vitaminAMcgRe        Float?                 @map("vitamin_a_mcg_re")
  thiaminMg            Float?                 @map("thiamin_mg")
  riboflavinMg         Float?                 @map("riboflavin_mg")
  vitaminB6Mg          Float?                 @map("vitamin_b6_mg")
  vitaminB12Mg         Float?                 @map("vitamin_b12_mg")
  folateUg             Float?                 @map("folate_ug")
  niacinMg             Float?                 @map("niacin_mg")
  vitaminCMg           Float?                 @map("vitamin_c_mg")
  vitaminEMg           Float?                 @map("vitamin_e_mg")
  caroteneMcg          Float?                 @map("carotene_mcg")
  retinolMcg           Float?                 @map("retinol_mcg")
  alphaVitaminEMg      Float?                 @map("alpha_vitamin_e_mg")
  extras               Json?                  @db.JsonB
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun            FoodCompositionImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  mealDishTemplateIngredients MealDishTemplateIngredient[]

  @@index([name])
  @@index([normalizedName])
  @@index([primaryCategoryCode])
  @@index([secondaryCategoryCode])
  @@index([searchText])
  @@map("food_composition_items")
}

model MealDishTemplate {
  id                 String                       @id @default(uuid())
  normalizedDishName String                       @unique @map("normalized_dish_name")
  displayName        String                       @map("display_name")
  aliases            Json?                        @db.JsonB
  status             String                       @default("active")
  source             String                       @default("seeded")
  searchText         String?                      @map("search_text")
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  ingredients        MealDishTemplateIngredient[]

  @@index([displayName])
  // status index replaced by partial index in migration (WHERE status = 'active')
  @@index([searchText])
  @@map("meal_dish_templates")
}

model MealDishTemplateIngredient {
  id                       String             @id @default(uuid())
  templateId               String             @map("template_id")
  ingredientName           String             @map("ingredient_name")
  normalizedIngredientName String             @map("normalized_ingredient_name")
  foodCompositionItemId    String?            @map("food_composition_item_id")
  defaultRatio             Float?             @map("default_ratio")
  sortOrder                Int                @default(0) @map("sort_order")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  template                 MealDishTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  foodCompositionItem      FoodCompositionItem? @relation(fields: [foodCompositionItemId], references: [id], onDelete: SetNull)

  @@index([templateId, sortOrder])
  @@index([normalizedIngredientName])
  @@index([foodCompositionItemId])
  @@map("meal_dish_template_ingredients")
}

model CnMedicineProduct {
  id                     String            @id @default(uuid())
  importRunId            String?           @map("import_run_id")
  sourceName             String            @map("source_name")
  sourceRowNumber        Int?              @map("source_row_number")
  name                   String
  imageUrl               String?           @map("image_url")
  priceText              String?           @map("price_text")
  packageSpec            String?           @map("package_spec")
  approvalNumber         String?           @map("approval_number")
  manufacturer           String?
  drugType               String?           @map("drug_type")
  mainCategory           String?           @map("main_category")
  subcategory            String?
  sourceUrl              String?           @map("source_url")
  brandName              String?           @map("brand_name")
  ingredients            String?
  properties             String?
  indications            String?
  dosage                 String?
  adverseReactions       String?           @map("adverse_reactions")
  contraindications      String?
  precautions            String?
  pharmacologyToxicology String?           @map("pharmacology_toxicology")
  drugInteractions       String?           @map("drug_interactions")
  pharmacokinetics       String?
  overdose               String?
  storage                String?
  validityPeriod         String?           @map("validity_period")
  barcode                String?
  nationalDrugCode       String?           @map("national_drug_code")
  imageUrlCleaned        String?           @map("image_url_cleaned")
  manufacturerNormalized String?           @map("manufacturer_normalized")
  approvalCodes          Json?             @map("approval_codes") @db.JsonB
  bestMatchType          String?           @map("best_match_type")
  bestMatchScore         Int?              @map("best_match_score")
