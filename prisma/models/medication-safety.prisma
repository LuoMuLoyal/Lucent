// Domain: Medication Safety (Risk Checks, Safety Tips)
// Owning module: medicines (risk check + safety tips)

/// Persisted medicine risk check result per user per check type.
model MedicineRiskCheckRecord {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  checkType   String   @map("check_type") // "static" | "llm"
  result      Json     @db.JsonB // complete check result JSON
  riskScore   Int      @map("risk_score") // 0-100
  riskLevel   String   @map("risk_level") // "safe" | "caution" | "risk" | "danger"
  isStale     Boolean  @default(false) @map("is_stale") // marked true on events, false after new check
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checkType])
  @@index([userId, checkType])
  @@map("medicine_risk_check_records")
}

model MedicineSafetyTip {
  id        String   @id @default(uuid())
  contentZh String   @map("content_zh")
  contentEn String   @map("content_en")
  category  String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // isActive+sortOrder index removed — table is tiny, seq scan sufficient
  @@map("medicine_safety_tips")
}
