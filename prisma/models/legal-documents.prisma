// Domain: Legal Documents
// Owning module: legal-documents

/// Legal / compliance documents served to the Luminous app.
model LegalDocument {
  id        String   @id @default(uuid())
  docType   String   @unique @map("doc_type")
  titleZh   String   @map("title_zh")
  titleEn   String   @map("title_en")
  contentZh String   @map("content_zh")
  contentEn String   @map("content_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // isActive index removed — table is tiny, seq scan sufficient
  @@map("legal_documents")
}
