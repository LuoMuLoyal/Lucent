// Domain: Health Events (Event tracking, Check-ins, Medicine associations)
// Owning module: health-events

enum HealthEventStatus {
  active
  ended
}

enum HealthEventOutcome {
  improved
  unchanged
  worsened
}

enum HealthEventKind {
  symptom
  other
}

model HealthEvent {
  id             String                @id @default(uuid())
  userId         String                @map("user_id")
  title          String
  kind           HealthEventKind     @default(symptom)
  status         HealthEventStatus     @default(active)
  startedAt      DateTime              @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?             @map("ended_at") @db.Timestamptz(3)
  outcome        HealthEventOutcome?
  reasonRecordId String?               @map("reason_record_id")
  deletedAt      DateTime?             @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reasonRecord   UserDailyRecord?      @relation("HealthEventReasonRecord", fields: [reasonRecordId], references: [id], onDelete: SetNull)
  checkIns       HealthEventCheckIn[]
  medicines      HealthEventMedicine[]
  dailyRecords   UserDailyRecord[]     @relation("HealthEventDailyRecords")
  doseLogs       UserMedicineDoseLog[] @relation("HealthEventDoseLogs")

  @@index([userId, status, startedAt])
  @@index([userId, deletedAt])
  @@map("health_events")
}

model HealthEventCheckIn {
  id        String            @id @default(uuid())
  eventId   String            @map("event_id")
  date      DateTime          @db.Date
  outcome   HealthEventOutcome
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  event     HealthEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, date])
  @@map("health_event_check_ins")
}

model HealthEventMedicine {
  id                String              @id @default(uuid())
  eventId           String              @map("event_id")
  currentMedicineId String              @map("current_medicine_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  event             HealthEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  currentMedicine   UserCurrentMedicine @relation(fields: [currentMedicineId], references: [id], onDelete: Cascade)

  @@unique([eventId, currentMedicineId])
  @@map("health_event_medicines")
}
