// Domain: Medicine Knowledge Base (DrugBank, CN Medicine, Leaflets, Chunks, QA)
// Owning module: medicines (adapters)

model DrugSourceImport {
  id               String                 @id @default(uuid())
  sourceKey        String                 @map("source_key")
  sourceName       String                 @map("source_name")
  sourceVersion    String?                @map("source_version")
  sourceFileName   String?                @map("source_file_name")
  sourceFileHash   String?                @map("source_file_hash")
  sourceExportedAt DateTime?              @map("source_exported_at") @db.Timestamptz(3)
  status           String                 @default("completed")
  rawRowCount      Int?                   @map("raw_row_count")
  importedRowCount Int?                   @map("imported_row_count")
  rejectedRowCount Int?                   @map("rejected_row_count")
  rejectionSummary Json?                  @map("rejection_summary") @db.JsonB
  note             String?
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  cnProducts            CnMedicineProduct[]
  cnLeaflets            CnMedicineLeaflet[]
  cnProductLeafletLinks CnMedicineProductLeafletLink[]
  drugbankDrugs         DrugbankDrug[]
  drugbankLinks         DrugbankExternalLink[]
  drugbankTargets       DrugbankTarget[]
  drugbankTargetSeqs    DrugbankTargetSequence[]
  drugbankDrugSeqs      DrugbankDrugSequence[]
  drugbankStructures    DrugbankStructure[]
  drugbankPatents       DrugbankPatent[]
  drugbankProperties    DrugbankProperty[]
  drugbankFingerprints  DrugbankFingerprint[]
  drugbankInteractions  DrugbankDrugInteraction[]
  drugbankProducts      DrugbankProduct[]
  drugbankSynonyms      DrugbankSynonym[]
  drugbankManufacturers DrugbankManufacturer[]
  drugbankPackagers     DrugbankPackager[]
  drugbankDosages       DrugbankDosage[]
  drugbankExternalIds   DrugbankExternalIdentifier[]
  drugbankClassifications DrugbankClassification[]
  drugbankGroups        DrugbankGroup[]

  @@index([sourceKey, createdAt])
  @@map("drug_source_imports")
}

model CnMedicineProduct {
  id                     String            @id @default(uuid())
  importRunId            String?           @map("import_run_id")
  sourceName             String            @map("source_name")
  sourceRowNumber        Int?              @map("source_row_number")
  name                   String
  imageUrl               String?           @map("image_url")
  priceText              String?           @map("price_text")
  packageSpec            String?           @map("package_spec")
  approvalNumber         String?           @map("approval_number")
  manufacturer           String?
  drugType               String?           @map("drug_type")
  mainCategory           String?           @map("main_category")
  subcategory            String?
  sourceUrl              String?           @map("source_url")
  brandName              String?           @map("brand_name")
  overdose               String?
  barcode                String?
  nationalDrugCode       String?           @map("national_drug_code")
  manufacturerClean      String?           @map("manufacturer_clean")
  approvalCodes          Json?             @map("approval_codes") @db.JsonB
  searchText             String?           @map("search_text")
  extras                 Json?             @db.JsonB
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun              DrugSourceImport?             @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  leafletLinks           CnMedicineProductLeafletLink[]

  @@index([name])
  @@index([approvalNumber])
  @@index([manufacturer])
  @@index([manufacturerClean])
  @@index([barcode])
  @@index([nationalDrugCode])
  @@index([searchText])
  @@map("cn_medicine_products")
}

model CnMedicineLeaflet {
  id                     String                        @id @default(uuid())
  importRunId            String?                       @map("import_run_id")
  instructionId          String                        @unique @map("instruction_id")
  sourceRow              Int?                          @map("source_row")
  sourceUrl              String?                       @map("source_url")
  genericName            String?                       @map("generic_name")
  brandName              String?                       @map("brand_name")
  approvalText           String?                       @map("approval_text")
  approvalCodes          Json?                         @map("approval_codes") @db.JsonB
  category               String?
  manufacturer           String?
  manufacturerClean      String?                       @map("manufacturer_clean")
  regulatoryClass        String?                       @map("regulatory_class")
  relatedDiseases        String?                       @map("related_diseases")
  appearance             String?
  ingredients            String?
  indications            String?
  packageSpec            String?                       @map("package_spec")
  adverseReactions       String?                       @map("adverse_reactions")
  dosage                 String?
  contraindications      String?
  precautions            String?
  pregnancyLactation     String?                       @map("pregnancy_lactation")
  pediatricUse           String?                       @map("pediatric_use")
  geriatricUse           String?                       @map("geriatric_use")
  drugInteractions       String?                       @map("drug_interactions")
  pharmacologyToxicology String?                       @map("pharmacology_toxicology")
  pharmacokinetics       String?
  storage                String?
  validityPeriod         String?                       @map("validity_period")
  createdAt              DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun              DrugSourceImport?             @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  productLinks           CnMedicineProductLeafletLink[]
  chunks                 MedicineLeafletChunk[]

  @@index([genericName])
  @@index([manufacturer])
  @@map("cn_medicine_leaflets")
}

model CnMedicineProductLeafletLink {
  id              String            @id @default(uuid())
  importRunId     String?           @map("import_run_id")
  productId       String            @map("product_id")
  leafletId       String            @map("leaflet_id")
  matchType       String?           @map("match_type")
  matchKey        String?           @map("match_key")
  matchScore      Int?              @map("match_score")
  isBestMatch     Boolean?          @map("is_best_match")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun       DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  product         CnMedicineProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  leaflet         CnMedicineLeaflet @relation(fields: [leafletId], references: [id], onDelete: Cascade)

  @@unique([productId, leafletId])
  @@index([leafletId])
  @@map("cn_medicine_product_leaflet_links")
}

model MedicineLeafletChunk {
  id            String            @id @default(uuid())
  sourceKind    String            @map("source_kind")
  leafletId     String            @map("leaflet_id")
  sourceField   String            @map("source_field")
  chunkText     String            @map("chunk_text")
  chunkIndex    Int               @map("chunk_index")
  tokenCount    Int?              @map("token_count")
  sourceVersion String?           @map("source_version")
  sourceHash    String?           @map("source_hash")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  leaflet       CnMedicineLeaflet @relation(fields: [leafletId], references: [id], onDelete: Cascade)

  @@unique([leafletId, sourceField, chunkIndex])
  // leafletId index removed — redundant prefix of unique(leafletId, sourceField, chunkIndex)
  @@index([sourceField])
  @@map("medicine_leaflet_chunks")
}

model MedicalQaChunk {
  id           String   @id @default(uuid())
  qaId         String   @unique @map("qa_id")
  question     String
  answer       String
  safetyLabel  String   @map("safety_label")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([safetyLabel])
  @@map("medical_qa_chunks")
}

model DrugbankDrug {
  drugbankId           String                 @id @map("drugbank_id")
  importRunId          String?                @map("import_run_id")
  secondaryDrugbankIds Json?                  @map("secondary_drugbank_ids") @db.JsonB
  drugType             String?                @map("drug_type")
  sourceCreatedAt      DateTime?              @map("source_created_at") @db.Timestamptz(3)
  sourceUpdatedAt      DateTime?              @map("source_updated_at") @db.Timestamptz(3)
  name                 String
  description          String?
  casNumber            String?                @map("cas_number")
  unii                 String?
  state                String?
  indication           String?
  pharmacodynamics     String?
  mechanismOfAction    String?                @map("mechanism_of_action")
  toxicity             String?
  metabolism           String?
  absorption           String?
  halfLife             String?                @map("half_life")
  proteinBinding       String?                @map("protein_binding")
  routeOfElimination   String?                @map("route_of_elimination")
  volumeOfDistribution String?                @map("volume_of_distribution")
  clearance            String?
  /// International brand names. Kept as JSON: 11% coverage, read as a whole block.
  internationalBrands  Json?                  @map("international_brands") @db.JsonB
  /// MeSH-style therapeutic categories. Kept as JSON: used as display tags only.
  categories           Json?                  @db.JsonB
  /// ATC codes. Kept as JSON: ≤1 per drug, read as a whole block.
  atcCodes             Json?                  @map("atc_codes") @db.JsonB
  foodInteractions     Json?                  @map("food_interactions") @db.JsonB
  externalLinks        Json?                  @map("external_links") @db.JsonB
  /// SMPDB pathways. Kept as JSON because coverage is ~3% of drugs and the only
  /// read pattern is "fetch the whole block for one drug" — see PRODUCT §3.
  pathways             Json?                  @db.JsonB
  /// Stepwise metabolic reaction chains. JSON because the chains are variable
  /// length and their intermediate products are DBMET metabolic entities, not
  /// drugs, so normalising them would require a second entity table.
  reactions            Json?                  @db.JsonB
  /// Pharmacogenomic variant effects (rsID, gene, allele, PubMed). JSON because
  /// only 80 drugs carry this data; it is display-only, never an analysis input.
  snpEffects           Json?                  @map("snp_effects") @db.JsonB
  snpAdverseEffects    Json?                  @map("snp_adverse_effects") @db.JsonB
  searchText           String?                @map("search_text")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun            DrugSourceImport?      @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  externalLinkRows     DrugbankExternalLink[]
  targetRelations      DrugbankDrugTarget[]
  passageChunks        DrugbankPassageChunk[]
  sequences            DrugbankDrugSequence[]
  structure            DrugbankStructure?
  patents              DrugbankPatent[]
  properties           DrugbankProperty[]
  fingerprint          DrugbankFingerprint?
  interactions         DrugbankDrugInteraction[]
  products             DrugbankProduct[]
  synonymRows          DrugbankSynonym[]
  manufacturers        DrugbankManufacturer[]
  packagers            DrugbankPackager[]
  dosageRows           DrugbankDosage[]
  externalIdentifierRows DrugbankExternalIdentifier[]
  classificationRow    DrugbankClassification?
  groupRows            DrugbankGroup[]

  @@index([name])
  @@index([casNumber])
  @@index([unii])
  @@index([searchText])
  @@map("drugbank_drugs")
}

model DrugbankPassageChunk {
  id            String       @id @default(uuid())
  drugbankId    String       @map("drugbank_id")
  sourceField   String       @map("source_field")
  chunkText     String       @map("chunk_text")
  chunkIndex    Int          @map("chunk_index")
  sourceVersion String?      @map("source_version")
  sourceHash    String?      @map("source_hash")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  drug          DrugbankDrug @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId, sourceField, chunkIndex])
  // drugbankId index removed — redundant prefix of unique(drugbankId, sourceField, chunkIndex)
  @@index([sourceField])
  @@map("drugbank_passage_chunks")
}

model DrugbankExternalLink {
  id                 String            @id @default(uuid())
  importRunId        String?           @map("import_run_id")
  drugbankId         String            @map("drugbank_id")
  drugName           String?           @map("drug_name")
  casNumber          String?           @map("cas_number")
  drugType           String?           @map("drug_type")
  keggCompoundId     String?           @map("kegg_compound_id")
  keggDrugId         String?           @map("kegg_drug_id")
  pubchemCompoundId  String?           @map("pubchem_compound_id")
  pubchemSubstanceId String?           @map("pubchem_substance_id")
  chebiId            String?           @map("chebi_id")
  pharmgkbId         String?           @map("pharmgkb_id")
  hetId              String?           @map("het_id")
  uniprotId          String?           @map("uniprot_id")
  uniprotTitle       String?           @map("uniprot_title")
  genbankId          String?           @map("genbank_id")
  dpdId              String?           @map("dpd_id")
  rxlistLink         String?           @map("rxlist_link")
  pdrhealthLink      String?           @map("pdrhealth_link")
  wikipediaId        String?           @map("wikipedia_id")
  drugsComLink       String?           @map("drugs_com_link")
  ndcId              String?           @map("ndc_id")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun          DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug               DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@index([drugbankId])
  @@index([uniprotId])
  @@index([ndcId])
  @@map("drugbank_external_links")
}

model DrugbankTarget {
  id               String               @id @default(uuid())
  importRunId      String?              @map("import_run_id")
  sourceDataset    String               @map("source_dataset")
  sourceTargetId   String               @map("source_target_id")
  name             String
  geneName         String?              @map("gene_name")
  genbankProteinId String?              @map("genbank_protein_id")
  genbankGeneId    String?              @map("genbank_gene_id")
  uniprotId        String?              @map("uniprot_id")
  uniprotTitle     String?              @map("uniprot_title")
  pdbIds           Json?                @map("pdb_ids") @db.JsonB
  geneCardId       String?              @map("gene_card_id")
  genAtlasId       String?              @map("gen_atlas_id")
  hgncId           String?              @map("hgnc_id")
  species          String?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun        DrugSourceImport?    @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drugRelations    DrugbankDrugTarget[]

  @@unique([sourceDataset, sourceTargetId])
  @@index([name])
  @@index([geneName])
  @@index([uniprotId])
  @@map("drugbank_targets")
}

model DrugbankDrugTarget {
  id           String         @id @default(uuid())
  drugbankId   String         @map("drugbank_id")
  targetId     String         @map("target_id")
  relationKind String?        @map("relation_kind")
  actions      Json?          @db.JsonB
  knownAction  String?        @map("known_action")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  drug         DrugbankDrug   @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)
  target       DrugbankTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([drugbankId, targetId, relationKind])
  @@index([targetId])
  @@map("drugbank_drug_targets")
}

/// Target protein / gene sequence, from `protein.fasta` / `gene.fasta`.
///
/// The two source files use an identical header format
/// (`>drugbank_target|<uniprotId> <name> (<DBxxxxx>; ...)`), so `sourceDataset`
/// is what separates them: `protein_fasta` holds amino-acid sequences and
/// `gene_fasta` the coding nucleotide sequence of the same target (~3x longer).
///
/// No relation to `DrugbankTarget`: that table's `uniprotId` is nullable and
/// non-unique, so it cannot back a foreign key. Consumers join on `uniprotId`.
model DrugbankTargetSequence {
  id            String            @id @default(uuid())
  importRunId   String?           @map("import_run_id")
  sourceDataset String            @map("source_dataset")
  uniprotId     String            @map("uniprot_id")
  targetName    String?           @map("target_name")
  /// DrugBank ids listed in the FASTA header for this target; the FASTA is the
  /// only place this mapping appears, so it is kept rather than discarded.
  drugbankIds   Json?             @map("drugbank_ids") @db.JsonB
  sequence      String
  length        Int
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun     DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  @@unique([sourceDataset, uniprotId])
  @@index([uniprotId])
  @@map("drugbank_target_sequences")
}

/// Biotech drug sequence, from `drug sequences.fasta`.
///
/// One drug may own several rows (172 of 335 drugs do; the largest has 11),
/// which is why the chain has to be part of the key. The header's trailing
/// description is stored verbatim instead of being split into name/chain
/// columns: the real vocabulary is open-ended (`sequence`, `heavy chain`,
/// `SUBUNIT_1`, `(FSH)`, ...), so any split would silently mangle values.
model DrugbankDrugSequence {
  id          String            @id @default(uuid())
  importRunId String?           @map("import_run_id")
  drugbankId  String            @map("drugbank_id")
  description String
  sequence    String
  length      Int
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun   DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug        DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId, description])
  @@index([drugbankId])
  @@map("drugbank_drug_sequences")
}

/// Computed structure descriptors, from `structures.sdf`.
///
/// One row per drug: the file holds 14,622 records with 14,622 distinct
/// `DRUGBANK_ID`s, so `drugbank_id` is the natural primary key — no merge
/// strategy is needed.
///
/// Only the fields the XML import does not already supply are kept. The SDF
/// also carries `SYNONYMS` / `PRODUCTS` / `DRUG_GROUPS` /
/// `SECONDARY_ACCESSION_NUMBERS`, but those match what `DrugbankDrug` already
/// holds from the XML, so importing them again would just create a second,
/// competing copy.
///
/// `JCHEM_TRADITIONAL_IUPAC` is deliberately absent: it is systematically
/// wrong upstream (aspirin reads as a dexamethasone salt, metformin and
/// ibuprofen both read as biotin) while every neighbouring field in the same
/// record is correct. Storing a field that reliably names the wrong compound
/// is worse than not storing it.
///
/// The molblock itself (atoms/bonds coordinates) is not stored: the file is
/// 2D only, so there is no conformer data to consume.
model DrugbankStructure {
  drugbankId                             String            @id @map("drugbank_id")
  importRunId                            String?           @map("import_run_id")
  smiles                                 String?
  inchiIdentifier                        String?           @map("inchi_identifier")
  inchiKey                               String?           @map("inchi_key")
  formula                                String?
  molecularWeight                        Float?            @map("molecular_weight")
  exactMass                              Float?            @map("exact_mass")
  jchemIupac                             String?           @map("jchem_iupac")
  alogpsSolubility                       String?           @map("alogps_solubility")
  salts                                  Json?             @db.JsonB
  jchemAtomCount                         Int?              @map("jchem_atom_count")
  jchemFormalCharge                      Int?              @map("jchem_formal_charge")
  jchemGhoseFilter                       Int?              @map("jchem_ghose_filter")
  jchemRuleOfFive                        Int?              @map("jchem_rule_of_five")
  jchemAcceptorCount                     Int?              @map("jchem_acceptor_count")
  jchemDonorCount                        Int?              @map("jchem_donor_count")
  jchemBioavailability                   Int?              @map("jchem_bioavailability")
  jchemMddrLikeRule                      Int?              @map("jchem_mddr_like_rule")
  jchemNumberOfRings                     Int?              @map("jchem_number_of_rings")
  jchemRotatableBondCount                Int?              @map("jchem_rotatable_bond_count")
  jchemVeberRule                         Int?              @map("jchem_veber_rule")
  jchemPhysiologicalCharge               Int?              @map("jchem_physiological_charge")
  jchemNeutralCharge                     Int?              @map("jchem_neutral_charge")
  jchemAveragePolarizability             Float?            @map("jchem_average_polarizability")
  jchemPolarSurfaceArea                  Float?            @map("jchem_polar_surface_area")
  jchemRefractivity                      Float?            @map("jchem_refractivity")
  jchemLogp                              Float?            @map("jchem_logp")
  jchemPka                               Float?            @map("jchem_pka")
  jchemPkaStrongestAcidic                Float?            @map("jchem_pka_strongest_acidic")
  jchemPkaStrongestBasic                 Float?            @map("jchem_pka_strongest_basic")
  jchemAverageNeutralMicrospeciesCharge  Float?            @map("jchem_average_neutral_microspecies_charge")
  alogpsLogp                             Float?            @map("alogps_logp")
  alogpsLogs                             Float?            @map("alogps_logs")
  createdAt                              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                              DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun                              DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug                                   DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@index([inchiKey])
  @@map("drugbank_structures")
}

/// One patent record attached to a drug. Modelled as a table rather than JSON
/// because patent-expiry analysis filters and sorts on `expiresOn`; a JSON
/// column would force a sequential scan plus per-row parsing.
///
/// `expiresOn` is the **patent** expiry as captured by DrugBank, not a
/// freedom-to-operate determination: process patents, data exclusivity and
/// indication patents are not represented here.
model DrugbankPatent {
  id                       String            @id @default(uuid())
  importRunId              String?           @map("import_run_id")
  drugbankId               String            @map("drugbank_id")
  patentNumber             String            @map("patent_number")
  country                  String?
  approvedOn               DateTime?         @map("approved_on") @db.Date
  expiresOn                DateTime?         @map("expires_on") @db.Date
  pediatricExtension       Boolean?          @map("pediatric_extension")
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun                DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug                     DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId, patentNumber, country])
  @@index([expiresOn])
  @@index([drugbankId])
  @@map("drugbank_patents")
}

/// Experimental or computed property of a drug. One row per (kind, source)
/// because the source file reports the same property several times with
/// different values and attributions — collapsing to one column would discard
/// the provenance, which is what makes the value citable.
///
/// `valueText` keeps the verbatim string (`"65 °C"`, `"Soluble"`).
/// `valueNum` is populated only when that string parses cleanly, so numeric
/// comparisons are possible without ever overwriting the original text.
model DrugbankProperty {
  id          String            @id @default(uuid())
  importRunId String?           @map("import_run_id")
  drugbankId  String            @map("drugbank_id")
  kind        String
  valueText   String            @map("value_text")
  valueNum    Float?            @map("value_num")
  unit        String?
  source      String?
  isExperimental Boolean        @default(true) @map("is_experimental")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun   DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug        DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId, kind, source])
  @@index([kind, valueNum])
  @@index([drugbankId])
  @@map("drugbank_properties")
}

/// Binary molecular fingerprint used for similarity search.
///
/// Stored as a hex string of 2048 bits (Morgan, radius 2). Similarity is
/// Tanimoto computed in SQL over the bit strings; no vector index is involved
/// because pgvector's distance operators (cosine/L2/inner product/Hamming) do
/// not express Tanimoto, and the corpus (≈15k molecules) is small enough that a
/// sequential scan is fast.
model DrugbankFingerprint {
  drugbankId  String            @id @map("drugbank_id")
  importRunId String?           @map("import_run_id")
  /// 2048-bit Morgan fingerprint, 512 hex characters.
  fingerprint String
  bitCount    Int               @map("bit_count")
  radius      Int               @default(2)
  nBits       Int               @default(2048) @map("n_bits")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun   DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug        DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@map("drugbank_fingerprints")
}

// ─────────────────────────────────────────────────────────────────────────────
// 从 JsonB 提升为关系表的多值字段
//
// 判断标准沿用「查询方式决定结构，而不是数据形状」：只有当一件事需要
// **反查**（"哪些药和 X 相互作用""哪些商品由 Y 生产""哪些药属于 Z 分类"）
// 或者需要**按内部字段过滤/排序**时，才建表。只是"按药取整块"的保持 JsonB。
//
// 每个 model 的注释都写明该字段的实测规模（19,842 个药样本），
// 数据量太小、不支撑分析能力的字段不建表（见文件末尾的说明）。
// ─────────────────────────────────────────────────────────────────────────────

/// 药物-药物相互作用。**实测 4,631 个药、291 万条**，是 DrugBank 里最大的多值字段。
///
/// 建表的理由不是条数，而是**反查**：`PRODUCT.md` A4 要求"给一组药，列出它们
/// 之间的相互作用对"，这是 `WHERE drugbank_id = ANY($set) AND interacts_with_id = ANY($set)`，
/// JsonB 做不到（每次都要展开整列再过滤）。
///
/// `interactsWithId` 指向对方药物，**不建外键**：DrugBank 的相互作用里会出现
/// 不在本库中的化合物（已撤市、外部数据源引入），硬外键会拒掉这些行。
model DrugbankDrugInteraction {
  id              String            @id @default(uuid())
  importRunId     String?           @map("import_run_id")
  drugbankId      String            @map("drugbank_id")
  /// 对方药物的 DrugBank ID；可能不在 `drugbank_drugs` 里，故无外键。
  interactsWithId String            @map("interacts_with_id")
  /// 对方药物名称原文，用于无法 join 到主表时仍能展示。
  interactsWithName String?         @map("interacts_with_name")
  description     String?
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun       DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug            DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId, interactsWithId])
  @@index([interactsWithId])
  @@map("drugbank_drug_interactions")
}

/// 药品商品/上市信息。**实测 4,465 个药、47 万条**。
///
/// 建表理由：要按 NDC、labeller、上市/退市日期查询（`PRODUCT.md` A10 的
/// 撤市筛查、B1 的仿制药机会都要用到），这些是典型的关系查询。
model DrugbankProduct {
  id                String            @id @default(uuid())
  importRunId       String?           @map("import_run_id")
  drugbankId        String            @map("drugbank_id")
  name              String
  labeller          String?
  ndcId             String?           @map("ndc_id")
  ndcProductCode    String?           @map("ndc_product_code")
  dpdId             String?           @map("dpd_id")
  emaProductCode    String?           @map("ema_product_code")
  emaMaNumber       String?           @map("ema_ma_number")
  dosageForm        String?           @map("dosage_form")
  strength          String?
  route             String?
  fdaApplicationNumber String?        @map("fda_application_number")
  generic           Boolean?
  overTheCounter    Boolean?          @map("over_the_counter")
  approved          Boolean?
  country           String?
  startedMarketingOn DateTime?        @map("started_marketing_on") @db.Date
  endedMarketingOn  DateTime?         @map("ended_marketing_on") @db.Date
  source            String?
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun         DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug              DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@index([drugbankId])
  @@index([name])
  @@index([ndcProductCode])
  @@index([labeller])
  @@index([endedMarketingOn])
  @@map("drugbank_products")
}

/// 药物同义词。**实测 18,160 个药、42,961 条（91.5% 覆盖）**。
///
/// 建表理由：搜索要**按同义词命中**并按语言 / INN 标记区分——原来的
/// `search_text` 拼接列只取前 20 条且命中后无法知道命中的是哪个同义词。
///
/// `language` 与 `coder` 来自源 XML 的属性；`isInn` 在源里没有独立标记，
/// 由 `coder == "inn"` 推导，未见该值时为 null（不臆测）。
model DrugbankSynonym {
  id          String            @id @default(uuid())
  importRunId String?           @map("import_run_id")
  drugbankId  String            @map("drugbank_id")
  synonym     String
  language    String?
  /// 源里的 `coder` 属性（如 `inn`）；空串归一为 null。
  coder       String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun   DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug        DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId, synonym])
  @@index([synonym])
  @@map("drugbank_synonyms")
}

/// 生产商。**实测 829 个药、5,669 条**。按厂商反查（"某厂生产哪些药"）。
model DrugbankManufacturer {
  id          String            @id @default(uuid())
  importRunId String?           @map("import_run_id")
  drugbankId  String            @map("drugbank_id")
  name        String
  generic     Boolean?
  url         String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun   DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug        DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId, name])
  @@index([name])
  @@map("drugbank_manufacturers")
}

/// 分包装商。**实测 1,215 个药、20,355 条**。
model DrugbankPackager {
  id          String            @id @default(uuid())
  importRunId String?           @map("import_run_id")
  drugbankId  String            @map("drugbank_id")
  name        String
  url         String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun   DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug        DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId, name])
  @@index([name])
  @@map("drugbank_packagers")
}

/// 给药剂量/剂型/途径。**实测 5,276 个药、100,085 条**。
///
/// 建表理由：剂型与给药途径要能横向筛选（`PRODUCT.md` A12 的"制剂与给药方案参考"），
/// 而不是只能按药取整块。
model DrugbankDosage {
  id          String            @id @default(uuid())
  importRunId String?           @map("import_run_id")
  drugbankId  String            @map("drugbank_id")
  form        String?
  route       String?
  strength    String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun   DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug        DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId, form, route, strength])
  @@index([form])
  @@index([route])
  @@map("drugbank_dosages")
}

/// 外部数据库标识符（ChEBI、PubChem、KEGG、PharmGKB、TTD、RxCUI...）。
/// **实测 17,309 个药、93,636 条（5.4 条/药）**。
///
/// 建表理由：`PRODUCT.md` A5 要"把本工具接进用户已有工作流"，核心是**按外部 ID
/// 反查本库药物**（用户手上是 ChEBI:15377，要找到对应的药）。JsonB 下这是全表扫描。
model DrugbankExternalIdentifier {
  id          String            @id @default(uuid())
  importRunId String?           @map("import_run_id")
  drugbankId  String            @map("drugbank_id")
  /// 源里的 `resource` 原文，如 `PubChem Compound`、`ChEBI`。
  resource    String
  identifier  String
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun   DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug        DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId, resource, identifier])
  @@index([resource, identifier])
  @@map("drugbank_external_identifiers")
}

/// 化学分类层级（Kingdom → Superclass → Class → Subclass → Direct Parent）。
/// **实测 11,195 个药**。
///
/// 建表理由：`PRODUCT.md` A9 要"按化学结构族浏览并逐层下钻"，
/// 即按某一层级的**名称**筛出全部药物——这是关系查询，不是取整块。
///
/// 每行是该药物的**一条分类路径**（含各级），而不是一个节点：这样
/// `WHERE kingdom = 'Organic Compounds'` 可直接命中，不必解析嵌套。
model DrugbankClassification {
  id            String            @id @default(uuid())
  importRunId   String?           @map("import_run_id")
  drugbankId    String            @map("drugbank_id")
  kingdom       String?
  superclass    String?
  className     String?           @map("class")
  subclass      String?
  directParent  String?           @map("direct_parent")
  description   String?
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun     DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug          DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId])
  @@index([kingdom])
  @@index([superclass])
  @@index([className])
  @@index([subclass])
  @@map("drugbank_classifications")
}

/// 药物状态分组（approved / withdrawn / investigational / vet_approved）。
/// **实测 19,842 个药全覆盖、7,466 条**。
///
/// 建表理由：`PRODUCT.md` A10 的"撤市与状态筛查"本质是
/// `WHERE group = 'withdrawn'` 的横向筛选；0.4 条/药的规模不该由条数决定，
/// 而由**查询方式**决定，这里需要横向筛。
model DrugbankGroup {
  drugbankId String            @map("drugbank_id")
  groupName  String            @map("group_name")
  importRunId String?          @map("import_run_id")
  importRun  DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug       DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@id([drugbankId, groupName])
  @@index([groupName])
  @@map("drugbank_groups")
}

// ─────────────────────────────────────────────────────────────────────────────
// 不建表（保持 JsonB 或直接不入库）的字段及理由
//
// 实测覆盖率太低，或只支持"有则展示"、不支撑任何分析能力。建表会让
// schema 变复杂而查询能力没有增加：
//
//   snp_effects                 0.4%（80 个药）   PRODUCT.md C1：样本太少，任何统计都不成立
//   snp_adverse_drug_reactions  0.2%（45 个药）   同上
//   sequences                   1.7%（335 个药） 本身是独立表 drugbank_drug_sequences
//   carriers                    3.5%（695 个药） 已有 drugbank_drug_targets + relation_kind 承载
//   pathways                    3.3%（652 个药） 按药取整块，不反查
//   reactions                   5.1%（1,014 个药）链式结构，中间产物是 DBMET 代谢物不是药物
//   atc_codes                   0.8 条/药        小集合，随药物整块读取
//   categories                  56% 但只用于打标签   按药取整块，不反查
//   ahfs_codes                  0%              源里全部为空
// ─────────────────────────────────────────────────────────────────────────────
