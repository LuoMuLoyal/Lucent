model DrugbankDrugTarget {
  id           String         @id @default(uuid())
  drugbankId   String         @map("drugbank_id")
  targetId     String         @map("target_id")
  relationKind String?        @map("relation_kind")
  actions      Json?          @db.JsonB
  knownAction  String?        @map("known_action")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  drug         DrugbankDrug   @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)
  target       DrugbankTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([drugbankId, targetId, relationKind])
  @@index([targetId])
  @@map("drugbank_drug_targets")
}

/// Target protein / gene sequence, from `protein.fasta` / `gene.fasta`.
///
/// The two source files use an identical header format
/// (`>drugbank_target|<uniprotId> <name> (<DBxxxxx>; ...)`), so `sourceDataset`
/// is what separates them: `protein_fasta` holds amino-acid sequences and
/// `gene_fasta` the coding nucleotide sequence of the same target (~3x longer).
///
/// No relation to `DrugbankTarget`: that table's `uniprotId` is nullable and
/// non-unique, so it cannot back a foreign key. Consumers join on `uniprotId`.
model DrugbankTargetSequence {
  id            String            @id @default(uuid())
  importRunId   String?           @map("import_run_id")
  sourceDataset String            @map("source_dataset")
  uniprotId     String            @map("uniprot_id")
  targetName    String?           @map("target_name")
  /// DrugBank ids listed in the FASTA header for this target; the FASTA is the
  /// only place this mapping appears, so it is kept rather than discarded.
  drugbankIds   Json?             @map("drugbank_ids") @db.JsonB
  sequence      String
  length        Int
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun     DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  @@unique([sourceDataset, uniprotId])
  @@index([uniprotId])
  @@map("drugbank_target_sequences")
}

/// Biotech drug sequence, from `drug sequences.fasta`.
///
/// One drug may own several rows (172 of 335 drugs do; the largest has 11),
/// which is why the chain has to be part of the key. The header's trailing
/// description is stored verbatim instead of being split into name/chain
/// columns: the real vocabulary is open-ended (`sequence`, `heavy chain`,
/// `SUBUNIT_1`, `(FSH)`, ...), so any split would silently mangle values.
model DrugbankDrugSequence {
  id          String            @id @default(uuid())
  importRunId String?           @map("import_run_id")
  drugbankId  String            @map("drugbank_id")
  description String
  sequence    String
  length      Int
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun   DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug        DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@unique([drugbankId, description])
  @@index([drugbankId])
  @@map("drugbank_drug_sequences")
}

/// Computed structure descriptors, from `structures.sdf`.
///
/// One row per drug: the file holds 14,622 records with 14,622 distinct
/// `DRUGBANK_ID`s, so `drugbank_id` is the natural primary key — no merge
/// strategy is needed.
///
/// Only the fields the XML import does not already supply are kept. The SDF
/// also carries `SYNONYMS` / `PRODUCTS` / `DRUG_GROUPS` /
/// `SECONDARY_ACCESSION_NUMBERS`, but those match what `DrugbankDrug` already
/// holds from the XML, so importing them again would just create a second,
/// competing copy.
///
/// `JCHEM_TRADITIONAL_IUPAC` is deliberately absent: it is systematically
/// wrong upstream (aspirin reads as a dexamethasone salt, metformin and
/// ibuprofen both read as biotin) while every neighbouring field in the same
/// record is correct. Storing a field that reliably names the wrong compound
/// is worse than not storing it.
///
/// The molblock itself (atoms/bonds coordinates) is not stored: the file is
/// 2D only, so there is no conformer data to consume.
model DrugbankStructure {
  drugbankId                             String            @id @map("drugbank_id")
  importRunId                            String?           @map("import_run_id")
  smiles                                 String?
  inchiIdentifier                        String?           @map("inchi_identifier")
  inchiKey                               String?           @map("inchi_key")
  formula                                String?
  molecularWeight                        Float?            @map("molecular_weight")
  exactMass                              Float?            @map("exact_mass")
  jchemIupac                             String?           @map("jchem_iupac")
  alogpsSolubility                       String?           @map("alogps_solubility")
  salts                                  Json?             @db.JsonB
  jchemAtomCount                         Int?              @map("jchem_atom_count")
  jchemFormalCharge                      Int?              @map("jchem_formal_charge")
  jchemGhoseFilter                       Int?              @map("jchem_ghose_filter")
  jchemRuleOfFive                        Int?              @map("jchem_rule_of_five")
  jchemAcceptorCount                     Int?              @map("jchem_acceptor_count")
  jchemDonorCount                        Int?              @map("jchem_donor_count")
  jchemBioavailability                   Int?              @map("jchem_bioavailability")
  jchemMddrLikeRule                      Int?              @map("jchem_mddr_like_rule")
  jchemNumberOfRings                     Int?              @map("jchem_number_of_rings")
  jchemRotatableBondCount                Int?              @map("jchem_rotatable_bond_count")
  jchemVeberRule                         Int?              @map("jchem_veber_rule")
  jchemPhysiologicalCharge               Int?              @map("jchem_physiological_charge")
  jchemNeutralCharge                     Int?              @map("jchem_neutral_charge")
  jchemAveragePolarizability             Float?            @map("jchem_average_polarizability")
  jchemPolarSurfaceArea                  Float?            @map("jchem_polar_surface_area")
  jchemRefractivity                      Float?            @map("jchem_refractivity")
  jchemLogp                              Float?            @map("jchem_logp")
  jchemPka                               Float?            @map("jchem_pka")
  jchemPkaStrongestAcidic                Float?            @map("jchem_pka_strongest_acidic")
  jchemPkaStrongestBasic                 Float?            @map("jchem_pka_strongest_basic")
  jchemAverageNeutralMicrospeciesCharge  Float?            @map("jchem_average_neutral_microspecies_charge")
  alogpsLogp                             Float?            @map("alogps_logp")
  alogpsLogs                             Float?            @map("alogps_logs")
  createdAt                              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                              DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  importRun                              DrugSourceImport? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  drug                                   DrugbankDrug      @relation(fields: [drugbankId], references: [drugbankId], onDelete: Cascade)

  @@index([inchiKey])
  @@map("drugbank_structures")
}
