// Domain: Identity & Access (User, Session, Account)
// Owning modules: auth, user, account
//
// `User` is the aggregate root every other context's user-scoped table points
// at, so it lives here. Its relation lists name models declared in sibling
// files — Prisma merges the whole `prisma/models` folder into one schema, so a
// relation may cross files.

enum UserStatus {
  active
  suspended
  deleted
}

enum UserSessionDeviceType {
  mobile
  tablet
  desktop
  web
  watch
  server
  other
}

enum UserDevicePlatform {
  ios
  android
  web
  windows
  macos
  linux
  watchos
  other
}

model User {
  id                     String                      @id @default(uuid())
  // Nullable: OAuth-only accounts (e.g. WeChat) may have no email at all.
  // `@unique` still holds DB-wide because PostgreSQL treats NULLs as distinct,
  // so any number of email-less accounts can coexist while real addresses stay
  // unique. Callers MUST NOT query `where: { email: someNullableValue }` with a
  // null — that would match an arbitrary email-less user; see
  // `AuthIdentityService.findByEmail` for the null-guarded form.
  email                  String?                     @unique
  isEmailVerified        Boolean                     @default(false) @map("is_email_verified") @db.Boolean
  nickname               String?
  avatar                 String?
  status                 UserStatus                  @default(active)
  emailVerifiedAt        DateTime?                   @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt            DateTime?                   @map("last_login_at") @db.Timestamptz(3)
  deletedAt                DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile                UserProfile?
  adminUser              AdminUser?
  lucentSessions         UserSession[]               @relation("lucentSessions")
  accounts               Account[]
  allergies              UserAllergy[]
  conditions             UserCondition[]
  currentMedicines       UserCurrentMedicine[]
  medicineReminders      UserMedicineReminder[]
  reminderDeliveries     UserReminderDelivery[]
  dailyRecords           UserDailyRecord[]
  dailyRecordAttachments UserDailyRecordAttachment[]
  doseLogs               UserMedicineDoseLog[]
  settings               UserSetting[]
  dataExportRequests     DataExportRequest[]
  assistantConversations AssistantConversation[]
  assistantMessages      AssistantMessage[]
  assistantMemories      AssistantMemory[]
  assistantRegenerations AssistantRegeneration[]
  assistantSummaryHistories AssistantSummaryHistory[]
  notifications          UserNotification[]
  notificationPreference  UserNotificationPreference?
  suggestions            UserSuggestion[]
  suggestionBaselines    UserSuggestionBaseline[]
  suggestionBaselineObservations UserSuggestionBaselineObservation[]
  suggestionFeedbacks    UserSuggestionFeedback[]
  suggestionMaterializations UserSuggestionMaterialization[]
  todayAnalysisMaterializations UserTodayAnalysisMaterialization[]
  medicineRiskCheckRecords MedicineRiskCheckRecord[]
  healthEvents           HealthEvent[]
  clinicSummaryShares    UserClinicSummaryShare[]
  productEvents          UserProductEvent[]
  layouts                Layout[]

  // status index removed — no runtime query filters by status; PK serves all lookups
  @@map("users")
}

model UserSession {
  id               String                 @id @default(uuid())
  userId           String                 @map("user_id")
  refreshTokenHash String                 @unique @map("refresh_token_hash")
  deviceType       UserSessionDeviceType? @map("device_type")
  deviceName       String?                @map("device_name")
  platform         UserDevicePlatform?
  appVersion       String?                @map("app_version")
  ipAddress        String?                @map("ip_address")
  userAgent        String?                @map("user_agent")
  context          Json?                  @db.JsonB
  lastUsedAt       DateTime?              @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime               @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?             @map("revoked_at") @db.Timestamptz(3)
  /// Token family root: every session produced by successive rotations shares
  /// it. Reuse of an already-rotated refresh token is treated as theft and
  /// revokes the whole family (see AuthTokenService.rotateSession).
  familyId         String                 @map("family_id")
  /// When this row's refresh token was rotated away (`null` = still usable).
  /// Rotated rows are kept as tombstones so a replay can be detected; the
  /// existing retention job deletes them once `expiresAt` passes.
  rotatedAt        DateTime?              @map("rotated_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User                   @relation("lucentSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}
