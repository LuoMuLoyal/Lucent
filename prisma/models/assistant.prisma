// Domain: AI Assistant (Conversations, Messages, Memory, Regeneration, Summary History)
// Owning module: assistant

enum AssistantConversationStatus {
  active
  archived
  deleted
}

enum AssistantMessageRole {
  user
  assistant
}

enum AiSummaryHistoryKind {
  today
  report
}

model AssistantConversation {
  id            String                   @id @default(uuid())
  userId        String                   @map("user_id")
  title         String?
  status        AssistantConversationStatus @default(active)
  lastMessageAt DateTime?                @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AssistantMessage[]
  sourceMemories AssistantMemory[]

  // userId+updatedAt index removed — redundant, covered by (userId, status, updatedAt)
  @@index([userId, lastMessageAt])
  @@index([userId, status, updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String            @id @default(uuid())
  conversationId String            @map("conversation_id")
  userId         String            @map("user_id")
  role           AssistantMessageRole
  content        String
  usedTools      Json?             @map("used_tools") @db.JsonB
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("assistant_messages")
}

model AssistantSummaryHistory {
id             String               @id @default(uuid())
userId         String               @map("user_id")
kind           AiSummaryHistoryKind
scopeKey       String               @map("scope_key")
date           DateTime?            @db.Date
rangeKey       String?              @map("range_key")
startDate      DateTime?            @map("start_date") @db.Date
endDate        DateTime?            @map("end_date") @db.Date
generatedAt    DateTime             @map("generated_at") @db.Timestamptz(3)
summary        String
bullets        Json                 @db.JsonB
actionLabel    String               @map("action_label")
action         String               @map("action")
confidenceNote String               @map("confidence_note")
payload        Json?                @db.JsonB
aiGenerated    Boolean              @default(false) @map("ai_generated")
sourceVersion  Int?                 @map("source_version")
createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

@@unique([userId, scopeKey])
@@index([userId, kind, generatedAt])
@@index([userId, date])
@@index([userId, rangeKey, generatedAt])
@@map("assistant_summary_histories")
}

model AssistantMemory {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  sourceConversationId String   @map("source_conversation_id")
  content              String
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConversation  AssistantConversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sourceConversationId])
  @@map("assistant_memories")
}

/// Message→checkpoint mapping for assistant answer regeneration (F-5b).
/// Records which LangGraph checkpoint produced the persisted assistant
/// message, plus an idempotency key (conversationId + sourceMessageId).
model AssistantRegeneration {
  id              String   @id @default(uuid())
  conversationId  String   @map("conversation_id")
  userId          String   @map("user_id")
  sourceMessageId String   @map("source_message_id")
  checkpointId    String   @map("checkpoint_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, sourceMessageId])
  @@index([userId, createdAt])
  @@map("assistant_regenerations")
}
