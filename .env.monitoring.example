################################################################################
#  Lucent — 监控机(阿里云, amd64)
################################################################################
#  用法：cp .env.monitoring.example .env && vim .env
#  本文件入库；.env 不入库。
#
#  **本文件只服务监控机**（compose.monitoring.yaml：victoriametrics / grafana /
#  victorialogs / victoriatraces）。另外两台机器各有自己的模板，不要混用：
#    · 主站(华为云鲲鹏)  → .env.production.example （compose.yaml）
#    · 图库机(腾讯云)    → .env.graph.example     （compose.graph.yaml）
#
#  ⚠️ 本机**不跑 app**，所以不需要 app 的任何业务变量（JWT_* / AI_* / 微信密钥
#     等一概不填）。拆分为三份前，这里要从主站那份 569 行模板里挑出十几行，
#     既容易漏也容易抄错；现在只需下面这一份。
#
#  这些变量由 compose.monitoring.yaml 的 ${VAR} 插值与 Grafana 的环境映射读取。
#  ⚠️ 标了「必填」的没有默认值，缺失会让 compose 直接拒绝启动。
################################################################################


################################################################################
#  01 · 抓取目标(主站的公网地址)
################################################################################

# [必填] 抓取目标(主站鲲鹏)的公网 IP 或域名，**不带协议与端口**。
# compose.monitoring.yaml 用 `:?` 校验它，未设置时拒绝启动 —— 抓取目标为空会让
# VictoriaMetrics 起来但一个指标都抓不到，比起不来更难排查。
# 例：LUCENT_PUBLIC_HOST=203.0.113.10
#
# ⚠️ 与主站 .env 的 PUBLIC_BASE_URL 是**同一事实的两处表达**：改 IP 时必须
#    两边同步改，否则 Grafana 里的链接与抓取目标会指向不同机器。
LUCENT_PUBLIC_HOST=replace_with_huawei_public_ip


################################################################################
#  02 · 主站 /metrics 的 Basic Auth 凭据
################################################################################

# [必填] VictoriaMetrics 抓取主站 /metrics 用的凭据。
# ⚠️ 必须与主站 .env 的 METRICS_USER / METRICS_PASSWORD **一致**，否则抓取 401。
#     vmscraper.yml 经 %{...} 占位符展开这两个值。
METRICS_USER=metrics
METRICS_PASSWORD=replace_with_strong_metrics_password


################################################################################
#  03 · Grafana
################################################################################

# 可选。不设则用 admin。
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password


################################################################################
#  04 · 邮件告警(Grafana 统一告警)
################################################################################
#  抓到的指标不会自己喊。规则/联系点/通知策略都是可入库的 YAML
#  （monitoring/grafana/provisioning/alerting/），**机密只有下面这几项**。
#  compose.monitoring.yaml 把 MAIL_* 映射成 GF_SMTP_* 注入 Grafana。

# [必填] 告警收件地址。contact-points.yml 读 $ALERT_EMAIL_TO 展开
# （Grafana 12 的 alerting provisioning 支持环境变量插值）。
# ⚠️ 留空不报错，只是邮件发不出去 —— 这类静默失败最难查，故 compose 用 `:?` 拦住。
ALERT_EMAIL_TO=replace_with_alert_recipient_email

# 发信账号。本机不发业务邮件，但仍需这几项 —— compose 解析阶段就要有值。
# ⚠️ 与主站 .env 的同名项保持一致（同一发件箱）。
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASS=your_password
MAIL_FROM=noreply@example.com

# 可选。设 false 可只留告警状态、不发邮件（调试期有用）。
# ⚠️ 默认 false 时 Grafana 会**静默丢弃**通知：告警照常触发、状态页照常变红，
#    但一封都不发。所以这里默认 true。
GF_SMTP_ENABLED=true
