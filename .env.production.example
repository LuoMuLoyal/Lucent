################################################################################
#  Lucent — production(主站,华为云鲲鹏)
################################################################################
#  用法：cp .env.production.example .env && vim .env
#  本文件入库；.env 不入库。
#
#  全部变量以活行给出。每个变量上方的注释说明：它是什么、控制什么、
#  什么时候该改。development / test 各有自己完整的一份，不是增量。
#
#  **本文件只服务主站**（compose.yaml：app + postgres + redis + lightrag +
#  node-exporter）。另外两台机器各有自己的模板，不要混用：
#    · 图库机(腾讯云)  → .env.graph.example      （compose.graph.yaml）
#    · 监控机(阿里云)  → .env.monitoring.example （compose.monitoring.yaml）
#  三台机器各跑一份 compose、各读各的 .env（见 docs/reference/deployment.md）。
#  ⚠️ 不要再把三台的变量合到一份里：compose 会对**整个文件**插值，合表会让
#     图库机也必须凑齐主站的口令才能启动（ADR-0024 记录的拆分理由）。
#
#  DATABASE_URL / REDIS_URL 由 compose.yaml 按 POSTGRES_PASSWORD /
#  REDIS_PASSWORD 自动拼接，**以 compose 注入的为准**。
################################################################################


################################################################################
#  01 · 运行时
################################################################################

# 运行环境。
NODE_ENV=production

# HTTP 监听地址。容器内保持 0.0.0.0。
HOST=0.0.0.0

# HTTP 监听端口。
PORT=3000

# 对外基址。拼 OAuth 回调、分享链接、邮件链接时使用。
PUBLIC_BASE_URL=https://your-domain.example

# 浏览器跨域白名单，逗号分隔。纯 App 场景留空即可；有浏览器客户端跨域访问时
# 必须显式列出，不能留空。
CORS_ORIGIN=

# 是否信任反代的 X-Forwarded-* 头。
# ⚠️ 当前拓扑**没有反向代理**（app 直接发布），设 true 会让客户端伪造 XFF
#    绕过按 IP 的限流。接入反代后再改为 true。
TRUST_PROXY=false

################################################################################
#  02 · 数据库与缓存
################################################################################
#  ⚠️ 这两个 URL 由 compose.yaml 按下面的 POSTGRES_PASSWORD / REDIS_PASSWORD
#     自动拼接（容器名寻址），本文件里的值会被覆盖；只有单机全栈、不经 compose
#     直连时才需要自己写实际值。

# Prisma 连接串。
DATABASE_URL=postgresql://lucent:replace_with_strong_postgres_password@127.0.0.1:5432/lucent?schema=public

# Redis 连接串。留空会让缓存/限流/队列退回内存实现。
# ⚠️ 要留空必须删掉整行；写成 `REDIS_URL=` 会因格式校验不通过而启动失败。
REDIS_URL=redis://:replace_with_strong_redis_password@127.0.0.1:6379


################################################################################
#  03 · JWT
################################################################################

# 访问令牌签名密钥。至少 32 字符。生成：openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_strong_access_secret

# 刷新令牌签名密钥。至少 32 字符，且**必须与上面不同** —— 相同会让刷新令牌
# 能当访问令牌用。
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret

# 访问令牌有效期。可读格式：15m / 2h / 7d。
JWT_ACCESS_TTL=15m

# 刷新令牌有效期。必须长于访问令牌。
JWT_REFRESH_TTL=14d

# 令牌签发方与受众。
JWT_ISSUER=lucent-api
JWT_AUDIENCE=luminous-app


################################################################################
#  04 · 管理控制台（/admin）
################################################################################

# 默认开启，镜像内构建产物位于 /app/admin/dist。
# 设为 false 时后端不注册静态路由，须由外部 Web 服务器托管构建产物。
ADMIN_CONSOLE_ENABLED=true

# 构建产物目录覆盖。留空按 /app/admin/dist 解析。
# ADMIN_CONSOLE_DIR=


################################################################################
#  05 · AI 模型
################################################################################
#  仅支持 openai-compatible 接口。
#
#  六个角色各自独立，每个角色三个变量：BASE_URL / API_KEY / MODEL。
#  ⚠️ 要配就连三个一起配 —— 只配一部分会在启动时被拒绝。
#
#  ⚠️⚠️ 服务器无外网时这些地址必须仍然可达，否则 AI 能力**全部失效**。
#     部署前先确认模型 API 是否可达；不可达就需要准备降级演示路径。

# 提供商标识。留空 = 所有 AI 角色都不生效。
AI_PROVIDER=openai-compatible

AI_ANALYSIS_BASE_URL=
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_MODEL=

AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=

AI_LANGUAGE_BASE_URL=
AI_LANGUAGE_API_KEY=
AI_LANGUAGE_MODEL=

AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

AI_CHAT_COMPRESSION_BASE_URL=
AI_CHAT_COMPRESSION_API_KEY=
AI_CHAT_COMPRESSION_MODEL=

AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# 嵌入向量维度。必须与 EMBEDDING 模型一致；改动需要重建全部向量索引。
AI_EMBEDDING_DIMENSION=1536

# 安全策略拦截词。留空使用内置的医疗建议基线。
AI_SAFETY_FORBIDDEN_PATTERNS=

# 思考(推理)开关:语义化,与供应商无关。auto 保留既有探测(DeepSeek 域名 / 阿里云 qwen3),
# 故不设该变量时行为与升级前一致。可选值:auto | enabled | disabled。
# 具体请求形态由代码按 baseUrl 决定:DeepSeek 走 thinking.type,阿里云兼容网关走 enable_thinking。
# 按角色覆盖用 AI_<ROLE>_THINKING(见下),未设则继承 AI_THINKING。
AI_THINKING=auto
AI_ANALYSIS_THINKING=
AI_VISION_THINKING=
AI_LANGUAGE_THINKING=
AI_CHAT_THINKING=
AI_CHAT_COMPRESSION_THINKING=



################################################################################
#  06 · 邮件
################################################################################

# 发送驱动。log = 只把邮件写进日志，**不真的发信**。
# ⚠️ 生产要真发信必须改成 smtp 并填齐 HOST / USER / PASS，
#    否则注册验证码邮件只会进日志，用户收不到。
MAIL_DRIVER=log

# SMTP 服务器地址。driver=smtp 时生效。
MAIL_HOST=smtp.example.com

# SMTP 端口。587 = STARTTLS，465 = SSL。
MAIL_PORT=587

# 发件人地址。
MAIL_FROM=noreply@example.com

# SMTP 登录凭据。driver=smtp 时必填。
MAIL_USER=your_email@example.com
MAIL_PASS=your_password

# 邮件队列单封邮件最多重试次数。
MAIL_QUEUE_MAX_ATTEMPTS=3

# 重试间隔基数（毫秒），按指数退避递增。
MAIL_QUEUE_BACKOFF_DELAY_MS=5000

# 同时处理的邮件任务数。
MAIL_QUEUE_WORKER_CONCURRENCY=3

# 已完成任务保留时长（秒）。86400 = 1 天。
MAIL_QUEUE_COMPLETE_AGE_SECONDS=86400

# 失败任务保留时长（秒）。604800 = 7 天。
MAIL_QUEUE_FAIL_AGE_SECONDS=604800

# 已完成任务最多保留条数。
MAIL_QUEUE_COMPLETE_MAX_COUNT=1000

# 失败任务最多保留条数。
MAIL_QUEUE_FAIL_MAX_COUNT=5000


################################################################################
#  07 · 第三方登录
################################################################################
#  全部可选。未配置时启动打一条 warn，不阻断启动。
#
#  'not-configured' 是刻意约定的哨兵值：代码会把它解析成空串，
#  于是"入口还在但暂不启用"与"真的配错了"能区分开。
#  微信入口当前已隐藏，真实配置待企业资质就绪后填入。

# ── 微信 · 网页扫码 ──
WECHAT_WEB_APP_ID=not-configured
WECHAT_WEB_APP_SECRET=not-configured
WECHAT_WEB_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/wechat-web/callback

# ── 微信 · 移动端 SDK ──
WECHAT_MOBILE_APP_ID=not-configured
WECHAT_MOBILE_APP_SECRET=not-configured

# ── Apple ──
# APPLE_CLIENT_SECRET 是 Apple 侧的 client secret（由私钥签出的 JWT）。
APPLE_APP_ID=
APPLE_CLIENT_SECRET=

# ── QQ ──
QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/qq/callback

# ── Google ──
# ⚠️ GOOGLE_REDIRECT_URI 必须写成合法 URL，留空会因格式校验不通过而启动失败。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/google/callback


################################################################################
#  08 · 对象存储
################################################################################
#  三选一，由 STORAGE_PROVIDER 决定用哪家。
#  ⚠️ 签名 URL 不区分受众：外部模型（如餐饮识图）拿到的 URL 与客户端相同。

# 使用哪家对象存储：s3 | tencent-cos | ali-oss。
STORAGE_PROVIDER=s3

# ── 腾讯云 COS ──
# 三项凭据 + BUCKET 一起设置才算"已配置"；只设其中一项会启动失败。
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_PUBLIC_BASE_URL=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_UPLOAD_EXPIRES_SECONDS=600
TENCENT_COS_MAX_UPLOAD_BYTES=10485760
TENCENT_COS_DOWNLOAD_EXPIRES_SECONDS=600

# ── 阿里云 OSS 专用 SDK（provider=ali-oss 时）──
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-hangzhou
# 覆盖由区域推导出的标准端点（自定义域名 / VPC 内网时使用）。
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PUBLIC_BASE_URL=
ALIYUN_OSS_UPLOAD_EXPIRES_SECONDS=600
ALIYUN_OSS_MAX_UPLOAD_BYTES=10485760
ALIYUN_OSS_DOWNLOAD_EXPIRES_SECONDS=600

# ── S3 兼容（接七牛云 Kodo 等 S3 协议存储时）──
# 服务端访问端点。
STORAGE_S3_ENDPOINT=
# 客户端直传端点。留空则回落到 STORAGE_S3_ENDPOINT。
STORAGE_S3_CLIENT_ENDPOINT=
# 外部受众（识图模型）访问端点。留空时该路径会以明确的配置错误失败。
STORAGE_S3_EXTERNAL_ENDPOINT=
# 公开访问基址（CDN 或 bucket 域名）。
STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=
# 区域标识。七牛 Kodo 用 cn-east-1 / cn-north-1 等。
STORAGE_S3_REGION=us-east-1
STORAGE_S3_UPLOAD_EXPIRES_SECONDS=600
STORAGE_S3_MAX_UPLOAD_BYTES=10485760
STORAGE_S3_DOWNLOAD_EXPIRES_SECONDS=600


################################################################################
#  09 · 极光推送
################################################################################
#  ⚠️ 两个凭据必须成对：都空 = 静默禁用推送（启动打 warn）；
#     只设其中一个则启动失败。

JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
# true = 走 APNs 生产环境。
JPUSH_APNS_PRODUCTION=false
# 极光 API 基址。仅私有化部署时才改。
JPUSH_API_BASE_URL=https://api.jpush.cn


################################################################################
#  10 · LightRAG sidecar（中文说明书检索）
################################################################################
#  ⚠️ sidecar 自身的模型/存储配置**不在本文件** —— 那是独立进程、独立镜像、
#     独立升级周期，读它自己的 deploy/lightrag/.env（模板见该目录）。
#     两边唯一共享的值是 LIGHTRAG_API_KEY，必须完全一致（鉴权握手）。
#
#  生产不需要手填 LIGHTRAG_BASE_URL：compose.yaml 的 lightrag 服务同网络，走容器名
#  `http://lightrag:9621`（即默认值）。启用只需把 LIGHTRAG_ENABLED 改成 true
#  并填同名 LIGHTRAG_API_KEY。

# 总开关。关闭时检索工具返回"未配置"信封，不抛错。
LIGHTRAG_ENABLED=false

# sidecar 地址。容器内走服务名。
LIGHTRAG_BASE_URL=http://lightrag:9621

# sidecar 调用密钥。**启用时必填**（启动期交叉校验）。
LIGHTRAG_API_KEY=

# naive 模式的客户端超时（毫秒）。
LIGHTRAG_TIMEOUT_MS=8000

# 图模式（local/global/hybrid/mix）的独立预算。
# ⚠️ 图模式实测 16–29 秒；沿用 8 秒会把**所有**图模式查询打成超时失败。
LIGHTRAG_GRAPH_TIMEOUT_MS=60000

# 逗号分隔的来源列表，含义是"这些来源的图已经建好了"。
# ⚠️ 这是运维事实而非代码开关：没建图却放行图模式，后果不是报错而是**空结果**。
#     设为空串 = 图模式全禁。
LIGHTRAG_GRAPH_SOURCES=leaflet

# workspace 名。⚠️ 上游限制单实例只支持单 workspace，靠灌入时的 doc id 前缀
#（leaflet: / qa:）区分来源。
LIGHTRAG_WORKSPACE_LEAFLET=leaflet
LIGHTRAG_WORKSPACE_QA=qa


################################################################################
#  11 · Semantica sidecar（英文侧 OAG 本体推理）
################################################################################
#  ⚠️ sidecar 自身在**图库机**（腾讯云），它的 Neo4j 连接与鉴权配置读它自己的
#     deploy/semantica/.env（模板见该目录，随 compose.graph.yaml 部署）。
#     本文件的这几项是**主站 app 作为客户端**的配置。
#
#  ⚠️ 跨机部署（Neo4j 与 sidecar 在图库机、app 在主站）时：
#     把 SEMANTICA_BASE_URL 指向图库机的公网地址，并让安全组**只放行 app 所在
#     机器的出口 IP**。sidecar 自身带 bearer 鉴权，安全组是第二道闸。

# 总开关。关闭时 reason_over_ontology 返回"未配置"信封，不抛错。
SEMANTICA_ENABLED=false

# sidecar 地址。同机走容器名；跨机改成图库机的公网地址。
SEMANTICA_BASE_URL=http://semantica:8099

# 客户端超时（毫秒）。
# ⚠️ 必须大于 sidecar 自己的查询超时（默认 15 秒），否则"查询太慢"会先被
#    客户端掐断，拿不到 sidecar 的结构化超时报错。
SEMANTICA_TIMEOUT_MS=20000

# 与 sidecar 的握手凭据（图库机侧叫 API_TOKEN，两边必须一致）。
# 除 /health 外的每个 sidecar 端点都要求 `Authorization: Bearer <此值>`。
# ⚠️ 仅在 SEMANTICA_ENABLED=true 时强制：只填开关不填它会在启动期直接失败。
# 生成：openssl rand -hex 32
SEMANTICA_API_KEY=replace_with_shared_bearer_token


################################################################################
#  12 · 可观测性
################################################################################
#  ⚠️ 指标/日志/追踪的**接收端**在监控机（阿里云，compose.monitoring.yaml）。
#     本文件的这几项是主站 app 作为**上报方**的配置；跨云地址填监控机公网 IP。

# 日志级别：error | warn | info | debug | verbose。
# 不设置时按环境取默认：development=debug / test=error / production=info。
LOG_LEVEL=info

# 日志格式：pretty（人读）| json（机器采集）。
# 不设置时按环境取默认：development=pretty，其余=json。
LOG_FORMAT=json

# 请求耗时超过该值（毫秒）打一条 warn。
SLOW_REQUEST_THRESHOLD_MS=2000

# 数据库查询耗时超过该值（毫秒）打一条 warn。
SLOW_QUERY_THRESHOLD_MS=500

# 是否采集 Prometheus 指标（/metrics）。
METRICS_ENABLED=true

# /metrics 的 Basic Auth 凭据。
# ⚠️ 两者必须同时设置；缺任一个则 /metrics 匿名可访问（生产不建议）。
# 与监控机 .env.monitoring 的 METRICS_USER / METRICS_PASSWORD **必须一致**
# （VictoriaMetrics 拿这份凭据来抓取）。
METRICS_USER=metrics
METRICS_PASSWORD=replace_with_strong_metrics_password

# 是否启动 OpenTelemetry SDK。开启后日志带上 trace_id / span_id。
# ⚠️ 默认 false。要让 VictoriaTraces 收到 span 必须同时满足三项:本项 =true、
#    OTEL_EXPORTER_OTLP_ENDPOINT 指向它、且那台的 10428 已发布并被安全组放行。
OTEL_ENABLED=false

# OTLP 追踪上报地址。
# ⚠️ VictoriaTraces 的 OTLP/HTTP 路径**不是**标准的 `/v1/traces`,而是:
#      http://<监控机公网IP>:10428/insert/opentelemetry/v1/traces
#    (实测发到 /opentelemetry/v1/traces 返回 400)。默认端口也是 10428,不是 4318。
#    下面保留的 127.0.0.1:4318 是本地 Jaeger all-in-one 的口径,production 指向
#    远端时务必替换成上面那行完整路径。导出失败会被静默丢弃(不影响主流程)。
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# 采样器。由 OTel 标准环境变量控制 —— `src/tracing.ts` 不传 `sampler` 时，
# NodeSDK 会调用 `createSamplerFromEnv()` 读这两项，所以改采样率**不需要动代码**。
#   取值: always_on | always_off | traceidratio |
#         parentbased_always_on | parentbased_always_off | parentbased_traceidratio
# 取值非法时 OTel 只打一行 diag.error 然后**回落默认**（always_on），
# 不抛错也不影响启动 —— 所以配错会静默变成全量采集，务必核对拼写。
OTEL_TRACES_SAMPLER=traceidratio
# 仅当 sampler 为 traceidratio / parentbased_traceidratio 时生效，取值 0~1。
# 生产建议 0.1（10%）：span 是排查用的短期素材，全量采集既涨存储也涨跨云带宽。
OTEL_TRACES_SAMPLER_ARG=0.1

# 关掉 OTLP 指标导出。
# ⚠️ 这是 OTel SDK 的标准变量，`src/tracing.ts` 不读它、由 NodeSDK 自己解析；
#    默认值是 `otlp`，于是 SDK 会拿 OTEL_EXPORTER_OTLP_ENDPOINT 当**基地址**再拼
#    `/v1/metrics` —— 而本项目的端点已经带了非标准路径，拼出来就是
#      /insert/opentelemetry/v1/traces/v1/metrics  → 每分钟一条 unsupported path。
#    应用自身的指标走 prom-client 的 /metrics（由 VictoriaMetrics 抓取），与 OTLP
#    指标无关，所以这里直接关掉，不留噪声。
OTEL_METRICS_EXPORTER=none

# VictoriaLogs 日志投递地址。
# ⚠️ 监控栈在阿里云那台，容器名 `victorialogs` **在主站解析不了** —— 必须填
# 阿里云的公网地址；阿里云安全组放行主站的出口 IP。
#   VICTORIALOGS_URL=http://<监控机公网IP>:9428/insert/jsonline
# 与 VM 的抓取方向相反：日志是**应用推**过去的（写入稀疏），所以这一跳走公网可接受；
# 而 Grafana 查 VM 是密集链路，故两者必须同机。
# 留空则只输出到 stdout。
VICTORIALOGS_URL=


################################################################################
#  13 · 客户端运营
################################################################################

# App"关于"页展示的支持邮箱。必须写成合法邮箱，不能留空。
SUPPORT_EMAIL=support@your-domain.example

# 低于该版本的客户端会被提示更新。留空 = 不做版本门控。
MIN_CLIENT_VERSION=

# 当前最新版本号，客户端据此判断是否需要更新。
LATEST_VERSION=

# App 下载地址。
DOWNLOAD_URL=


################################################################################
#  14 · 验证码 / OAuth state
################################################################################

# 邮箱验证码有效期（毫秒）。
VERIFICATION_CODE_TTL_MS=300000

# 两次发送验证码之间的冷却时间（毫秒）。
VERIFICATION_COOLDOWN_MS=60000

# 验证码发送频率限制的统计窗口（毫秒）。
VERIFICATION_RATE_LIMIT_WINDOW_MS=600000

# 单个窗口内最多发送次数。
VERIFICATION_RATE_LIMIT_MAX=20

# 验证码位数。
VERIFICATION_CODE_LENGTH=6

# OAuth state 有效期（毫秒）。过期后回调会被拒绝。
OAUTH_STATE_TTL_MS=600000


################################################################################
#  15 · 内部 / 构建期
################################################################################

# OpenAPI 导出脚本自己设置，用于跳过数据库连接。
OPENAPI_EXPORT_SKIP_DB_CONNECT=false

# 同上，跳过 Redis 连接。
OPENAPI_EXPORT_SKIP_REDIS=false

# /api/v1/testing/* 的共享密钥。仅在 NODE_ENV=test 时注册这些路由，
# 生产留空即可。
TESTING_SHARED_SECRET=



################################################################################
#  16 · 编排插值（不是 app 的环境变量）
################################################################################
#  下面这些键由 compose.yaml 读取做 ${VAR} 插值，app 进程本身不消费它们。
#  ⚠️ 标了「必填」的没有默认值，缺失会让 compose 直接拒绝启动。
#
#  本文件只列 compose.yaml（主站）需要的那几项。图库机与监控机各自的插值项
#  见 .env.graph.example / .env.monitoring.example。

# ── 数据库与缓存口令 ──
# compose 用它们初始化容器，并拼出 app 的 DATABASE_URL / REDIS_URL。
# ⚠️ 若在 02 节手写了 URL，两处口令必须一致（改密码要改两处）。
# [必填]
POSTGRES_PASSWORD=replace_with_strong_postgres_password
# [必填]
REDIS_PASSWORD=replace_with_strong_redis_password

# ── 镜像引用 ──
# GitHub Actions 以 secret REGISTRY_IMAGE 推送同名仓库。
# 离线部署时指向本地 docker load 进来的 tag —— arm64 镜像带 -arm64 后缀：
#   LUCENT_IMAGE=lucent:arm64
#   LUCENT_DB_IMAGE=lucent-db:18-arm64
# [必填] app 镜像完整引用
LUCENT_IMAGE=your-dockerhub-user/lucent:sha-1a2b3c4d
# [必填] 数据库镜像完整引用（带 pgvector + zhparser）
LUCENT_DB_IMAGE=your-dockerhub-user/lucent-db:18

# ── sidecar 镜像 ──
# 可选。LightRAG 官方镜像；离线部署时改成 load 进来的 tag。
LIGHTRAG_IMAGE=ghcr.io/hkuds/lightrag:latest


################################################################################
#  17 · 运行时配置中心（rnacos）
################################################################################

#  是否启用远程运行时调优。false 时零网络调用，也不会加载原生 SDK。
RNACOS_ENABLED=false

#  rnacos 地址，**写 HTTP 端口**（gRPC 端口由 SDK 按 +1000 推导，
#  例如 127.0.0.1:8848）。RNACOS_ENABLED=true 时必填。
RNACOS_SERVER_ADDR=

#  控制台里的三处坐标。namespace 留空表示用 public。
RNACOS_NAMESPACE=lucent-prod
RNACOS_GROUP=LUCENT_RUNTIME
RNACOS_DATA_ID=lucent-runtime-tuning.txt

#  控制台登录凭据。只交给 SDK，不进内存快照、不进日志。
#  RNACOS_ENABLED=true 时必填。
RNACOS_USERNAME=
RNACOS_PASSWORD=

#  首次拉取配置的超时（毫秒，100-60000）。
RNACOS_REQUEST_TIMEOUT_MS=5000

#  可热更新的键不在这里逐个列出：白名单、取值范围与逐键注释见
#  docs/reference/runtime-config.example.txt（整份粘贴进 rnacos 的配置编辑器）。
#  本文件仍然负责密钥、连接串，以及所有「只在启动时读取」的键。

#  ── 以下三行只给 compose 用，app 不读 ──
#  sidecar 镜像：**钉死版本**，不要 latest/stable。拉不动时改成镜像加速地址。
RNACOS_IMAGE=qingpan/rnacos:v0.8.7

#  控制台账号。口令**不允许留默认值**：留空或缺失时 compose 拒绝启动
#  （`${RNACOS_CONSOLE_PASSWORD:?...}`）。它同时就是 app 的
#  RNACOS_USERNAME / RNACOS_PASSWORD 的来源，两处必须一致。
#  ⚠️ 首次启用前要在控制台建好与 RNACOS_NAMESPACE 同名的空间并发布文档 ——
#  rnacos 不会自动建，缺失时 app 只会读到「配置不存在」而一直用 env 基线。
RNACOS_CONSOLE_USER=rnacos
RNACOS_CONSOLE_PASSWORD=
