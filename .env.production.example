NODE_ENV=production

# ── 服务器 ──
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=https://devluo.com

# ── 数据库 / 缓存 ──
# 默认 docker-compose.yml 会把 Lucent 连接到同机容器内的 postgres / redis。
# 如果你要接外部数据库或 Redis，除了改这个文件，也要同步改 docker-compose.yml。
DATABASE_URL=postgresql://lucent:lucent_dev@postgres:5432/lucent?schema=public
REDIS_URL=redis://redis:6379

# ── JWT ──
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret

# ── AI ──
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=
AI_VISION_MODEL=

# ── 邮件 (prod: smtp) ──
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_FROM=noreply@example.com
MAIL_USER=your_email@example.com
MAIL_PASS=your_password

# ── OAuth / 微信网页登录 ──
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/wechat-web/callback

# ── OAuth / 微信移动端登录 ──
WECHAT_MOBILE_APP_ID=
WECHAT_MOBILE_APP_SECRET=

# ── 日志 ──
LOG_LEVEL=info
