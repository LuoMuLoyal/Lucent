NODE_ENV=production
CORS_ORIGIN=https://devluo.com

# ── 数据库 ──
DATABASE_URL=postgresql://lucent:replace_me@127.0.0.1:5432/lucent?schema=public
REDIS_URL=redis://127.0.0.1:6379

# ── JWT 密钥 (prod) ──
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret

# ── AI ──
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=
AI_VISION_MODEL=

# ── 邮件 (prod: smtp) ──
MAIL_DRIVER=smtp
MAIL_USER=your_email@example.com
MAIL_PASS=your_password

# ── 日志 ──
LOG_LEVEL=info
