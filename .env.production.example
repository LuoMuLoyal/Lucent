NODE_ENV=production

# ── 启动选择器 ──
# TRUST_PROXY=true  # deploy/compose.yml 已在 app environment 中设置

# ── compose 插值变量(在 Coolify Service 环境变量 / 服务器 .env 中配置)──
# DATABASE_URL 和 REDIS_URL 由 deploy/compose.yml 的 environment 块根据
# POSTGRES_PASSWORD 和 REDIS_PASSWORD 自动拼接,不写在此文件中。
POSTGRES_PASSWORD=replace_with_strong_postgres_password
REDIS_PASSWORD=replace_with_strong_redis_password
# app 完整镜像引用:<你的 Docker Hub 用户名>/lucent:<git sha 前 8 位>
# (GitHub Actions 以 secret REGISTRY_IMAGE 推送同名仓库;把占位符换成自己的用户名)
LUCENT_IMAGE=your-dockerhub-user/lucent:1a2b3c4d

# ── JWT（敏感）──
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
# JWT_ISSUER=
# JWT_AUDIENCE=

# ── Better Auth（敏感）──
# BETTER_AUTH_URL=https://api.lucent.example.com
# BETTER_AUTH_SECRET=replace_with_at_least_32_chars_better_auth_secret

# ── 后台管理（敏感）──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password
ADMIN_COOKIE_SECRET=replace_with_at_least_32_chars_admin_cookie_secret

# ── AI (OpenAI-compatible only) ──
AI_PROVIDER=openai-compatible

AI_ANALYSIS_BASE_URL=
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_MODEL=

AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=

AI_LANGUAGE_BASE_URL=
AI_LANGUAGE_API_KEY=
AI_LANGUAGE_MODEL=

AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

AI_CHAT_COMPRESSION_BASE_URL=
AI_CHAT_COMPRESSION_API_KEY=
AI_CHAT_COMPRESSION_MODEL=

AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
# AI_SAFETY_FORBIDDEN_PATTERNS=

# ── 邮件凭据（敏感；driver/host/port/from 已迁移到 config/production.yaml）──
MAIL_USER=your_email@example.com
MAIL_PASS=your_password

# ── OAuth / 微信网页登录（敏感）──
# UI 入口已隐藏（见 Luminous docs/TODO.md）：占位值避免启动告警；
# 真实配置待企业资质就绪后填入。
WECHAT_WEB_APP_ID=not-configured
WECHAT_WEB_APP_SECRET=not-configured
WECHAT_WEB_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/wechat-web/callback

# ── OAuth / 微信移动端登录（敏感）──
WECHAT_MOBILE_APP_ID=not-configured
WECHAT_MOBILE_APP_SECRET=not-configured

# ── OAuth / 微博登录（敏感；UI 入口已隐藏，全链路移除见 docs/TODO.md）──
WEIBO_APP_ID=not-configured
WEIBO_APP_SECRET=not-configured
WEIBO_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/weibo/callback

# ── OAuth / Apple 登录（敏感）──
APPLE_APP_ID=

# ── OAuth / QQ 登录（敏感）──
QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=https://your-domain.example/api/v1/auth/oauth/qq/callback

# ── 腾讯云 COS 凭据（敏感）──
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_PUBLIC_BASE_URL=

# ── 阿里云 OSS 专用 SDK 凭据（敏感;provider=ali-oss 时使用）──
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_REGION=oss-cn-hangzhou   # 默认
# ALIYUN_OSS_ENDPOINT=                # 可选;覆盖 region 标准端点(自定义域名/VPC)
# ALIYUN_OSS_PUBLIC_BASE_URL=

# ── 可观测性 ──
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# VictoriaLogs ingest URL（deploy/compose.yml 已硬编码为
# http://victorialogs:9428/insert/jsonline,不手动覆盖）。

# ── /metrics Basic Auth（与 victoriametrics 抓取一致;未配置时匿名可访问）──
METRICS_USER=metrics
METRICS_PASSWORD=replace_with_strong_metrics_password

# ── Grafana 管理员密码（deploy/compose.yml 使用）──
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password

# ── 极光推送凭据（敏感）──
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
# JPUSH_APNS_PRODUCTION=false  # 默认 false
# JPUSH_API_BASE_URL=https://api.jpush.cn  # 默认

# ── 非敏感运行时配置（未设置时使用代码内默认值）──

# 应用
# HOST=0.0.0.0              # 默认;生产 compose 显式注入
# PORT=3000                 # 默认
# CORS_ORIGIN=              # 默认空 = 不启用 CORS
# PUBLIC_BASE_URL=http://localhost:3000  # 默认;生产填 https://<api域名>

# 日志
# LOG_LEVEL=info            # 默认 debug;生产建议 info
# LOG_FORMAT=json           # 默认 pretty;生产建议 json
# SLOW_REQUEST_THRESHOLD_MS=2000  # 默认 2000
# SLOW_QUERY_THRESHOLD_MS=500     # 默认 500

# 邮件（driver 默认 log;生产走 smtp 时设置下列值）
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_FROM=noreply@example.com
# MAIL_QUEUE_MAX_ATTEMPTS=3
# MAIL_QUEUE_BACKOFF_DELAY_MS=5000
# MAIL_QUEUE_WORKER_CONCURRENCY=3
# MAIL_QUEUE_COMPLETE_AGE_SECONDS=86400
# MAIL_QUEUE_FAIL_AGE_SECONDS=604800
# MAIL_QUEUE_COMPLETE_MAX_COUNT=1000
# MAIL_QUEUE_FAIL_MAX_COUNT=5000

# 对象存储（默认 provider=s3,即 S3 兼容;staging 接七牛 Kodo 填这里）
STORAGE_PROVIDER=s3
# ── 阿里云 OSS 专用 SDK（provider=ali-oss 时）──
# ALIYUN_OSS_REGION=oss-cn-hangzhou        # 默认
# ALIYUN_OSS_ENDPOINT=                     # 可选;覆盖 region 标准端点
# ALIYUN_OSS_UPLOAD_EXPIRES_SECONDS=600
# ALIYUN_OSS_MAX_UPLOAD_BYTES=10485760
# ALIYUN_OSS_DOWNLOAD_EXPIRES_SECONDS=600
# ── 七牛云 Kodo S3 兼容 endpoint（staging）──
# STORAGE_S3_ENDPOINT=https://s3.cn-east-1.qiniucs.com
# STORAGE_S3_CLIENT_ENDPOINT=https://s3.cn-east-1.qiniucs.com
# STORAGE_S3_EXTERNAL_ENDPOINT=https://s3.cn-east-1.qiniucs.com
# STORAGE_S3_PUBLIC_BASE_URL=https://<bucket域名或CDN>
# STORAGE_S3_ACCESS_KEY=七牛AK
# STORAGE_S3_SECRET_KEY=七牛SK
# STORAGE_S3_BUCKET=lucent-staging
# STORAGE_S3_REGION=cn-east-1   # 默认 us-east-1
# STORAGE_S3_UPLOAD_EXPIRES_SECONDS=600
# STORAGE_S3_MAX_UPLOAD_BYTES=10485760
# STORAGE_S3_DOWNLOAD_EXPIRES_SECONDS=600
# ── 腾讯云 COS（provider=tencent-cos 时）──
# TENCENT_COS_REGION=ap-guangzhou
# TENCENT_COS_UPLOAD_EXPIRES_SECONDS=600
# TENCENT_COS_MAX_UPLOAD_BYTES=10485760
# TENCENT_COS_DOWNLOAD_EXPIRES_SECONDS=600

# AI
# AI_EMBEDDING_DIMENSION=1536

# 餐饮分析 / 模糊匹配阈值
# MEAL_DEFAULT_PORTION_GRAMS=100
# MEAL_SMALL_PORTION_GRAMS=30
# MEAL_HIGH_PROTEIN_THRESHOLD_G=20
# MEAL_LOW_CARBOHYDRATE_THRESHOLD_G=20
# MEAL_HIGH_FAT_THRESHOLD_G=20
# FUZZY_ACCEPT_SCORE=0.7
# FUZZY_MIN_LEAD=0.1
# FUZZY_QUERY_PREFIX_LENGTH=1

# 验证码 / OAuth state
# VERIFICATION_CODE_TTL_MS=300000
# VERIFICATION_COOLDOWN_MS=60000
# VERIFICATION_RATE_LIMIT_WINDOW_MS=600000
# VERIFICATION_RATE_LIMIT_MAX=20
# VERIFICATION_CODE_LENGTH=6
# OAUTH_STATE_TTL_MS=600000

# JWT TTL（可读格式:15m/2h/14d）
# JWT_ACCESS_TTL=2h          # 默认 7200s
# JWT_REFRESH_TTL=30d        # 默认 2592000s

# 指标
# METRICS_ENABLED=true
