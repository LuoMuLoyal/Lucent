NODE_ENV=production
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=https://devluo.com

DATABASE_URL=postgresql://lucent:replace_me@127.0.0.1:5432/lucent?schema=public
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=
AI_VISION_MODEL=

LOG_LEVEL=info

# ── 邮件 ──
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASS=your_password
MAIL_FROM=noreply@example.com
