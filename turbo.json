{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalPythonWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "globalDependencies": ["pnpm-workspace.yaml", ".node-version"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "//#verify": {
      "outputs": []
    },
    "semantica-service#check": {
      "command": [
        "uv",
        "run",
        "--frozen",
        "--package",
        "semantica-service",
        "mypy",
        "--config-file",
        "pyproject.toml",
        "src",
        "tests"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:ci": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "format:check": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
