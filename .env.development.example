################################################################################
#  Lucent — development
################################################################################
#  用法：cp .env.development.example .env.development
#  本文件入库；.env.development 不入库。本地覆盖写 .env.development.local（优先）。
#
#  全部变量以活行给出，值即代码内默认值 —— 照抄不会改变任何行为。
#  每个变量上方的注释说明：它是什么、控制什么、什么时候该改。
#  test / production 各有自己完整的一份，不是本文件的增量。
################################################################################


################################################################################
#  01 · 运行时
################################################################################

# 运行环境。决定加载哪个 .env 文件，以及日志/错误响应的形态。
NODE_ENV=development

# HTTP 监听地址。容器内保持 0.0.0.0；只在本机调试时可改 127.0.0.1。
HOST=0.0.0.0

# HTTP 监听端口。
PORT=3000

# 对外基址。拼接 OAuth 回调、分享链接、邮件里的链接时使用。
PUBLIC_BASE_URL=http://localhost:3000

# 浏览器跨域白名单，逗号分隔。留空 = 不启用 CORS（App 直连场景无需设置）。
CORS_ORIGIN=

# 是否信任反代的 X-Forwarded-* 头。
# ⚠️ 设为 true 却没接反代，限流会按反代 IP 计数，等于把所有人算作同一个客户端。
# 本地直连保持 false。
TRUST_PROXY=false

# 是否挂载 AdminJS 管理面板（/admin）。
# 设为 false 时启动阶段完全跳过面板：不加载 adminjs 系依赖、不做 Prisma DMMF
# 自省与 resource 构建，省下一块启动内存；**不影响 04 节三个凭据的必填性**。
ADMIN_ENABLED=true


################################################################################
#  02 · 数据库与缓存
################################################################################

# Prisma 连接串。dev 走 compose.dev.yaml 的 postgres-dev（宿主端口 15432）。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/lucent?schema=public

# Redis 连接串。留空则缓存/限流/队列全部退回内存实现。
# ⚠️ 要留空必须**删掉这一行**，写成 `REDIS_URL=` 会因格式校验不通过而启动失败。
REDIS_URL=redis://127.0.0.1:6379


################################################################################
#  03 · JWT
################################################################################

# 访问令牌签名密钥。至少 32 字符。生成：openssl rand -base64 32
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars

# 刷新令牌签名密钥。至少 32 字符，且**必须与上面不同** —— 相同会让刷新令牌
# 能当访问令牌用。
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars

# 访问令牌有效期。可读格式：15m / 2h / 7d。
JWT_ACCESS_TTL=15m

# 刷新令牌有效期。必须长于访问令牌，否则刷新必然失败。
JWT_REFRESH_TTL=14d

# 令牌签发方与受众。仅在需要与其它服务共用同一密钥体系时才改。
JWT_ISSUER=lucent-api
JWT_AUDIENCE=luminous-app


################################################################################
#  04 · 后台管理面板（/admin）
################################################################################

# 管理员登录账号。同时被 AdminJS 登录与 AdminGuard 的管理员断言复用。
ADMIN_EMAIL=admin@lucent.local

# 管理员登录密码。至少 8 字符。
ADMIN_PASSWORD=admin12345

# 管理面板会话 Cookie 的签名密钥。至少 32 字符。
ADMIN_COOKIE_SECRET=dev_lucent_admin_cookie_secret_32_chars


################################################################################
#  05 · AI 模型
################################################################################
#  仅支持 openai-compatible 接口。
#
#  六个角色各自独立，每个角色三个变量：
#    BASE_URL  接口地址（到 /v1 为止）
#    API_KEY   调用凭据
#    MODEL     模型名
#  ⚠️ 要配就连三个一起配 —— 只配一部分会在启动时被拒绝。
#     整组留空 = 该角色未启用，对应功能走降级路径。
#
#  建议分工：
#    ANALYSIS          今日分析、周报月报等长文本生成
#    VISION            食物图片识别、睡眠截图理解
#    LANGUAGE          自然语言记一笔、口语化结构提取
#    CHAT              轻聊天页主对话
#    CHAT_COMPRESSION  长对话摘要压缩（用便宜模型）
#    EMBEDDING         RAG 向量化与知识库索引
#
#  ⚠️ 指向 https://api.deepseek.com 时会自动关掉 thinking 模式，否则
#     Today/Report 的流式 tool-use 请求会因 tool_choice 失败。

# 提供商标识。设为 openai-compatible；留空则下面所有角色都不生效。
AI_PROVIDER=openai-compatible

AI_ANALYSIS_BASE_URL=
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_MODEL=

AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=

AI_LANGUAGE_BASE_URL=
AI_LANGUAGE_API_KEY=
AI_LANGUAGE_MODEL=

AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

AI_CHAT_COMPRESSION_BASE_URL=
AI_CHAT_COMPRESSION_API_KEY=
AI_CHAT_COMPRESSION_MODEL=

AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# 嵌入向量维度。必须与 EMBEDDING 模型的实际输出一致；
# ⚠️ 改动会使已入库的全部向量失效，需要重建索引。
AI_EMBEDDING_DIMENSION=1536

# 安全策略拦截词。逗号或换行分隔的正则，命中即拦截。
# 留空使用内置的医疗建议基线（诊断/确诊/停药等）。
AI_SAFETY_FORBIDDEN_PATTERNS=


################################################################################
#  06 · 邮件
################################################################################

# 发送驱动。log = 只把邮件写进日志，不真的发信（本地开发用这个）。
# 要真发信改成 smtp，并填齐 HOST / USER / PASS。
MAIL_DRIVER=log

# SMTP 服务器地址。driver=smtp 时生效。
MAIL_HOST=smtp.example.com

# SMTP 端口。587 = STARTTLS，465 = SSL。
MAIL_PORT=587

# 发件人地址。driver=smtp 时生效。
MAIL_FROM=noreply@example.com

# SMTP 登录凭据。driver=smtp 时必填。
MAIL_USER=
MAIL_PASS=

# 邮件队列（BullMQ）单封邮件最多重试次数。
MAIL_QUEUE_MAX_ATTEMPTS=3

# 重试间隔基数（毫秒），按指数退避递增。
MAIL_QUEUE_BACKOFF_DELAY_MS=5000

# 同时处理的邮件任务数。
MAIL_QUEUE_WORKER_CONCURRENCY=3

# 已完成任务保留时长（秒）。86400 = 1 天。
MAIL_QUEUE_COMPLETE_AGE_SECONDS=86400

# 失败任务保留时长（秒）。604800 = 7 天。
MAIL_QUEUE_FAIL_AGE_SECONDS=604800

# 已完成任务最多保留条数。
MAIL_QUEUE_COMPLETE_MAX_COUNT=1000

# 失败任务最多保留条数。
MAIL_QUEUE_FAIL_MAX_COUNT=5000


################################################################################
#  07 · 第三方登录
################################################################################
#  全部可选。未配置时启动打一条 warn，不阻断启动。
#
#  'not-configured' 是刻意约定的哨兵值：代码会把它解析成空串，
#  于是"入口还在但暂不启用"与"真的配错了"能区分开。

# ── 微信 · 网页扫码 ──
WECHAT_WEB_APP_ID=not-configured
WECHAT_WEB_APP_SECRET=not-configured
WECHAT_WEB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/wechat-web/callback

# ── 微信 · 移动端 SDK ──
WECHAT_MOBILE_APP_ID=not-configured
WECHAT_MOBILE_APP_SECRET=not-configured

# ── Apple ──
# APPLE_CLIENT_SECRET 是 Apple 侧的 client secret（由私钥签出的 JWT）。
APPLE_APP_ID=
APPLE_CLIENT_SECRET=

# ── QQ ──
QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/qq/callback

# ── Google ──
# ⚠️ GOOGLE_REDIRECT_URI 必须写成合法 URL，留空会因格式校验不通过而启动失败。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback


################################################################################
#  08 · 对象存储
################################################################################
#  三选一，由 STORAGE_PROVIDER 决定用哪家。
#  ⚠️ 签名 URL 不区分受众：外部模型（如餐饮识图）拿到的 URL 与客户端相同。
#
#  dev 默认走 compose.dev.yaml 的 SeaweedFS（S3 兼容）。启用它把下面几行填成：
#    STORAGE_S3_ENDPOINT=http://127.0.0.1:8333
#    STORAGE_S3_CLIENT_ENDPOINT=http://127.0.0.1:8333
#    STORAGE_S3_ACCESS_KEY=<compose.dev.yaml 里的凭据>
#    STORAGE_S3_SECRET_KEY=<compose.dev.yaml 里的凭据>
#    STORAGE_S3_BUCKET=lucent-dev

# 使用哪家对象存储：s3 | tencent-cos | ali-oss。
STORAGE_PROVIDER=s3

# ── S3 兼容 ──
# 服务端访问端点（应用在容器内看到的地址）。
STORAGE_S3_ENDPOINT=
# 客户端直传端点。留空则回落到 STORAGE_S3_ENDPOINT。
STORAGE_S3_CLIENT_ENDPOINT=
# 外部受众（识图模型）访问端点。留空时该路径会以明确的配置错误失败。
STORAGE_S3_EXTERNAL_ENDPOINT=
# 公开访问基址（CDN 或 bucket 域名）。
STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=
# 区域标识。dev 的 SeaweedFS 用 us-east-1；七牛 Kodo 用 cn-east-1 等。
STORAGE_S3_REGION=us-east-1
# 上传签名 URL 有效期（秒）。
STORAGE_S3_UPLOAD_EXPIRES_SECONDS=600
# 单次上传大小上限（字节）。10485760 = 10 MiB。
STORAGE_S3_MAX_UPLOAD_BYTES=10485760
# 下载签名 URL 有效期（秒）。
STORAGE_S3_DOWNLOAD_EXPIRES_SECONDS=600

# ── 腾讯云 COS ──
# 三项凭据 + BUCKET 一起设置才算"已配置"；只设其中一项会启动失败。
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_PUBLIC_BASE_URL=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_UPLOAD_EXPIRES_SECONDS=600
TENCENT_COS_MAX_UPLOAD_BYTES=10485760
TENCENT_COS_DOWNLOAD_EXPIRES_SECONDS=600

# ── 阿里云 OSS 专用 SDK（provider=ali-oss 时）──
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
# 区域。决定默认端点。
ALIYUN_OSS_REGION=oss-cn-hangzhou
# 覆盖由区域推导出的标准端点（自定义域名 / VPC 内网时使用）。
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PUBLIC_BASE_URL=
ALIYUN_OSS_UPLOAD_EXPIRES_SECONDS=600
ALIYUN_OSS_MAX_UPLOAD_BYTES=10485760
ALIYUN_OSS_DOWNLOAD_EXPIRES_SECONDS=600


################################################################################
#  09 · 极光推送
################################################################################
#  ⚠️ 两个凭据必须成对：都空 = 静默禁用推送（生产会打 warn）；
#     只设其中一个则启动失败。

JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
# true = 走 APNs 生产环境。真机调试与正式发布要区分。
JPUSH_APNS_PRODUCTION=false
# 极光 API 基址。仅私有化部署时才改。
JPUSH_API_BASE_URL=https://api.jpush.cn


################################################################################
#  10 · LightRAG sidecar（中文说明书检索）
################################################################################
#  ⚠️ sidecar 自身的模型/存储配置**不在本文件** —— 那是独立进程、独立镜像、
#     独立升级周期，读它自己的 deploy/lightrag/.env（模板见该目录）。
#     两边唯一共享的值是 LIGHTRAG_API_KEY，必须完全一致（鉴权握手）。
#
#  启用步骤：
#    1) cp deploy/lightrag/.env.example deploy/lightrag/.env 并填入模型 key
#    2) docker compose -f compose.dev.yaml --profile lightrag up -d lightrag
#    3) 把下面 LIGHTRAG_ENABLED 改成 true，并填同名 LIGHTRAG_API_KEY

# 总开关。关闭时检索工具返回"未配置"信封，不抛错。
LIGHTRAG_ENABLED=false

# sidecar 地址。dev 走 compose profile 发布的回环端口。
LIGHTRAG_BASE_URL=http://127.0.0.1:9621

# sidecar 调用密钥。**启用时必填**（启动期交叉校验），且必须与
# deploy/lightrag/.env 里的同名项完全一致。
LIGHTRAG_API_KEY=

# naive 模式的客户端超时（毫秒）。
LIGHTRAG_TIMEOUT_MS=8000

# 图模式（local/global/hybrid/mix）的独立预算。
# ⚠️ 图模式每次查询要现调 LLM 抽取关键词再遍历图，实测 16–29 秒；
#     沿用 8 秒会把**所有**图模式查询打成超时失败。
LIGHTRAG_GRAPH_TIMEOUT_MS=60000

# 逗号分隔的来源列表，含义是"这些来源的图已经建好了"。
# ⚠️ 这是运维事实而非代码开关：没建图却放行图模式，后果不是报错而是**空结果**。
#     设为空串 = 图模式全禁。
LIGHTRAG_GRAPH_SOURCES=leaflet

# workspace 名。⚠️ 上游限制单实例只支持单 workspace，这两个值目前不改变
# 实际读写位置，靠灌入时的 doc id 前缀（leaflet: / qa:）区分来源。
LIGHTRAG_WORKSPACE_LEAFLET=leaflet
LIGHTRAG_WORKSPACE_QA=qa


################################################################################
#  11 · Semantica sidecar（英文侧 OAG 本体推理）
################################################################################
#  ⚠️ sidecar 自身的 Neo4j 连接/连接池/查询超时**不在本文件** ——
#     读它自己的 deploy/semantica/.env（模板见该目录）。
#
#  不起容器也能跑：
#    cd semantica-service && uv run uvicorn semantica_service.main:app --port 8099

# 总开关。关闭时 reason_over_ontology 返回"未配置"信封，不抛错。
SEMANTICA_ENABLED=false

# sidecar 地址。本机直跑时走回环；容器内走服务名 http://semantica:8099。
SEMANTICA_BASE_URL=http://127.0.0.1:8099

# 客户端超时（毫秒）。
# ⚠️ 必须大于 sidecar 自己的查询超时（默认 15 秒），否则"查询太慢"会先被
#    客户端掐断，拿不到 sidecar 的结构化超时报错。
SEMANTICA_TIMEOUT_MS=20000


################################################################################
#  12 · 可观测性
################################################################################

# 日志级别：error | warn | info | debug | verbose。
# 不设置时按环境取默认：development=debug / test=error / production=info。
LOG_LEVEL=debug

# 日志格式：pretty（人读）| json（机器采集）。
# 不设置时按环境取默认：development=pretty，其余=json。
LOG_FORMAT=pretty

# 请求耗时超过该值（毫秒）打一条 warn。
SLOW_REQUEST_THRESHOLD_MS=2000

# 数据库查询耗时超过该值（毫秒）打一条 warn。
SLOW_QUERY_THRESHOLD_MS=500

# 是否采集 Prometheus 指标（/metrics）。
METRICS_ENABLED=true

# /metrics 的 Basic Auth 凭据。
# ⚠️ 两者必须同时设置；缺任一个则 /metrics 匿名可访问。
METRICS_USER=
METRICS_PASSWORD=

# 是否启动 OpenTelemetry SDK。开启后日志带上 trace_id / span_id。
OTEL_ENABLED=false

# OTLP 追踪上报地址。dev 指向 compose.dev.yaml 的 Jaeger。
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# VictoriaLogs 日志投递地址。留空则只输出到 stdout。
VICTORIALOGS_URL=


################################################################################
#  13 · 客户端运营
################################################################################

# App"关于"页展示的支持邮箱。留空回落到内置的支持链接。
# ⚠️ 必须写成合法邮箱，写成空值会因格式校验不通过而启动失败。
SUPPORT_EMAIL=support@example.com

# 低于该版本的客户端会被提示更新。留空 = 不做版本门控。
MIN_CLIENT_VERSION=

# 当前最新版本号，客户端据此判断是否需要更新。
LATEST_VERSION=

# App 下载地址。
DOWNLOAD_URL=


################################################################################
#  14 · 验证码 / OAuth state
################################################################################

# 邮箱验证码有效期（毫秒）。
VERIFICATION_CODE_TTL_MS=300000

# 两次发送验证码之间的冷却时间（毫秒）。
VERIFICATION_COOLDOWN_MS=60000

# 验证码发送频率限制的统计窗口（毫秒）。
VERIFICATION_RATE_LIMIT_WINDOW_MS=600000

# 单个窗口内最多发送次数。
VERIFICATION_RATE_LIMIT_MAX=20

# 验证码位数。
VERIFICATION_CODE_LENGTH=6

# OAuth state 有效期（毫秒）。过期后回调会被拒绝。
OAUTH_STATE_TTL_MS=600000


################################################################################
#  15 · 内部 / 构建期
################################################################################

# OpenAPI 导出脚本自己设置，用于跳过数据库连接。运行时无需改动。
OPENAPI_EXPORT_SKIP_DB_CONNECT=false

# 同上，跳过 Redis 连接。
OPENAPI_EXPORT_SKIP_REDIS=false

# /api/v1/testing/* 的共享密钥（请求头 x-testing-shared-secret）。
# 仅在 NODE_ENV=test 时注册这些路由。
TESTING_SHARED_SECRET=

# Scalar API 文档的自托管版本 slug。留空则从 package.json 读取。
SCALAR_API_REFERENCE_VERSION=
