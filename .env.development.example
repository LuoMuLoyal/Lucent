NODE_ENV=development

# ── 启动选择器（Nest/OTel/Prisma 启动前读取，不能放 YAML）──
# TRUST_PROXY=true

# ── 数据库 / Redis（敏感）──
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/lucent?schema=public
REDIS_URL=redis://127.0.0.1:6379

# ── JWT（敏感）──
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars
# JWT_ISSUER=
# JWT_AUDIENCE=

# ── Better Auth（敏感）──
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev_better_auth_secret_change_me_min_32
# BETTER_AUTH_EMAIL_CALLBACK_URL=luminous://auth/callback

# ── 后台管理（敏感）──
ADMIN_EMAIL=admin@lucent.local
ADMIN_PASSWORD=admin12345
ADMIN_COOKIE_SECRET=dev_lucent_admin_cookie_secret_32_chars

# ── AI (OpenAI-compatible only) ──
AI_PROVIDER=openai-compatible

AI_ANALYSIS_BASE_URL=
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_MODEL=

AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=

AI_LANGUAGE_BASE_URL=
AI_LANGUAGE_API_KEY=
AI_LANGUAGE_MODEL=

AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

AI_CHAT_COMPRESSION_BASE_URL=
AI_CHAT_COMPRESSION_API_KEY=
AI_CHAT_COMPRESSION_MODEL=

AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
# AI_SAFETY_FORBIDDEN_PATTERNS=

# ── 邮件凭据（敏感；driver/host/port/from 已迁移到 config/default.yaml）──
MAIL_USER=
MAIL_PASS=

# ── OAuth / 微信网页登录（敏感）──
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/wechat-web/callback

# ── OAuth / 微信移动端登录（敏感）──
WECHAT_MOBILE_APP_ID=
WECHAT_MOBILE_APP_SECRET=

# ── OAuth / Apple 登录（敏感）──
APPLE_APP_ID=

# ── OAuth / QQ 登录（敏感）──
QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=

# ── 腾讯云 COS 凭据（敏感；region/expiry 已迁移到 config/default.yaml）──
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_PUBLIC_BASE_URL=

# ── S3 兼容存储凭据（敏感；endpoint/region/expiry 已迁移到 config/default.yaml）──
# STORAGE_PROVIDER=s3
# STORAGE_S3_ACCESS_KEY=lucent-dev
# STORAGE_S3_SECRET_KEY=lucent-dev-secret
# STORAGE_S3_BUCKET=lucent-dev

# ── OpenAPI 导出（可选）──
# OPENAPI_EXPORT_SKIP_DB_CONNECT=false

# ── 可观测性 ──
# OTEL_ENABLED=false

# ── /metrics Basic Auth（敏感）──
# METRICS_USER=metrics
# METRICS_PASSWORD=metrics_password

# ── 测试支持（仅 NODE_ENV=test 生效）──
# TESTING_SHARED_SECRET=test-shared-secret-change-me

# ── 客户端运营配置（可选，后续迁移到 YAML）──
# SUPPORT_EMAIL=luomuloyal@qq.com
# MIN_CLIENT_VERSION=0.1.0
# LATEST_VERSION=0.1.0
# DOWNLOAD_URL=https://github.com/LuoMuLoyal/Luminous

# ── 极光推送凭据（敏感；apnsProduction/apiBaseUrl 已迁移到 config/default.yaml）──
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# ── 非敏感运行时配置请见 config/default.yaml 和 config/development.yaml ──
