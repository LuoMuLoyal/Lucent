NODE_ENV=development

# ── 服务器 ──
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=*

# ── 数据库 ──
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/lucent?schema=public
REDIS_URL=redis://127.0.0.1:6379

# ── JWT ──
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# ── AI ──
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=
AI_VISION_MODEL=

# ── 邮件 (dev: console) ──
MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_FROM=noreply@example.com
MAIL_USER=
MAIL_PASS=

# ── OAuth / 微信网页登录 ──
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost:5173/oauth/wechat/callback

# ── 日志 ──
LOG_LEVEL=debug
