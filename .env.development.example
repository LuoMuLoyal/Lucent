NODE_ENV=development

# ── 公开基础 URL（用于生成诊所摘要分享链接等） ──
PUBLIC_BASE_URL=http://localhost:3000

# ── 服务器 ──
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
# TRUST_PROXY=true

# ── 数据库 ──
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/lucent?schema=public
REDIS_URL=redis://127.0.0.1:6379

# ── JWT ──
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars
# JWT_ISSUER=
# JWT_AUDIENCE=

# ── 后台管理 ──
ADMIN_EMAIL=admin@lucent.local
ADMIN_PASSWORD=admin12345
ADMIN_COOKIE_SECRET=dev_lucent_admin_cookie_secret_32_chars

# ── AI (OpenAI-compatible only) ──
AI_PROVIDER=openai-compatible

AI_ANALYSIS_BASE_URL=
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_MODEL=

AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=

AI_LANGUAGE_BASE_URL=
AI_LANGUAGE_API_KEY=
AI_LANGUAGE_MODEL=

AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

AI_CHAT_COMPRESSION_BASE_URL=
AI_CHAT_COMPRESSION_API_KEY=
AI_CHAT_COMPRESSION_MODEL=

AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
# AI_EMBEDDING_DIMENSION=1536
# AI_SAFETY_FORBIDDEN_PATTERNS=

# ── 邮件 (dev: console) ──
MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_FROM=noreply@example.com
MAIL_USER=
MAIL_PASS=

# ── 邮件队列调优（可选，均有默认值） ──
# MAIL_QUEUE_MAX_ATTEMPTS=3
# MAIL_QUEUE_BACKOFF_DELAY_MS=5000
# MAIL_QUEUE_WORKER_CONCURRENCY=3
# MAIL_QUEUE_COMPLETE_AGE_SECONDS=86400
# MAIL_QUEUE_FAIL_AGE_SECONDS=604800
# MAIL_QUEUE_COMPLETE_MAX_COUNT=1000
# MAIL_QUEUE_FAIL_MAX_COUNT=5000

# ── OAuth / 微信网页登录 ──
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/wechat-web/callback

# ── OAuth / 微信移动端登录 ──
WECHAT_MOBILE_APP_ID=
WECHAT_MOBILE_APP_SECRET=

# ── OAuth / Apple 登录 ──
APPLE_APP_ID=

# ── OAuth / QQ 登录 ──
QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=

# ── 食材模糊匹配阈值（可选，均有默认值） ──
# FUZZY_ACCEPT_SCORE=0.7
# FUZZY_MIN_LEAD=0.1
# FUZZY_QUERY_PREFIX_LENGTH=1

# ── 餐食分析参数（可选，均有默认值） ──
# MEAL_DEFAULT_PORTION_GRAMS=100
# MEAL_SMALL_PORTION_GRAMS=30
# MEAL_HIGH_PROTEIN_THRESHOLD_G=20
# MEAL_LOW_CARBOHYDRATE_THRESHOLD_G=20
# MEAL_HIGH_FAT_THRESHOLD_G=20

# ── 验证码服务参数（可选，均有默认值） ──
# VERIFICATION_CODE_TTL_MS=300000
# VERIFICATION_COOLDOWN_MS=60000
# VERIFICATION_RATE_LIMIT_WINDOW_MS=600000
# VERIFICATION_RATE_LIMIT_MAX=20
# VERIFICATION_CODE_LENGTH=6

# ── OAuth State 有效期（可选，默认 10 分钟） ──
# OAUTH_STATE_TTL_MS=600000

# ── 腾讯云 COS / 日常记录图片上传 ──
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_PUBLIC_BASE_URL=
TENCENT_COS_UPLOAD_EXPIRES_SECONDS=600
TENCENT_COS_MAX_UPLOAD_BYTES=10485760
TENCENT_COS_DOWNLOAD_EXPIRES_SECONDS=600

# ── 对象存储 provider 选择 ──
# tencent-cos（默认，生产/test） | s3（开发，使用本地 SeaweedFS）
# STORAGE_PROVIDER=tencent-cos

# ── S3 兼容对象存储（开发：SeaweedFS） ──
# 桌面调试时 client endpoint 与 internal endpoint 相同；
# Android 模拟器将 client/public endpoint 改为 10.0.2.2。
# 不要将本机凭据或隧道 URL 提交到版本库。
# STORAGE_PROVIDER=s3
# STORAGE_S3_ENDPOINT=http://127.0.0.1:8333
# STORAGE_S3_CLIENT_ENDPOINT=http://127.0.0.1:8333
# Android 模拟器示例：
# STORAGE_S3_CLIENT_ENDPOINT=http://10.0.2.2:8333
# STORAGE_S3_EXTERNAL_ENDPOINT=  # 远程视觉模型需要 HTTPS 公网端点
# STORAGE_S3_PUBLIC_BASE_URL=http://10.0.2.2:8888/buckets/lucent-dev
# STORAGE_S3_ACCESS_KEY=lucent-dev
# STORAGE_S3_SECRET_KEY=lucent-dev-secret
# STORAGE_S3_BUCKET=lucent-dev
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_UPLOAD_EXPIRES_SECONDS=600
# STORAGE_S3_MAX_UPLOAD_BYTES=10485760
# STORAGE_S3_DOWNLOAD_EXPIRES_SECONDS=600

# ── OpenAPI 导出（可选） ──
# OPENAPI_EXPORT_SKIP_DB_CONNECT=false

# ── 日志 / 可观测性 ──
LOG_LEVEL=debug
# LOG_FORMAT=pretty  # pretty（默认，开发彩色） | json（单行 JSON）
# SLOW_REQUEST_THRESHOLD_MS=2000
# METRICS_ENABLED=true
# METRICS_USER=metrics
# METRICS_PASSWORD=metrics_password
# OTEL_ENABLED=false

# ── 测试支持（仅 NODE_ENV=test 生效）──
# TESTING_SHARED_SECRET=test-shared-secret-change-me

# ── 客户端运营配置（可选） ──
# SUPPORT_EMAIL=luomuloyal@qq.com
# MIN_CLIENT_VERSION=0.1.0
# LATEST_VERSION=0.1.0
# DOWNLOAD_URL=https://github.com/LuoMuLoyal/Luminous

# ── 极光推送（可选，凭据同时为空时静默禁用） ──
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
JPUSH_APNS_PRODUCTION=false
JPUSH_API_BASE_URL=https://api.jpush.cn
