# semantica-service configuration.
# Copy to .env and adjust. Never commit the result.
#
# 变量清单的唯一事实源是 `src/semantica_service/config.py` 的 `Settings`；
# 本文件与它逐项对齐（16 项，无缺无余）。
#
# 用法：
#   本机直跑   cp .env.example .env && uv run uvicorn semantica_service.main:app --port 8099
#   容器（Lucent 编排）  由 compose 的 env_file 注入，**不需要**把 .env 打进镜像
#                        （Dockerfile 刻意不 COPY 它，凭据只留在编排侧）。
#                        此时清单与 `Lucent/deploy/semantica/.env.example` 同名同义。
#
# ═══════════════════════════════════════════════════════════════════════════
#  这个文件怎么读 —— 只需改「必填」那一节
# ═══════════════════════════════════════════════════════════════════════════
#
#  16 项里真正要你按环境填的只有 4 项：API_TOKEN、NEO4J_PASSWORD、
#  PROVENANCE_DSN、SOURCE_DSN —— 都在第 01 节。其余各项都有经过实测的默认值，
#  **没有具体理由就不要动**。
#
#  全篇是**活行**：每一行都真的生效。
#
# ═══════════════════════════════════════════════════════════════════════════
#  两种拓扑都支持
# ═══════════════════════════════════════════════════════════════════════════
#
#  A. 全部同机（本机直跑，或 sidecar 与 Lucent 的 Postgres 在同一台）
#     → 第 01 节按下面注释里的「本机」值填即可。
#
#  B. 跨云（当前比赛期拓扑：sidecar + Neo4j 在腾讯云，Lucent + Postgres 在鲲鹏）
#     → Neo4j 四项用默认（Neo4j 与 sidecar 同机同网络）；
#       **PROVENANCE_DSN 必须改成鲲鹏 Postgres 的公网地址**。
#
#  ⚠️ 跨云走的是**公网**，不是内网：华为云与腾讯云的 VPC 之间没有对等连接，
#     两条私网网段互相不可达。填对方的内网 IP 会连接超时。

################################################################################
#  01 · 必填（4 项）
################################################################################

# --- Authentication ---------------------------------------------------
# 除 /health 外的所有端点都要求 `Authorization: Bearer <API_TOKEN>`。
# ⚠️ 留空时服务**拒绝启动**（而不是以无鉴权的姿态对外服务）。
#
# 本值必须与 Lucent 侧的 SEMANTICA_API_KEY **完全一致**：这是握手凭据，不是
# 各环境独立配置。生成：openssl rand -hex 32
#
# 为什么要加：本服务原先的设计前提是"只走 compose 容器网络、不发布宿主端口"，
# 因此刻意不带任何凭据。跨云部署后端口已发布、调用来自另一台机器，该前提不再
# 成立 —— /query 会按调用方的要求执行只读 Cypher。
#
# /health 有意保持免鉴权：compose 的 healthcheck 与负载均衡探针都调它，两者
# 都带不了凭据。
API_TOKEN=replace_with_shared_bearer_token

# --- Neo4j 口令 --------------------------------------------------------
# 必填；留空时服务**拒绝启动**（而不是静默用无凭据连接）。
# 必须与编排里 Neo4j 容器的 NEO4J_AUTH 口令一致。
NEO4J_PASSWORD=change-me

# --- Provenance（哈希链审计表）----------------------------------------
# 审计链存在 **Postgres**、且存在 **Lucent 的库里**（不是图库）：图只负责存图，
# 审计行不是图数据；与 Lucent 自己的 audit_logs 共用一条 SQL 连接即可同时读到。
#
# 判据：**Lucent 的 Postgres 在哪台，这里就写哪台**。
#   本机直跑          host=127.0.0.1 port=15432 dbname=lucent user=postgres password=postgres
#   同机 compose      host=postgres port=5432 dbname=lucent user=lucent password=xxx
#   跨云（当前比赛期） host=<鲲鹏公网IP> port=5432 dbname=lucent user=lucent password=xxx
#
# ⚠️ 这是 libpq DSN 格式（key=value），不是 URL 格式：
#      正确  host=10.0.0.5 port=5432 dbname=lucent user=lucent password=xxx
#      错误  postgresql://lucent:xxx@10.0.0.5:5432/lucent
#
# ⚠️ 填错**不会让服务起不来**：读取端把连带失败记成"审计存储不可用"，然后让所有
#    /reason 的溯源引用为空 —— 表现是"推理正常但没有引用"，不是报错。
PROVENANCE_DSN=host=127.0.0.1 port=15432 dbname=lucent user=postgres password=postgres

# --- Source（DrugBank 源表，只读）-------------------------------------
# ⚠️ **服务在请求期从不读它**：`Settings.source_dsn` 只被
#    `scripts/add_edge_provenance.py` 使用，其余脚本各自硬编码本机 DSN。
#    不在本机跑灌图脚本时，这一项填不填都不影响服务运行。
# 格式同 PROVENANCE_DSN。
SOURCE_DSN=host=127.0.0.1 port=15432 dbname=lucent user=postgres password=postgres

################################################################################
#  02 · 用默认（除非有具体理由）
################################################################################

# --- Neo4j 连接 -------------------------------------------------------
# Neo4j 是独立服务器，不同于此前的 Apache AGE：没有与 Prisma schema 共用的
# 数据库，也没有需要覆盖的 search_path。7687 是 Bolt；7474 是浏览器 UI，本服务不用。
#
# ⚠️ 容器内不要写 127.0.0.1 —— 那是容器自己。走 compose 服务名（下方默认值），
#    或按「同机」拓扑在编排侧覆盖。跨机时才填另一台的地址。
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
# 图库名。同时会作为 /schema 响应的 `graph` 字段返回，
# Lucent 侧把它当溯源元数据展示（因此这里是 `neo4j` 而非旧 AGE 的 `lucent_graph`）。
NEO4J_DATABASE=neo4j

# --- Connection pool --------------------------------------------------
# 单连接会把并发串行化（实测 16 并发慢 2.9×），所以按请求借还。
# 池总容量由 POOL_MAX_SIZE 封顶；饱和时立即抛 TimeoutError，不排队。
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10

# --- 审计表名 ---------------------------------------------------------
# 保持默认。改名会让读取端查一张不存在的表，而那个失败同样只表现为"引用为空"。
PROVENANCE_TABLE=semantica_provenance

# --- Query safety -----------------------------------------------------
# 曾有一条失控的变长路径跑满两分钟、只能 pg_terminate_backend 杀掉，
# 所以每个事务都设上限。
# Neo4j 没有 per-connection 的 statement_timeout，改为按**事务**超时
# （begin_transaction(timeout=)）：`session.run(..., timeout=)` 会被驱动
# **静默忽略**（实测：请求 2s 停止的查询跑了 17.4s），所以只能走事务。
#
# ⚠️ 它决定 Lucent 侧 SEMANTICA_TIMEOUT_MS 的下限（默认 20000）：
#    客户端超时必须大于这个值，否则拿不到结构化超时报错而是不透明断开。
STATEMENT_TIMEOUT_MS=15000
CONNECT_TIMEOUT_S=10

# --- Reasoning --------------------------------------------------------
# 规则 join 与 SHACL 校验都在数据库里跑，但仍落回本进程；
# scope_all 的规则仍可能返回图中每一对，故保留上限。
MAX_REASONING_FACTS=50000
REASONING_TIMEOUT_S=30

# --- Observability ----------------------------------------------------
# 默认 JSON：本服务的有效输出是量化的（某 scope 载入多少边、是否截断、
# 不动点产出多少事实），这些值只有作为字段才可查询。
# `text` 渲染同一批字段，便于人在终端阅读。
LOG_LEVEL=INFO
LOG_FORMAT=json
